---
import Layout from "../../layouts/Layout.astro";

const title = "Inventory & POS System | Hegrix Business Software Solution";
const description = "Stock control, purchasing, barcode workflows, point-of-sale and multi-location reporting built on Odoo. Hegrix designs and deploys scalable inventory and POS systems for retail, wholesale and manufacturing teams.";
const keywords = "inventory POS system, Odoo inventory management, point of sale software, barcode workflow, multi-location stock, purchasing automation, Hegrix solutions";

const features = [
  { icon: "📦", color: "#0b55d9", title: "Real-Time Stock Control", desc: "Track inventory levels across all warehouses and locations with live updates on every transaction, transfer and adjustment." },
  { icon: "🏪", color: "#7c3aed", title: "Point of Sale (POS)", desc: "Fast, touch-optimised POS terminals that work online and offline. Receipts, discounts, returns and loyalty all built in." },
  { icon: "🔲", color: "#059669", title: "Barcode & QR Workflows", desc: "Scan-to-receive, scan-to-pick and scan-to-ship. Reduce manual errors and speed up warehouse operations with barcode automation." },
  { icon: "🛒", color: "#d97706", title: "Purchasing & Reordering", desc: "Automatic reorder rules, supplier price lists, purchase order approval workflows and landed cost calculations." },
  { icon: "🗺️", color: "#0891b2", title: "Multi-Location Management", desc: "Manage stock across multiple warehouses, branches and transit routes with consolidated reporting and inter-branch transfers." },
  { icon: "📊", color: "#dc2626", title: "Reports & Dashboards", desc: "Stock valuation, turnover rates, slow-moving items, POS daily summaries and location-level performance — all in one view." },
  { icon: "🔗", color: "#2563eb", title: "ERP & eCommerce Sync", desc: "Connect inventory to your accounting, e-commerce, CRM and shipping systems with bi-directional, real-time synchronisation." },
  { icon: "🤖", color: "#7c3aed", title: "AI Demand Forecasting", desc: "Predictive reorder suggestions based on sales velocity, seasonality, lead times and custom business rules." },
];

const workflow = [
  { step: "01", label: "Goods Receipt", icon: "📥", desc: "Scan and validate incoming stock against purchase orders" },
  { step: "02", label: "Putaway Rules", icon: "📍", desc: "Automatically route items to correct bin, shelf and zone" },
  { step: "03", label: "Pick & Pack", icon: "📋", desc: "Batch picking with barcode confirmation at every step" },
  { step: "04", label: "POS Checkout", icon: "💳", desc: "Sell in-store with real-time inventory deduction on every sale" },
  { step: "05", label: "Reorder Alert", icon: "🔔", desc: "Trigger purchase orders automatically when stock hits minimum" },
];

const industries = [
  { icon: "🛍️", label: "Retail & Fashion", color: "#7c3aed" },
  { icon: "🍽️", label: "Food & Beverage", color: "#d97706" },
  { icon: "🏭", label: "Manufacturing", color: "#059669" },
  { icon: "💊", label: "Pharmacy", color: "#dc2626" },
  { icon: "🏗️", label: "Construction Materials", color: "#0891b2" },
  { icon: "💻", label: "Electronics & IT", color: "#0b55d9" },
];

const stats = [
  { value: "40%", label: "reduction in stock discrepancies" },
  { value: "3×", label: "faster warehouse pick-to-ship" },
  { value: "200+", label: "businesses served" },
  { value: "2 wk", label: "to first live POS terminal" },
];

const techItems = [
  { name: "Odoo 17", tag: "Core Platform", color: "#8b5cf6" },
  { name: "Shopify", tag: "eCommerce", color: "#95bf47" },
  { name: "WooCommerce", tag: "eCommerce", color: "#7f54b3" },
  { name: "QuickBooks", tag: "Accounting", color: "#2ca01c" },
  { name: "Xero", tag: "Accounting", color: "#13b5ea" },
  { name: "Stripe", tag: "Payments", color: "#635bff" },
  { name: "Razorpay", tag: "Payments", color: "#3395ff" },
  { name: "Amazon", tag: "Marketplace", color: "#ff9900" },
  { name: "Shippo", tag: "Shipping", color: "#0088cc" },
  { name: "REST API", tag: "Custom", color: "#64748b" },
];

const whyItems = [
  { icon: "🎯", title: "Scoped for your operations", desc: "We spend the first phase defining your workflows, locations, integrations, user roles and reports — before writing a line of code." },
  { icon: "⚡", title: "Fast, phased delivery", desc: "Single-location deployments go live in 2 weeks. Complex multi-site rollouts are phased to minimise disruption and deliver value fast." },
  { icon: "🔒", title: "No lock-in architecture", desc: "Built on Odoo's open-source foundation. You own your data, your code and your infrastructure. No proprietary traps." },
  { icon: "🛠️", title: "Ongoing support & growth", desc: "Post-launch, Hegrix provides support, training, release updates and feature iterations — so the system grows with your business." },
];

const faqs = [
  { q: "Does this work for businesses with multiple warehouses or branches?", a: "Yes. The solution supports unlimited locations with individual stock tracking, inter-branch transfer workflows and consolidated reporting across all sites." },
  { q: "Can the POS work without an internet connection?", a: "The Odoo POS module includes offline mode. Transactions are captured locally and synced automatically when connectivity is restored." },
  { q: "How does it integrate with my existing accounting or ecommerce platform?", a: "Hegrix builds integrations with Odoo Accounting, Shopify, WooCommerce, Amazon, QuickBooks, Xero and custom systems via REST API. Every integration is designed to your specific data flow." },
  { q: "What barcode hardware do you support?", a: "Any USB, Bluetooth or networked barcode scanner is supported. We also support mobile scanning via the Odoo Barcode iOS and Android apps." },
  { q: "How long does implementation take?", a: "A single-location retail or wholesale implementation typically goes live in 2-4 weeks. Multi-warehouse or manufacturing deployments with custom workflows typically take 6-12 weeks." },
];

const stockRows = [
  { name: "USB-C Cable 2m", loc: "WH-01 / A3", qty: "142", status: "ok" },
  { name: "Wireless Keyboard", loc: "WH-01 / B1", qty: "18", status: "low" },
  { name: "HDMI Adapter 4K", loc: "WH-02 / C5", qty: "309", status: "ok" },
  { name: "Gaming Headset Pro", loc: "WH-01 / B4", qty: "7", status: "critical" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Layout title={title} description={description} keywords={keywords} path="/solutions/inventory-pos-system/" schema={faqSchema}>

  <!-- HERO -->
  <header class="ip-hero">
    <div class="ip-hero__mesh" aria-hidden="true"></div>
    <div class="ip-hero__orb ip-hero__orb--1" aria-hidden="true"></div>
    <div class="ip-hero__orb ip-hero__orb--2" aria-hidden="true"></div>
    <div class="container">
      <nav class="ip-breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="ip-breadcrumb__link">Home</a><span aria-hidden="true">›</span>
        <a href="/solutions/" class="ip-breadcrumb__link">Solutions</a><span aria-hidden="true">›</span>
        <span>Inventory &amp; POS System</span>
      </nav>
      <div class="ip-hero__layout">
        <div class="ip-hero__text">
          <div class="ip-hero__badge"><span class="ip-badge-dot"></span>Operations Solution</div>
          <h1 class="ip-hero__h1">Inventory &amp; POS<br/><span class="ip-hero__gradient">Built for Growth</span></h1>
          <p class="ip-hero__desc">Stock control, barcode workflows, multi-location management and point-of-sale — unified in one Odoo-powered platform. Purpose-built by Hegrix for retail, wholesale and manufacturing businesses that have outgrown spreadsheets.</p>
          <div class="ip-hero__actions">
            <a href="/contact-us/" class="ip-btn ip-btn--primary" id="hero-cta-inventory">
              <span>Book a free demo</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact-us/?solution=inventory-demo" class="ip-btn ip-btn--ghost">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Request live demo
            </a>
          </div>
          <p class="ip-hero__trust">&#10003; No lock-in &nbsp;&middot;&nbsp; &#10003; Free scoping call &nbsp;&middot;&nbsp; &#10003; 48h response</p>
        </div>
        <div class="ip-hero__visual" aria-hidden="true">
          <div class="ip-dashboard">
            <div class="ip-dashboard__bar">
              <span class="ip-dashboard__dot ip-dashboard__dot--red"></span>
              <span class="ip-dashboard__dot ip-dashboard__dot--amber"></span>
              <span class="ip-dashboard__dot ip-dashboard__dot--green"></span>
              <span class="ip-dashboard__bar-title">Inventory Dashboard — Live</span>
              <span class="ip-dashboard__live"><span class="ip-live-dot"></span>Live</span>
            </div>
            <div class="ip-dashboard__body">
              <div class="ip-kpi-row">
                <div class="ip-kpi"><span class="ip-kpi__label">Total SKUs</span><span class="ip-kpi__value">4,821</span><span class="ip-kpi__delta ip-kpi__delta--up">&#8593; 12%</span></div>
                <div class="ip-kpi"><span class="ip-kpi__label">Stock Value</span><span class="ip-kpi__value">$284k</span><span class="ip-kpi__delta ip-kpi__delta--up">&#8593; 8%</span></div>
                <div class="ip-kpi"><span class="ip-kpi__label">Low Stock</span><span class="ip-kpi__value ip-kpi__value--warn">23</span><span class="ip-kpi__delta ip-kpi__delta--down">&#8595; 5</span></div>
              </div>
              <div class="ip-stock-list">
                <div class="ip-stock-header"><span>Product</span><span>Location</span><span>Qty</span><span>Status</span></div>
                {stockRows.map((row) => (
                  <div class="ip-stock-row">
                    <span class="ip-stock-name">{row.name}</span>
                    <span class="ip-stock-loc">{row.loc}</span>
                    <span class="ip-stock-qty">{row.qty}</span>
                    <span class={`ip-stock-badge ip-stock-badge--${row.status}`}>{row.status === "ok" ? "In Stock" : row.status === "low" ? "Low" : "Critical"}</span>
                  </div>
                ))}
              </div>
              <div class="ip-pos-mini">
                <div class="ip-pos-mini__header"><span>&#127978; POS Terminal — Active Sale</span><span class="ip-pos-mini__time">13:42</span></div>
                <div class="ip-pos-mini__items">
                  <div class="ip-pos-mini__item"><span>USB-C Cable &times; 2</span><span>$29.98</span></div>
                  <div class="ip-pos-mini__item"><span>HDMI Adapter &times; 1</span><span>$24.99</span></div>
                </div>
                <div class="ip-pos-mini__total"><span>Total</span><strong>$54.97</strong></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="ip-stats-row">
        {stats.map((s) => (
          <div class="ip-stat"><span class="ip-stat__value">{s.value}</span><span class="ip-stat__label">{s.label}</span></div>
        ))}
      </div>
    </div>
  </header>

  <!-- CAPABILITIES -->
  <section class="ip-section ip-section--light" aria-labelledby="cap-heading">
    <div class="container">
      <div class="ip-section__header">
        <p class="ip-eyebrow">Platform Capabilities</p>
        <h2 id="cap-heading" class="ip-section__h2">Everything your inventory and POS operation needs</h2>
        <p class="ip-section__sub">One platform covering stock, purchasing, barcode ops and point-of-sale — all connected with your existing accounting, ecommerce and ERP systems.</p>
      </div>
      <div class="ip-features-grid">
        {features.map((f) => (
          <article class="ip-feature-card">
            <div class="ip-feature-card__icon" style={`background:${f.color}18;color:${f.color}`}><span>{f.icon}</span></div>
            <h3 class="ip-feature-card__title">{f.title}</h3>
            <p class="ip-feature-card__desc">{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WORKFLOW -->
  <section class="ip-section ip-section--dark" aria-labelledby="workflow-heading">
    <div class="container">
      <div class="ip-section__header ip-section__header--center">
        <p class="ip-eyebrow ip-eyebrow--light">How It Works</p>
        <h2 id="workflow-heading" class="ip-section__h2 ip-section__h2--white">From goods receipt to checkout — automated</h2>
        <p class="ip-section__sub ip-section__sub--light">Every step of the inventory lifecycle is tracked, verified and connected — removing manual data entry and reducing errors across the chain.</p>
      </div>
      <div class="ip-workflow">
        <div class="ip-workflow__line" aria-hidden="true"></div>
        {workflow.map((w) => (
          <div class="ip-workflow__step">
            <div class="ip-workflow__circle"><span>{w.icon}</span></div>
            <div class="ip-workflow__content">
              <span class="ip-workflow__num">{w.step}</span>
              <h3 class="ip-workflow__label">{w.label}</h3>
              <p class="ip-workflow__desc">{w.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="ip-section ip-section--light" aria-labelledby="ind-heading">
    <div class="container">
      <div class="ip-split">
        <div class="ip-split__text">
          <p class="ip-eyebrow">Industries Served</p>
          <h2 id="ind-heading" class="ip-section__h2">Built for how your industry actually operates</h2>
          <p class="ip-section__sub">Whether you run a retail chain, a wholesale distributor, a manufacturer or a restaurant group, Hegrix designs the inventory and POS system around your workflows — not the other way around.</p>
          <ul class="ip-checklist">
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>Custom product categorisation and pricing rules</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>Role-based access for warehouse, POS and management teams</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>Compliance-ready reporting for audit and finance teams</li>
            <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>Integration with loyalty, delivery and payment gateways</li>
          </ul>
          <a href="/contact-us/" class="ip-btn ip-btn--primary" id="industry-cta-inventory"><span>Discuss your industry</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
        <div class="ip-industry-grid">
          {industries.map((ind) => (
            <div class="ip-industry-card">
              <span class="ip-industry-card__icon" style={`color:${ind.color}`}>{ind.icon}</span>
              <span class="ip-industry-card__label">{ind.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- TECH STACK -->
  <section class="ip-section ip-section--soft" aria-labelledby="tech-heading">
    <div class="container">
      <div class="ip-section__header ip-section__header--center">
        <p class="ip-eyebrow">Integrations &amp; Technology</p>
        <h2 id="tech-heading" class="ip-section__h2">Connects with your existing stack</h2>
        <p class="ip-section__sub">The platform integrates with the systems you already use — keeping data in sync across accounting, commerce and logistics.</p>
      </div>
      <div class="ip-tech-grid">
        {techItems.map((t) => (
          <div class="ip-tech-pill">
            <span class="ip-tech-pill__dot" style={`background:${t.color}`}></span>
            <div><span class="ip-tech-pill__name">{t.name}</span><span class="ip-tech-pill__tag">{t.tag}</span></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY HEGRIX -->
  <section class="ip-section ip-section--light" aria-labelledby="why-heading">
    <div class="container">
      <div class="ip-section__header">
        <p class="ip-eyebrow">Why Hegrix</p>
        <h2 id="why-heading" class="ip-section__h2">Delivered by specialists, not generalists</h2>
      </div>
      <div class="ip-why-grid">
        {whyItems.map((w) => (
          <article class="ip-why-card">
            <span class="ip-why-card__icon">{w.icon}</span>
            <h3 class="ip-why-card__title">{w.title}</h3>
            <p class="ip-why-card__desc">{w.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="ip-section ip-section--soft" aria-labelledby="faq-heading">
    <div class="container ip-faq-layout">
      <div class="ip-faq-left">
        <p class="ip-eyebrow">FAQ</p>
        <h2 id="faq-heading" class="ip-section__h2">Common questions</h2>
        <p class="ip-section__sub">Answers to what most teams ask before starting their inventory &amp; POS project with Hegrix.</p>
        <a href="/contact-us/" class="ip-btn ip-btn--primary" id="faq-cta-inventory" style="margin-top:20px"><span>Ask a specific question</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      </div>
      <div class="ip-faq-list">
        {faqs.map((faq, i) => (
          <details class="ip-faq-item" id={`faq-${i + 1}`}>
            <summary class="ip-faq-item__q">
              <span>{faq.q}</span>
              <span class="ip-faq-item__arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></span>
            </summary>
            <p class="ip-faq-item__a">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="ip-cta-banner" aria-labelledby="cta-heading">
    <div class="ip-cta-banner__orb ip-cta-banner__orb--1" aria-hidden="true"></div>
    <div class="ip-cta-banner__orb ip-cta-banner__orb--2" aria-hidden="true"></div>
    <div class="container ip-cta-banner__inner">
      <div class="ip-cta-banner__text">
        <p class="ip-eyebrow ip-eyebrow--light">Start your project</p>
        <h2 id="cta-heading" class="ip-cta-banner__h2">Ready to replace your inventory spreadsheets?</h2>
        <p class="ip-cta-banner__sub">Tell us about your business and we will design the right inventory, POS and integration stack for your team — with a clear timeline and cost.</p>
      </div>
      <div class="ip-cta-banner__actions">
        <a href="/contact-us/" class="ip-btn ip-btn--white" id="final-cta-inventory"><span>Book a free demo</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="/solutions/" class="ip-btn ip-btn--ghost-white">Explore all solutions</a>
      </div>
      <div class="ip-cta-banner__trust">
        <span>&#10003; Free scoping call</span>
        <span>&#10003; No obligation estimate</span>
        <span>&#10003; Responds within 48 hours</span>
      </div>
    </div>
  </section>

</Layout>

<style>
@keyframes ip-orb{0%,100%{transform:translate(0,0) scale(1)}50%{transform:translate(14px,-10px) scale(1.05)}}
@keyframes ip-blink{0%,100%{opacity:1}50%{opacity:0}}
@keyframes ip-shine{0%{background-position:-200% 0}100%{background-position:200% 0}}

.ip-section{padding:80px 0}
.ip-section--light{background:#fff}
.ip-section--soft{background:var(--soft,#f5f9ff)}
.ip-section--dark{background:linear-gradient(160deg,#040d24 0%,#071a3d 55%,#09265c 100%);position:relative;overflow:hidden}

.ip-eyebrow{display:inline-block;padding:4px 14px;border-radius:999px;background:rgba(11,85,217,.1);border:1px solid rgba(11,85,217,.2);color:#0b55d9;font-size:.74rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;margin-bottom:16px}
.ip-eyebrow--light{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.2);color:rgba(255,255,255,.8)}

.ip-section__header{max-width:680px;margin-bottom:48px}
.ip-section__header--center{text-align:center;margin:0 auto 48px}
.ip-section__h2{font-size:clamp(1.7rem,3vw,2.4rem);font-weight:900;color:var(--blue-950,#071a3d);line-height:1.15;margin:0 0 14px}
.ip-section__h2--white{color:white}
.ip-section__sub{font-size:1.02rem;color:var(--muted,#5a7294);line-height:1.75;margin:0}
.ip-section__sub--light{color:rgba(255,255,255,.65)}

.ip-btn{display:inline-flex;align-items:center;gap:8px;padding:13px 24px;border-radius:10px;font-size:.9rem;font-weight:800;transition:all .2s;text-decoration:none}
.ip-btn--primary{background:linear-gradient(135deg,#0b55d9,#1265f3);color:white;box-shadow:0 8px 22px rgba(11,85,217,.28)}
.ip-btn--primary:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(11,85,217,.38)}
.ip-btn--ghost{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);color:rgba(255,255,255,.85);backdrop-filter:blur(8px)}
.ip-btn--ghost:hover{background:rgba(255,255,255,.18);color:white}
.ip-btn--white{background:white;color:#071a3d;box-shadow:0 8px 24px rgba(0,0,0,.18)}
.ip-btn--white:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(0,0,0,.24)}
.ip-btn--ghost-white{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.25);color:rgba(255,255,255,.8)}
.ip-btn--ghost-white:hover{background:rgba(255,255,255,.15);color:white}

.ip-hero{position:relative;padding:64px 0 0;background:linear-gradient(160deg,#040d24 0%,#071a3d 50%,#09265c 100%);color:white;overflow:hidden}
.ip-hero__mesh{position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.03) 1px,transparent 1px);background-size:30px 30px;pointer-events:none}
.ip-hero__orb{position:absolute;border-radius:50%;filter:blur(80px);pointer-events:none;animation:ip-orb 18s ease-in-out infinite}
.ip-hero__orb--1{width:560px;height:560px;top:-180px;right:-120px;background:radial-gradient(circle,rgba(11,85,217,.3),transparent 70%)}
.ip-hero__orb--2{width:380px;height:380px;bottom:-80px;left:-60px;background:radial-gradient(circle,rgba(124,58,237,.22),transparent 70%);animation-delay:-8s}
.ip-breadcrumb{display:flex;align-items:center;gap:8px;font-size:.8rem;font-weight:600;margin-bottom:36px;color:rgba(255,255,255,.45)}
.ip-breadcrumb__link{color:rgba(255,255,255,.55);transition:color .2s}
.ip-breadcrumb__link:hover{color:white}
.ip-hero__layout{display:grid;grid-template-columns:1fr 520px;gap:52px;align-items:center;padding-bottom:48px}
.ip-hero__text{position:relative;z-index:1}
