---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const title = "Inventory & POS System | All-in-One Retail & Warehouse Software — Hegrix";
const description =
  "Unify stock control, multi-location warehouses, barcode scanning, POS checkout, purchasing automation, and real-time analytics with Hegrix Inventory & POS System powered by Odoo ERP.";
const keywords =
  "inventory POS system, Odoo inventory software, retail POS system, point of sale software, multi location stock management, barcode scanner software, purchasing automation, Hegrix solutions";
const path = "/solutions/inventory-pos-system/";
const siteUrl = "https://hegrix.com";
const canonical = new URL(path, siteUrl).toString();

const faqs = [
  {
    q: "Does Hegrix Inventory & POS support multi-store and multi-warehouse setups?",
    a: "Yes. Hegrix Inventory & POS provides centralized multi-location stock tracking, enabling you to manage inventory transfers, reorder triggers, branch sales, and consolidated financial reporting across physical stores, central warehouses, and e-commerce channels in real time.",
  },
  {
    q: "Can the Point of Sale (POS) function offline during internet outages?",
    a: "Absoluely. The Odoo-powered POS engine includes full offline operation capabilities. Cashiers can continue barcode scanning, ringing up sales, applying discounts, and printing thermal receipts without an active internet connection. All transaction data automatically syncs with your central database once connectivity is restored.",
  },
  {
    q: "What hardware accessories are compatible with the system?",
    a: "Hegrix Inventory & POS offers plug-and-play compatibility with standard retail hardware including USB and Bluetooth barcode scanners, thermal receipt printers, electronic cash drawers, customer-facing displays, weight scales, and card payment terminals.",
  },
  {
    q: "Does it integrate with e-commerce platforms like Shopify or WooCommerce?",
    a: "Yes. We deploy bi-directional API connectors that synchronize product catalogs, inventory levels, customer profiles, and order data between Shopify, WooCommerce, Amazon, and your core Odoo database to eliminate overselling.",
  },
  {
    q: "How does automated purchasing and reordering work?",
    a: "You can define minimum and maximum stock rules for every SKU by location. When stock levels dip below your specified threshold, the system automatically calculates required quantities and generates draft Purchase Orders (POs) for vendor approval.",
  },
  {
    q: "How fast can we implement the system for our business?",
    a: "Single-store retail setups or standard warehouse deployments can go live in as little as 2 to 3 weeks. Complex multi-branch enterprises or manufacturing facilities with custom workflows are typically deployed in phased 6 to 10 week sprints with zero downtime.",
  },
];

const capabilities = [
  {
    icon: "📦",
    color: "#2563eb",
    label: "Real-Time Stock Control",
    text: "Track stock levels across all stores, central hubs, and transit routes with instant live updates on every sale, transfer, and adjustment.",
  },
  {
    icon: "💳",
    color: "#06b6d4",
    label: "Point of Sale (POS) Terminal",
    text: "High-speed, touch-optimized POS interface that works online and offline. Ring up sales, process split payments, issue receipts, and manage returns effortlessly.",
  },
  {
    icon: "🔲",
    color: "#10b981",
    label: "Barcode & QR Automation",
    text: "Scan-to-receive, scan-to-pick, and scan-to-ship workflows. Eliminate manual entry errors and accelerate inventory audits with mobile barcode scanning.",
  },
  {
    icon: "🛒",
    color: "#f59e0b",
    label: "Purchasing & Auto-Reordering",
    text: "Automate purchase orders based on sales velocity and safety stock thresholds. Manage supplier price lists, landed cost tracking, and lead times.",
  },
  {
    icon: "🏬",
    color: "#ec4899",
    label: "Multi-Location Warehouse (WMS)",
    text: "Optimize bin locations, aisle picking paths, multi-warehouse stock transfers, and batch pick-pack-ship operations with full auditability.",
  },
  {
    icon: "👥",
    color: "#8b5cf6",
    label: "Customer Loyalty & CRM",
    text: "Build repeat business with built-in customer reward point tiers, digital gift cards, promotional coupons, and purchase history tracking.",
  },
  {
    icon: "📊",
    color: "#6366f1",
    label: "Analytics & Executive BI",
    text: "Gain real-time visibility into gross profit margins, fast/slow-moving SKUs, store sales rankings, stock turnover rates, and cashier performance.",
  },
  {
    icon: "🔗",
    color: "#0284c7",
    label: "Omnichannel eCommerce Sync",
    text: "Connect physical store POS registers to Shopify, WooCommerce, and mobile apps into one unified, real-time inventory database.",
  },
];

const challenges = [
  {
    problem: "Frequent Stockouts & Overselling",
    impact: "Lost sales revenue and frustrated customers due to delayed inventory updates between stores and website.",
    solution: "Real-time bi-directional stock sync across all sales channels, POS registers, and warehouses.",
  },
  {
    problem: "Slow POS Checkout Queues",
    impact: "Customer drop-off during peak store hours caused by cumbersome billing software and network dropouts.",
    solution: "Lightning-fast offline-capable POS interface with barcode scanning and instant thermal receipt printing.",
  },
  {
    problem: "Manual Purchase Order Errors",
    impact: "Overstocking slow items while key products run out due to manual spreadsheet stock counts.",
    solution: "Automated reorder rules that auto-generate draft POs based on real-time sales velocity and lead times.",
  },
  {
    problem: "Siloed Store Data & Financial Discrepancies",
    impact: "Lack of central visibility into daily store revenue, margins, and cash drawer reconciliations.",
    solution: "Unified Odoo ERP backend with double-entry accounting sync, daily cashier closing reports, and executive dashboards.",
  },
];

const steps = [
  { num: "01", label: "Goods Receipt & Scan", text: "Scan and validate incoming vendor shipments against Purchase Orders with instant lot & serial tracking." },
  { num: "02", label: "Automated Bin Putaway", text: "System routes items to designated warehouse aisles, bins, or store shelves to optimize picking paths." },
  { num: "03", label: "Multi-Store Stock Sync", text: "Inventory balances update live across all physical registers, e-commerce storefronts, and B2B portals." },
  { num: "04", label: "Instant POS Checkout", text: "Cashiers ring up items in seconds via barcode scan, process cash/card payments, and issue digital receipts." },
  { num: "05", label: "Automated PO Reorder", text: "When stock reaches minimum threshold, Retail360 auto-generates supplier POs for approval." },
];

const whyCards = [
  { icon: "🎯", label: "Scoped for Your Workflows", text: "We analyze your exact retail and warehouse processes before implementation to configure custom fields, approval rules, and reports." },
  { icon: "⚡", label: "Rapid Phased Rollout", text: "Go live with single-store POS in 2 weeks. Complex multi-warehouse enterprises are deployed in zero-downtime phased sprints." },
  { icon: "🔒", label: "Open Odoo Architecture", text: "Built on Odoo's world-class ERP foundation. You own your code, database, and business data with no vendor lock-in." },
  { icon: "🛠️", label: "Dedicated SLA Support", text: "Hegrix provides ongoing maintenance, 24/7 technical support, staff training, and continuous module updates as your business expands." },
];

const hardwareList = [
  { name: "Thermal Receipt Printers", tag: "Hardware", icon: "🖨️" },
  { name: "Barcode & QR Scanners", tag: "Hardware", icon: "🔲" },
  { name: "Cash Drawers & Till Boxes", tag: "Hardware", icon: "💵" },
  { name: "Card Payment Terminals", tag: "Hardware", icon: "💳" },
  { name: "Customer Pole Displays", tag: "Hardware", icon: "🖥️" },
  { name: "Weight Scales & Scanners", tag: "Hardware", icon: "⚖️" },
  { name: "Mobile iOS & Android POS", tag: "Mobile", icon: "📱" },
  { name: "Shopify & WooCommerce", tag: "eCommerce", icon: "🛒" },
  { name: "QuickBooks & Xero", tag: "Finance", icon: "📈" },
  { name: "REST API & Webhooks", tag: "Custom", icon: "⚡" },
];

const stats = [
  { value: "99.8%", label: "Inventory Accuracy Rate" },
  { value: "2×", label: "Faster POS Checkout Speed" },
  { value: "40%", label: "Reduction in Stock Discrepancies" },
  { value: "200+", label: "Active Retail & POS Deployments" },
];

const solutionSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Hegrix Inventory & POS System",
  operatingSystem: "Web, Windows, Linux, iOS, Android",
  applicationCategory: "BusinessApplication",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
  description:
    "Unified stock control, barcode workflows, multi-location warehouses, and offline POS software powered by Odoo ERP.",
  url: canonical,
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  path={path}
  schema={[solutionSchema, faqSchema]}
>

<!-- ══════════════════════════════════════════════
     HERO SECTION
══════════════════════════════════════════════ -->
<section class="inv-hero" aria-labelledby="inv-hero-title">
  <div class="inv-hero__bg" aria-hidden="true">
    <div class="inv-orb inv-orb--1"></div>
    <div class="inv-orb inv-orb--2"></div>
    <div class="inv-grid-overlay"></div>
  </div>

  <div class="inv-container inv-hero__inner">
    <div class="inv-hero__grid">
      {/* Left Messaging */}
      <div class="inv-hero__content">
        <div class="inv-badge">
          <span class="inv-badge-pulse"></span>
          <span class="inv-badge-icon">🛍️</span>
          <span>All-in-One Inventory & POS Software</span>
        </div>

        <h1 id="inv-hero-title" class="inv-hero__title">
          Unify Inventory &amp;<br />
          <span class="inv-gradient-text">POS Operations.</span>
        </h1>

        <p class="inv-hero__sub">
          Stock control, barcode workflows, multi-location warehouses, and offline-capable Point of Sale — unified in one Odoo-powered platform. Purpose-built by Hegrix for retail, wholesale, and multi-channel operations.
        </p>

        <div class="inv-hero__tags" aria-label="Key highlights">
          <div class="inv-hero-tag">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Real-Time Multi-Store Stock</span>
          </div>
          <div class="inv-hero-tag">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Online &amp; Offline POS</span>
          </div>
          <div class="inv-hero-tag">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Barcode &amp; Scanner Sync</span>
          </div>
          <div class="inv-hero-tag">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Automated Supplier POs</span>
          </div>
        </div>

        <div class="inv-hero__actions">
          <a class="inv-btn inv-btn--primary" href="#demo-form" id="inv-hero-primary-cta">
            <span>Book Free POS Demo</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a class="inv-btn inv-btn--ghost" href="/contact-us/" id="inv-hero-secondary-cta">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>Talk to POS Specialist</span>
          </a>
        </div>

        <div class="inv-hero__proof">
          <div class="inv-stars">
            <svg width="16" height="16" fill="#F59E0B" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" fill="#F59E0B" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" fill="#F59E0B" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" fill="#F59E0B" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg width="16" height="16" fill="#F59E0B" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <div class="inv-proof-meta">
            <strong>4.9/5 Rating</strong>
            <span>• 200+ Active Retail Stores • 99.8% Accuracy</span>
          </div>
        </div>
      </div>

      {/* Right Dashboard Console Mockup */}
      <div class="inv-hero__visual">
        <div class="inv-console">
          <div class="inv-console-bar">
            <div class="inv-console-dots">
              <span></span><span></span><span></span>
            </div>
            <div class="inv-console-title">Hegrix Operations Center — Live Hub</div>
            <div class="inv-console-status">
              <span class="inv-pulse-dot"></span>
              <span>Syncing Active</span>
            </div>
          </div>

          <div class="inv-console-body">
            <div class="inv-kpi-grid">
              <div class="inv-kpi-card">
                <div class="kpi-head">
                  <span>Stock Accuracy</span>
                  <span class="kpi-badge green">Live</span>
                </div>
                <div class="kpi-val">99.8%</div>
                <div class="kpi-bar"><div class="kpi-fill green" style="width: 99%;"></div></div>
              </div>

              <div class="inv-kpi-card">
                <div class="kpi-head">
                  <span>Checkout Speed</span>
                  <span class="kpi-badge blue">2x Faster</span>
                </div>
                <div class="kpi-val">1.2s</div>
                <div class="kpi-bar"><div class="kpi-fill blue" style="width: 85%;"></div></div>
              </div>

              <div class="inv-kpi-card">
                <div class="kpi-head">
                  <span>Turnover Rate</span>
                  <span class="kpi-badge purple">+45%</span>
                </div>
                <div class="kpi-val">+45%</div>
                <div class="kpi-bar"><div class="kpi-fill purple" style="width: 78%;"></div></div>
              </div>

              <div class="inv-kpi-card">
                <div class="kpi-head">
                  <span>Shrinkage Loss</span>
                  <span class="kpi-badge emerald">-35%</span>
                </div>
                <div class="kpi-val">-35%</div>
                <div class="kpi-bar"><div class="kpi-fill emerald" style="width: 65%;"></div></div>
              </div>
            </div>

            {/* Simulated Live Table */}
            <div class="inv-console-table">
              <div class="table-head">
                <span>Active SKU / Item</span>
                <span>Location</span>
                <span>Qty</span>
                <span>Status</span>
              </div>
              <div class="table-row">
                <span class="item-name">USB-C Cable 2m</span>
                <span class="item-loc">WH-01 / A3</span>
                <span class="item-qty">142</span>
                <span class="item-status ok">In Stock</span>
              </div>
              <div class="table-row">
                <span class="item-name">Wireless Keyboard</span>
                <span class="item-loc">WH-01 / B1</span>
                <span class="item-qty">18</span>
                <span class="item-status low">Low Stock</span>
              </div>
              <div class="table-row">
                <span class="item-name">HDMI Adapter 4K</span>
                <span class="item-loc">WH-02 / C5</span>
                <span class="item-qty">309</span>
                <span class="item-status ok">In Stock</span>
              </div>
            </div>
          </div>
        </div>

        {/* Floating Glass Badges */}
        <div class="inv-float-badge float-1">
          <span class="badge-icon">📦</span>
          <span>Real-Time Stock</span>
        </div>
        <div class="inv-float-badge float-2">
          <span class="badge-icon">💳</span>
          <span>POS Terminal</span>
        </div>
        <div class="inv-float-badge float-3">
          <span class="badge-icon">🔲</span>
          <span>Barcode Scanning</span>
        </div>
        <div class="inv-float-badge float-4">
          <span class="badge-icon">📈</span>
          <span>Sales Analytics</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     CORE CAPABILITIES GRID
══════════════════════════════════════════════ -->
<section class="inv-section" aria-labelledby="cap-title">
  <div class="inv-container">
    <div class="inv-section-header">
      <p class="inv-eyebrow">Capabilities</p>
      <h2 id="cap-title" class="inv-section-title">Complete Control Over Every SKU, Store &amp; Sale</h2>
      <p class="inv-section-desc">
        Eight core modules engineered to replace disconnected spreadsheets with an integrated, Odoo-powered business management platform.
      </p>
    </div>

    <div class="inv-cap-grid">
      {capabilities.map((c) => (
        <article class="inv-cap-card">
          <div class="inv-cap-card__icon" style={`background:${c.color}18;color:${c.color}`}>
            {c.icon}
          </div>
          <h3 class="inv-cap-card__title">{c.label}</h3>
          <p class="inv-cap-card__text">{c.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     PAIN POINTS & SOLUTIONS (TRANSFORMATION)
══════════════════════════════════════════════ -->
<section class="inv-section inv-section--soft" aria-labelledby="trans-title">
  <div class="inv-container">
    <div class="inv-section-header">
      <p class="inv-eyebrow">Transformation</p>
      <h2 id="trans-title" class="inv-section-title">Retail &amp; Inventory Challenges We Solve</h2>
      <p class="inv-section-desc">Replacing traditional retail friction with automated Odoo operational workflows.</p>
    </div>

    <div class="inv-trans-grid">
      {challenges.map((item) => (
        <div class="inv-trans-card">
          <div class="trans-side problem-side">
            <span class="trans-label problem-label">Traditional Problem</span>
            <h3>{item.problem}</h3>
            <p>{item.impact}</p>
          </div>
          <div class="trans-divider" aria-hidden="true">→</div>
          <div class="trans-side solution-side">
            <span class="trans-label solution-label">Hegrix Solution</span>
            <p class="solution-text">{item.solution}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     WORKFLOW STEPS
══════════════════════════════════════════════ -->
<section class="inv-section" aria-labelledby="flow-title">
  <div class="inv-container">
    <div class="inv-section-header">
      <p class="inv-eyebrow">Operational Flow</p>
      <h2 id="flow-title" class="inv-section-title">How Stock Moves Through Hegrix Inventory &amp; POS</h2>
      <p class="inv-section-desc">A continuous, automated pipeline from supplier delivery to customer receipt.</p>
    </div>

    <div class="inv-steps-grid">
      {steps.map((s, i) => (
        <div class="inv-step-card">
          <div class="step-num">{s.num}</div>
          <h3 class="step-title">{s.label}</h3>
          <p class="step-text">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     HARDWARE & TECH INTEGRATIONS
══════════════════════════════════════════════ -->
<section class="inv-section inv-section--soft" aria-labelledby="tech-title">
  <div class="inv-container">
    <div class="inv-section-header">
      <p class="inv-eyebrow">Hardware &amp; Ecosystem</p>
      <h2 id="tech-title" class="inv-section-title">Native Compatibility With Your Hardware &amp; Stack</h2>
      <p class="inv-section-desc">Plug-and-play hardware integration alongside pre-built connectors for popular e-commerce and accounting platforms.</p>
    </div>

    <div class="inv-hardware-grid">
      {hardwareList.map((h) => (
        <div class="inv-hardware-chip">
          <span class="chip-icon">{h.icon}</span>
          <span class="chip-name">{h.name}</span>
          <span class="chip-tag">{h.tag}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     METRICS BAR
══════════════════════════════════════════════ -->
<section class="inv-metrics-banner">
  <div class="inv-container">
    <div class="inv-metrics-grid">
      {stats.map((s) => (
        <div class="inv-metric-item">
          <span class="metric-big">{s.value}</span>
          <span class="metric-lbl">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     WHY HEGRIX
══════════════════════════════════════════════ -->
<section class="inv-section" aria-labelledby="why-title">
  <div class="inv-container">
    <div class="inv-section-header">
      <p class="inv-eyebrow">Why Hegrix</p>
      <h2 id="why-title" class="inv-section-title">Built-for-Business Odoo Advisory</h2>
      <p class="inv-section-desc">We combine deep retail domain experience with specialized Odoo ERP technical implementation.</p>
    </div>

    <div class="inv-why-grid">
      {whyCards.map((w) => (
        <article class="inv-why-card">
          <div class="why-icon">{w.icon}</div>
          <h3>{w.label}</h3>
          <p>{w.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     FAQ SECTION
══════════════════════════════════════════════ -->
<section class="inv-section inv-section--soft" aria-labelledby="faq-title">
  <div class="inv-container inv-container--narrow">
    <div class="inv-section-header">
      <p class="inv-eyebrow">FAQ</p>
      <h2 id="faq-title" class="inv-section-title">Frequently Asked Questions</h2>
      <p class="inv-section-desc">Clear answers about software requirements, hardware setup, and implementation timelines.</p>
    </div>

    <div class="inv-faq-list">
      {faqs.map((f, i) => (
        <details class="inv-faq-item" id={`faq-${i}`}>
          <summary class="inv-faq-q">{f.q}</summary>
          <p class="inv-faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     FINAL CTA BANNER
══════════════════════════════════════════════ -->
<section class="inv-cta-banner" id="demo-form">
  <div class="inv-cta-bg" aria-hidden="true">
    <div class="inv-orb inv-orb--cta1"></div>
    <div class="inv-orb inv-orb--cta2"></div>
