---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const title = "AI Business Automation Solutions | Intelligent Workflow Automation — Hegrix";
const description =
  "Hegrix designs and builds AI business automation systems — intelligent document processing, OCR, AI assistants, approval routing and knowledge retrieval — that eliminate repetitive work and accelerate growth-focused operations.";
const keywords =
  "AI business automation, intelligent process automation, AI workflow software, business process automation company, document automation AI, OCR automation, AI assistants for business, workflow routing automation, knowledge retrieval system, Hegrix AI solutions";
const path = "/solutions/ai-business-automation/";
const siteUrl = "https://hegrix.com";
const canonical = new URL(path, siteUrl).toString();

const faq = [
  {
    q: "What is AI business automation?",
    a: "AI business automation is the use of artificial intelligence technologies — including machine learning, natural language processing (NLP), optical character recognition (OCR) and large language models (LLMs) — to perform, route, or assist with business tasks that would otherwise require manual effort. Examples include automatically extracting data from invoices, routing support tickets, answering employee questions via a knowledge assistant and approving purchase orders without human intervention.",
  },
  {
    q: "How does Hegrix approach AI business automation?",
    a: "Hegrix follows a four-stage approach: Discovery (mapping your current workflows and identifying automation opportunities), Solution Design (selecting the right AI models and integration architecture), Development & Integration (connecting automation into your ERP, CRM or custom systems), and Continuous Optimisation (monitoring accuracy and retraining models as your business evolves). Every solution is built around your specific processes, not a generic off-the-shelf tool.",
  },
  {
    q: "What types of documents can AI process automatically?",
    a: "Hegrix AI automation can process invoices, purchase orders, contracts, delivery notes, shipping labels, insurance forms, medical records, onboarding documents, HR applications and more. The system uses OCR for text extraction and NLP for data classification, validation and routing — achieving high accuracy across structured and semi-structured document types.",
  },
  {
    q: "How does AI automation integrate with existing ERP or CRM systems?",
    a: "Hegrix builds integrations via REST APIs, webhooks and native connectors for platforms including Odoo, SAP, Salesforce, HubSpot, Microsoft Dynamics and custom-built systems. Automated data flows between the AI layer and your existing system of record, eliminating re-keying, reducing errors and providing a single source of truth across departments.",
  },
  {
    q: "Is AI business automation only for large enterprises?",
    a: "No. Hegrix designs AI automation solutions that scale from small teams processing dozens of documents per day to enterprise operations handling millions. The approach is modular — you can start with one workflow (e.g., invoice automation) and expand over time. ROI is typically fastest in the 10–500 employee range where manual process costs are high but dedicated enterprise software budgets are limited.",
  },
  {
    q: "What is an AI knowledge assistant and how does it help business teams?",
    a: "An AI knowledge assistant is a conversational AI interface (chatbot or embedded widget) that answers employee or customer questions by searching your internal documentation, product catalogues, policy manuals or support databases in real time. Instead of waiting for a human agent or searching through folders, users get an accurate answer in seconds. Hegrix builds knowledge assistants that connect to your existing content stores and integrate with your support or intranet systems.",
  },
  {
    q: "How long does it take to implement an AI automation solution?",
    a: "Timelines depend on the complexity of the workflow and integrations involved. A focused single-workflow automation (e.g., invoice OCR plus ERP entry) typically takes 4–8 weeks from kickoff to launch. Multi-workflow platforms with custom AI models and deep ERP integrations generally take 10–16 weeks. Hegrix provides a phased roadmap during discovery so you know exactly what to expect at each milestone.",
  },
  {
    q: "How do I measure the ROI of AI business automation?",
    a: "The most reliable ROI metrics for AI automation are: reduction in manual processing time per document or task, decrease in error rates and associated correction costs, faster cycle times (e.g., invoice-to-payment, ticket-to-resolution) and headcount efficiency (same output with fewer manual hours). Hegrix helps you establish baseline metrics before go-live and provides dashboards to track improvement continuously after launch.",
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "AI Business Automation",
  serviceType: "Intelligent Process Automation",
  description:
    "AI-powered business automation covering document processing, OCR, intelligent approval routing, knowledge retrieval and AI assistants — designed and built by Hegrix for growth-focused enterprises.",
  provider: { "@type": "Organization", name: "Hegrix", url: siteUrl },
  areaServed: "Worldwide",
  url: canonical,
  offers: {
    "@type": "Offer",
    url: `${siteUrl}/contact-us/`,
    availability: "https://schema.org/InStock",
    priceCurrency: "USD",
    priceSpecification: { "@type": "PriceSpecification", description: "Custom project pricing based on scope" },
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "AI Automation Capabilities",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "AI Document Processing & OCR" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Intelligent Approval Routing" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "AI Knowledge Assistants" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Workflow Automation" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Knowledge Retrieval Systems" } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Predictive Analytics & Decision Support" } },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const capabilities = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>`,
    color: "#6366f1",
    label: "AI Document Processing & OCR",
    text: "Automatically extract structured data from invoices, purchase orders, contracts and delivery notes. Hegrix combines OCR with AI validation to eliminate transcription errors at scale.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
    color: "#06b6d4",
    label: "Intelligent Approval Routing",
    text: "Route invoices, expenses and HR requests to the right approver automatically — based on value thresholds, department rules and vendor categories. Fully auditable, configurable without code.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    color: "#10b981",
    label: "AI Knowledge Assistants",
    text: "Deploy conversational AI assistants that search your internal docs, policy manuals and support history in real time. Employees get accurate answers in seconds instead of waiting for a human agent.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
    color: "#f59e0b",
    label: "Knowledge Retrieval (RAG)",
    text: "Build enterprise search and retrieval-augmented generation systems that surface the right information from structured databases, unstructured documents and siloed repositories.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>`,
    color: "#ec4899",
    label: "End-to-End Workflow Automation",
    text: "Automate multi-step business processes — from data ingestion and classification through validation, routing and final entry into your system of record — with human handoff only where needed.",
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
    color: "#8b5cf6",
    label: "Predictive Analytics & Decision Support",
    text: "Give operational teams AI-generated insights at the point of decision — demand forecasts, anomaly alerts and approval recommendations — built on your historical data, refreshed continuously.",
  },
];

const industries = [
  { icon: "💼", label: "Finance & Accounting", text: "Automate invoice capture, three-way matching, expense categorisation and payment approvals. Finance teams move to exception-only oversight." },
  { icon: "🏥", label: "Healthcare & Clinical", text: "Process patient intake forms, insurance pre-authorisations and referral letters automatically. Route to the right care team based on document content." },
  { icon: "🏭", label: "Manufacturing & Quality", text: "Extract supplier invoices, production reports and quality inspection data. Automate non-conformance routing and inventory reorder triggers." },
  { icon: "🚚", label: "Logistics & Freight", text: "Digitise bills of lading, customs declarations and carrier invoices. Automated alerts flag discrepancies before they delay shipments." },
  { icon: "🛒", label: "eCommerce & Retail", text: "Automate product data enrichment, order exception routing and returns classification. AI assistants handle high-volume customer queries without adding headcount." },
  { icon: "📋", label: "Professional Services", text: "Automate contract extraction, scope-change detection and client reporting workflows. Knowledge assistants surface prior project documents instantly." },
];

const steps = [
  { num: "01", label: "Discover", text: "We map your current workflows end-to-end, identifying where manual effort is highest, where errors occur most and where automation delivers the fastest ROI." },
  { num: "02", label: "Design", text: "We select the right AI models — OCR engines, NLP classifiers, LLM retrieval — and design the integration layer connecting outputs to your ERP, CRM or custom platform." },
  { num: "03", label: "Build & Integrate", text: "Hegrix engineers build the automation pipeline, validate accuracy against your real documents and connect to production systems with parallel operation before full cutover." },
  { num: "04", label: "Optimise", text: "After launch, we monitor accuracy, processing volumes and exception rates. Models are retrained as your formats evolve and dashboards give your team full visibility." },
];

const whyCards = [
  { icon: "🔗", label: "Deep ERP Integration", text: "Extensive experience integrating with Odoo, SAP, Salesforce, HubSpot and Microsoft Dynamics. Automation outputs flow directly into your system of record." },
  { icon: "🛠", label: "Custom-Built, Not Off-the-Shelf", text: "Every solution is purpose-built for your document types and approval logic. You own the IP, models are trained on your data, the system behaves exactly as you need." },
  { icon: "🎯", label: "Accuracy-First Engineering", text: "We validate against real production documents before go-live and build exception-handling for edge cases. Low-confidence extractions are flagged for human review." },
  { icon: "☁️", label: "Scalable from Day One", text: "Cloud-native deployment on AWS, Azure or Google Cloud ensures reliable performance from hundreds to millions of documents per day." },
];

const stats = [
  { value: "4–8 wks", label: "Typical first workflow launch" },
  { value: "90%+", label: "Document extraction accuracy" },
  { value: "10×", label: "Faster than manual processing" },
  { value: "24 / 7", label: "Automated processing uptime" },
];

const related = [
  { href: "/solutions/erp-integration/", icon: "🔌", label: "ERP Integration", text: "Connect AI automation outputs directly into your ERP for seamless data flow without manual re-entry." },
  { href: "/solutions/customer-portal/", icon: "🖥", label: "Customer Portal", text: "Surface AI-generated status updates and knowledge search inside a branded self-service portal." },
  { href: "/services/workflow-automation/", icon: "⚙️", label: "Workflow Automation", text: "Automate approval chains, notifications and task routing integrated with the AI document layer." },
  { href: "/services/generative-ai/", icon: "✨", label: "Generative AI", text: "Add LLM-powered content generation, summarisation and intelligent search to your automation workflows." },
  { href: "/services/nlp-solutions/", icon: "🧠", label: "NLP Solutions", text: "Natural language processing for document classification, entity extraction and intelligent text automation." },
  { href: "/solutions/inventory-pos-system/", icon: "📦", label: "Inventory & POS", text: "Use AI automation to trigger reorder workflows, process supplier invoices and update stock records automatically." },
];
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  path={path}
  schema={[serviceSchema, faqSchema]}
>

<!-- ══════════════════════════════════════════════
     HERO — dark gradient with animated orbs
══════════════════════════════════════════════ -->
<section class="aiba-hero" aria-labelledby="hero-h1">
  <div class="aiba-hero__bg" aria-hidden="true">
    <div class="aiba-orb aiba-orb--1"></div>
    <div class="aiba-orb aiba-orb--2"></div>
    <div class="aiba-orb aiba-orb--3"></div>
    <div class="aiba-grid-overlay"></div>
  </div>
  <div class="aiba-container aiba-hero__inner">
    <div class="aiba-badge">Hegrix Solution</div>
    <h1 id="hero-h1" class="aiba-hero__title">
      AI Business<br/>
      <span class="aiba-gradient-text">Automation</span>
    </h1>
    <p class="aiba-hero__sub">
      Replace repetitive manual work with intelligent systems that process documents, route approvals,
      answer questions and retrieve knowledge — automatically. Integrated with your existing ERP, CRM
      and operations stack.
    </p>
    <div class="aiba-hero__actions">
      <a class="aiba-btn aiba-btn--primary" href="/contact-us/" id="hero-cta-primary">Get a Quote</a>
      <a class="aiba-btn aiba-btn--ghost" href="/services/ai-automation/" id="hero-cta-secondary">
        Explore AI Services
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
    <div class="aiba-stats" aria-label="Key metrics">
      {stats.map(s => (
        <div class="aiba-stat">
          <span class="aiba-stat__val">{s.value}</span>
          <span class="aiba-stat__lbl">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     WHAT IS AI BUSINESS AUTOMATION?
══════════════════════════════════════════════ -->
<section class="aiba-section" aria-labelledby="what-h2">
  <div class="aiba-container">
    <div class="aiba-section__split">
      <div class="aiba-section__text">
        <p class="aiba-eyebrow">Understanding the technology</p>
        <h2 id="what-h2" class="aiba-section__title">What is AI business automation?</h2>
        <p class="aiba-section__body">
          AI business automation uses artificial intelligence — machine learning, natural language
          processing (NLP), optical character recognition (OCR) and large language models (LLMs) — to
          perform or assist with tasks that would otherwise require manual human effort.
        </p>
        <p class="aiba-section__body">
          Rather than replacing your team, well-designed AI automation handles the high-volume,
          rule-based portions of a workflow — reading invoices, classifying documents, routing
          approvals, surfacing relevant knowledge — so your people focus on judgment-intensive work.
        </p>
        <p class="aiba-section__body">
          Hegrix builds custom AI automation solutions that connect directly into your existing
          systems. Every solution is purpose-built for your data formats, approval logic and
          integration requirements — not a generic platform adapter.
        </p>
      </div>
      <div class="aiba-section__visual" aria-hidden="true">
        <div class="aiba-flow-card">
          <div class="aiba-flow-node aiba-flow-node--in">
            <span>📄</span> Invoice Received
          </div>
          <div class="aiba-flow-arrow">↓ OCR Extraction</div>
          <div class="aiba-flow-node">
            <span>🧠</span> AI Validation
          </div>
          <div class="aiba-flow-arrow">↓ Smart Routing</div>
          <div class="aiba-flow-node">
            <span>✅</span> Auto-Approved
          </div>
          <div class="aiba-flow-arrow">↓ ERP Sync</div>
          <div class="aiba-flow-node aiba-flow-node--out">
            <span>📊</span> Posted to Ledger
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     CORE CAPABILITIES
══════════════════════════════════════════════ -->
<section class="aiba-section aiba-section--dark" aria-labelledby="cap-h2">
  <div class="aiba-container">
    <div class="aiba-section__head">
      <p class="aiba-eyebrow aiba-eyebrow--light">What Hegrix builds</p>
      <h2 id="cap-h2" class="aiba-section__title aiba-section__title--light">Core AI automation capabilities</h2>
      <p class="aiba-section__intro aiba-section__intro--light">
        Six capabilities that can be deployed individually or combined into a unified automation platform built around your exact workflow.
      </p>
    </div>
    <div class="aiba-cap-grid">
      {capabilities.map(c => (
        <article class="aiba-cap-card">
          <div class="aiba-cap-card__icon" style={`color:${c.color};background:${c.color}18`} set:html={c.icon}></div>
          <h3 class="aiba-cap-card__title">{c.label}</h3>
          <p class="aiba-cap-card__text">{c.text}</p>
          <div class="aiba-cap-card__glow" style={`background:${c.color}`}></div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     INDUSTRY USE CASES
══════════════════════════════════════════════ -->
<section class="aiba-section" aria-labelledby="ind-h2">
  <div class="aiba-container">
    <div class="aiba-section__head">
      <p class="aiba-eyebrow">Industry applications</p>
      <h2 id="ind-h2" class="aiba-section__title">AI automation across every sector</h2>
      <p class="aiba-section__intro">Repetitive, document-heavy workflows exist in every industry. Hegrix has designed AI automation solutions spanning finance, healthcare, manufacturing, logistics and eCommerce.</p>
    </div>
    <div class="aiba-ind-grid">
      {industries.map(ind => (
        <article class="aiba-ind-card">
          <div class="aiba-ind-card__icon">{ind.icon}</div>
          <h3 class="aiba-ind-card__title">{ind.label}</h3>
          <p class="aiba-ind-card__text">{ind.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     HOW IT WORKS — timeline
══════════════════════════════════════════════ -->
<section class="aiba-section aiba-section--soft" aria-labelledby="proc-h2">
  <div class="aiba-container">
    <div class="aiba-section__head">
      <p class="aiba-eyebrow">Our process</p>
      <h2 id="proc-h2" class="aiba-section__title">How Hegrix delivers AI automation</h2>
      <p class="aiba-section__intro">A structured four-stage process that ensures the solution fits your operations before a single line of production code is written.</p>
    </div>
    <div class="aiba-steps">
      {steps.map((s, i) => (
        <div class="aiba-step">
          <div class="aiba-step__num">{s.num}</div>
          <div class="aiba-step__body">
            <h3 class="aiba-step__title">{s.label}</h3>
            <p class="aiba-step__text">{s.text}</p>
          </div>
          {i < steps.length - 1 && <div class="aiba-step__connector" aria-hidden="true"></div>}
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     WHY HEGRIX
══════════════════════════════════════════════ -->
<section class="aiba-section" aria-labelledby="why-h2">
  <div class="aiba-container">
    <div class="aiba-section__head">
      <p class="aiba-eyebrow">Why Hegrix</p>
      <h2 id="why-h2" class="aiba-section__title">Built-for-business AI expertise</h2>
      <p class="aiba-section__intro">Hegrix is an enterprise software and AI development company that builds automation systems that integrate with existing infrastructure rather than replacing it.</p>
    </div>
    <div class="aiba-why-grid">
      {whyCards.map(w => (
        <article class="aiba-why-card">
          <div class="aiba-why-card__icon">{w.icon}</div>
          <h3 class="aiba-why-card__title">{w.label}</h3>
          <p class="aiba-why-card__text">{w.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     RELATED SOLUTIONS
══════════════════════════════════════════════ -->
<section class="aiba-section aiba-section--soft" aria-labelledby="rel-h2">
  <div class="aiba-container">
    <div class="aiba-section__head">
      <p class="aiba-eyebrow">Connected capabilities</p>
      <h2 id="rel-h2" class="aiba-section__title">AI automation works best with these</h2>
      <p class="aiba-section__intro">Hegrix commonly pairs AI automation with these solutions for maximum operational impact.</p>
    </div>
    <div class="aiba-rel-grid">
      {related.map(r => (
        <a class="aiba-rel-card" href={r.href} id={`related-${r.label.toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'')}`}>
          <div class="aiba-rel-card__icon">{r.icon}</div>
          <div>
            <h3 class="aiba-rel-card__title">{r.label}</h3>
            <p class="aiba-rel-card__text">{r.text}</p>
          </div>
          <svg class="aiba-rel-card__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     FAQ
══════════════════════════════════════════════ -->
<section class="aiba-section" aria-labelledby="faq-h2">
  <div class="aiba-container aiba-container--narrow">
    <div class="aiba-section__head">
      <p class="aiba-eyebrow">FAQ</p>
      <h2 id="faq-h2" class="aiba-section__title">Common questions about AI automation</h2>
      <p class="aiba-section__intro">Clear answers to help you evaluate whether AI automation is the right next step for your team.</p>
    </div>
    <div class="aiba-faq">
      {faq.map((item, i) => (
        <details class="aiba-faq__item" id={`faq-${i}`}>
          <summary class="aiba-faq__q">{item.q}</summary>
          <p class="aiba-faq__a">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     FINAL CTA — dark banner
══════════════════════════════════════════════ -->
<section class="aiba-cta" aria-labelledby="cta-h2">
  <div class="aiba-cta__bg" aria-hidden="true">
    <div class="aiba-orb aiba-orb--cta1"></div>
    <div class="aiba-orb aiba-orb--cta2"></div>
  </div>
  <div class="aiba-container aiba-cta__inner">
    <p class="aiba-eyebrow aiba-eyebrow--light">Next step</p>
    <h2 id="cta-h2" class="aiba-cta__title">Ready to automate your most repetitive workflows?</h2>
    <p class="aiba-cta__sub">Share the processes you want to automate and we will design a scoped, integrated AI automation roadmap for your business.</p>
    <div class="aiba-cta__actions">
      <a class="aiba-btn aiba-btn--white" href="/contact-us/" id="final-cta-btn">Start a project</a>
      <a class="aiba-btn aiba-btn--outline-light" href="/services/ai-automation/">View AI Services</a>
    </div>
  </div>
</section>

</Layout>

<style>
/* ═══════════════════════════════════════
   PAGE-SCOPED DESIGN TOKENS
═══════════════════════════════════════ */
:root {
  --aiba-blue:   #2563eb;
  --aiba-indigo: #6366f1;
  --aiba-cyan:   #06b6d4;
  --aiba-dark:   #060d1f;
  --aiba-dark2:  #0b1630;
  --aiba-mid:    #111c38;
  --aiba-ink:    #0f172a;
  --aiba-text:   #1e293b;
  --aiba-muted:  #64748b;
  --aiba-line:   #e2e8f0;
  --aiba-soft:   #f8faff;
  --aiba-radius: 18px;
