---
import Layout from "../layouts/Layout.astro";

const stats = [
  { number: "500+", label: "Projects Delivered" },
  { number: "200+", label: "Happy Clients" },
  { number: "15+", label: "Countries Served" },
  { number: "98%", label: "Client Satisfaction" },
  { number: "10+", label: "Years Experience" },
];

const services = [
  {
    title: "Odoo ERP",
    desc: "End-to-end Odoo implementation, custom Python module development, and workflow automation.",
    icon: "⚙️",
    link: "/services/odoo-implementation-services/",
  },
  {
    title: "ERP Consulting",
    desc: "Strategic process auditing, roadmap architecture, and expert ERP rollout advisory.",
    icon: "📊",
    link: "/services/odoo-consulting-services/",
  },
  {
    title: "Custom Software",
    desc: "Tailored web, desktop, and enterprise software built for unique operational workflows.",
    icon: "💻",
    link: "/services/custom-software-development/",
  },
  {
    title: "Web Development",
    desc: "High-converting, SEO-optimized web applications and portal platforms using modern frameworks.",
    icon: "🌐",
    link: "/services/custom-website-development/",
  },
  {
    title: "Mobile Apps",
    desc: "Native and cross-platform iOS & Android mobile applications for field & consumer teams.",
    icon: "📱",
    link: "/services/odoo-mobile-app-development/",
  },
  {
    title: "Cloud Solutions",
    desc: "Cloud migration, server infrastructure, Kubernetes, and 24/7 DevOps management.",
    icon: "☁️",
    link: "/services/cloud-devops/",
  },
  {
    title: "AI Automation",
    desc: "Machine learning, predictive analytics, intelligent chatbots, and workflow automation.",
    icon: "🤖",
    link: "/services/ai-automation/",
  },
  {
    title: "Business Intelligence",
    desc: "Real-time executive dashboards, data warehousing, and custom reporting pipelines.",
    icon: "📈",
    link: "/services/analytics/",
  },
  {
    title: "Marketplace Development",
    desc: "Multi-vendor e-commerce marketplaces with seller portals and automated commission engines.",
    icon: "🛍️",
    link: "/services/marketplace-development/",
  },
  {
    title: "E-commerce Solutions",
    desc: "Scalable B2B & B2C e-commerce stores with omnichannel inventory synchronization.",
    icon: "🛒",
    link: "/services/ecommerce-development/",
  },
  {
    title: "Dedicated Developers",
    desc: "Augment your engineering team with certified Odoo, Python, React, and Cloud developers.",
    icon: "👨‍💻",
    link: "/services/hire-odoo-developer/",
  },
  {
    title: "Support & Maintenance",
    desc: "Dedicated SLA support, server health monitoring, security updates, and hypercare.",
    icon: "🛠️",
    link: "/services/odoo-support-maintenance-services/",
  },
];

const whyUs = [
  {
    title: "Certified Experts",
    desc: "Certified Odoo architects, senior Python engineers, and cloud specialists with decade-plus experience.",
    icon: "🏅",
  },
  {
    title: "Business-Focused Solutions",
    desc: "Technology engineered around real operational outcomes, revenue growth, and staff efficiency.",
    icon: "🎯",
  },
  {
    title: "Agile Development",
    desc: "Rapid 2-week sprint iterations with continuous deployment, testing, and feedback loops.",
    icon: "⚡",
  },
  {
    title: "Transparent Communication",
    desc: "Real-time project tracking, dedicated account managers, and clear documentation.",
    icon: "💬",
  },
  {
    title: "Scalable Architecture",
    desc: "Modular software design built to expand seamlessly across new entities, regions, and users.",
    icon: "🏗️",
  },
  {
    title: "Long-Term Partnership",
    desc: "Ongoing optimization, feature upgrades, and strategic advisory long after go-live.",
    icon: "🤝",
  },
  {
    title: "24/7 Support",
    desc: "Continuous system health monitoring, SLA guarantees, and rapid incident resolution.",
    icon: "🛡️",
  },
];

const industries = [
  { name: "Manufacturing", desc: "Discrete & process MRP, BOM, work center tracking, and quality control.", icon: "🏭" },
  { name: "Retail", desc: "Omnichannel POS, barcode scanning, multi-warehouse stock, and loyalty rewards.", icon: "🏷️" },
  { name: "Healthcare", desc: "Patient portals, medical inventory, asset tracking, and compliant billing.", icon: "🏥" },
  { name: "Construction", desc: "Project cost control, subcontractor invoicing, equipment tracking, and bidding.", icon: "🏗️" },
  { name: "Education", desc: "Student portals, course enrollment, automated tuition billing, and attendance.", icon: "🎓" },
  { name: "Finance", desc: "Double-entry accounting, automated reconciliation, tax compliance, and analytics.", icon: "💳" },
  { name: "Logistics", desc: "Fleet management, route optimization, shipping carrier APIs, and WMS.", icon: "🚛" },
  { name: "Real Estate", desc: "Property listings, lease management, tenant portals, and maintenance tracking.", icon: "🏢" },
  { name: "Hospitality", desc: "Reservation engines, table POS, kitchen displays, and vendor procurement.", icon: "🏨" },
  { name: "Wholesale", desc: "B2B buyer portals, volume pricing matrices, multi-currency invoicing, and drop shipping.", icon: "📦" },
];

const techWall = [
  { category: "ERP", items: ["Odoo", "SAP", "Microsoft Dynamics"] },
  { category: "Frontend", items: ["React", "Next.js", "Vue", "Angular"] },
  { category: "Backend", items: ["Python", "Node.js", "Laravel", "PHP"] },
  { category: "Mobile", items: ["Flutter", "React Native", "iOS", "Android"] },
  { category: "Cloud", items: ["AWS", "Azure", "Google Cloud", "Docker", "Kubernetes"] },
  { category: "Databases", items: ["PostgreSQL", "MySQL", "MongoDB", "Redis"] },
];

const processSteps = [
  { step: "01", title: "Discover", desc: "Deep-dive operational audit, workflow mapping, and goals alignment." },
  { step: "02", title: "Plan", desc: "Technical architecture design, module selection, and project roadmap." },
  { step: "03", title: "Design", desc: "User-centric UI/UX mockups, data flow diagrams, and prototype approval." },
  { step: "04", title: "Develop", desc: "Phased agile development, custom module coding, and API integrations." },
  { step: "05", title: "Test", desc: "Rigorous UAT, performance stress testing, security audit, and data validation." },
  { step: "06", title: "Deploy", desc: "Controlled production rollout with automated database migration and zero downtime." },
  { step: "07", title: "Support", desc: "Hypercare launch assistance, user training, and 24/7 SLA maintenance." },
];
---

<Layout
  title="Hegrix | Enterprise Digital Transformation, Odoo ERP & AI Solutions"
  description="Hegrix delivers enterprise digital transformation through Odoo ERP implementation, custom software development, AI automation, cloud services, and mobile apps."
  keywords="Hegrix, digital transformation company, Odoo ERP implementation, custom software development, AI automation, cloud services"
  path="/"
>
  <div class="home-wrapper">
    {/* SECTION 1 – Hero Section */}
    <section class="home-hero-section">
      <div class="home-hero-glow glow-1" aria-hidden="true"></div>
      <div class="home-hero-glow glow-2" aria-hidden="true"></div>
      <div class="home-hero-dots" aria-hidden="true"></div>

      <div class="container">
        <div class="home-hero-grid">
          <div class="home-hero-content">
            <div class="hero-pill">
              <span class="pill-star">✨</span>
              <span>Enterprise Digital Transformation</span>
            </div>
            <h1 class="home-hero-title">
              Empowering Businesses Through <span class="hero-gradient-text">Intelligent Digital Solutions</span>
            </h1>
            <p class="home-hero-desc">
              From Odoo ERP implementation to AI-powered automation and custom software development, we help businesses streamline operations, improve productivity, and accelerate growth with scalable technology solutions.
            </p>
            <div class="home-hero-btns">
              <a href="/contact-us/" class="home-btn-primary">Start Your Project &rarr;</a>
              <a href="/contact-us/" class="home-btn-secondary">Book Free Consultation</a>
            </div>
            <div class="home-hero-tags">
              <span>✔ Odoo ERP</span>
              <span>✔ AI & Automation</span>
              <span>✔ Custom Software</span>
              <span>✔ Cloud Infrastructure</span>
            </div>
          </div>

          {/* 3D Dashboard Mockup Visual */}
          <div class="home-hero-visual">
            <div class="floating-badge badge-crm">📊 CRM</div>
            <div class="floating-badge badge-sales">💼 Sales</div>
            <div class="floating-badge badge-inventory">📦 Inventory</div>
            <div class="floating-badge badge-accounting">💳 Accounting</div>
            <div class="floating-badge badge-mfg">🏭 Manufacturing</div>
            <div class="floating-badge badge-analytics">📈 Analytics</div>
            <div class="floating-badge badge-cloud">☁️ Cloud</div>
            <div class="floating-badge badge-ai">🤖 AI</div>
            <div class="floating-badge badge-auto">⚡ Automation</div>

            <div class="home-3d-card">
              <div class="card-glass-header">
                <div class="header-dots"><span></span><span></span><span></span></div>
                <span class="header-label">Hegrix Enterprise Operating System v4.0</span>
              </div>
              <div class="card-glass-body">
                <div class="mock-kpi-row">
                  <div class="mock-kpi"><span>Operations Efficiency</span><strong>+94.8%</strong></div>
                  <div class="mock-kpi"><span>Active Users</span><strong>12,450</strong></div>
                  <div class="mock-kpi"><span>AI Automation</span><strong>Active</strong></div>
                </div>
                <div class="mock-graph-box">
                  <div class="graph-title">Real-Time Enterprise Intelligence</div>
                  <svg viewBox="0 0 320 80" class="hero-graph-svg">
                    <path d="M0,60 Q40,20 80,45 T160,15 T240,30 T320,5 L320,80 L0,80 Z" fill="rgba(11, 85, 217, 0.15)"/>
                    <path d="M0,60 Q40,20 80,45 T160,15 T240,30 T320,5" stroke="#0B55D9" stroke-width="3" fill="none"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 2 – Trusted Worldwide & Stats */}
    <section class="home-stats-section">
      <div class="container">
        <div class="home-stats-card">
          {stats.map((stat, idx) => (
            <>
              <div class="home-stat-item">
                <div class="stat-big-num">{stat.number}</div>
                <div class="stat-small-label">{stat.label}</div>
              </div>
              {idx < stats.length - 1 && <div class="stat-vert-line"></div>}
            </>
          ))}
        </div>

        <div class="home-logos-bar">
          <p class="logos-title">Trusted by Ambitious Enterprises & Global Brands</p>
          <div class="logos-row">
            <span>ACME Enterprise</span>
            <span>GlobalTech</span>
            <span>Zenith Industries</span>
            <span>Nexora Global</span>
            <span>Vertex Solutions</span>
            <span>BrightWay Logistics</span>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 3 – Our Services */}
    <section class="home-section">
      <div class="container">
        <div class="home-section-header">
          <p class="home-eyebrow">Services</p>
          <h2 class="home-title">Enterprise Digital Services</h2>
          <p class="home-desc">Complete end-to-end technology capabilities designed to transform your operations and drive growth.</p>
        </div>
        <div class="home-services-grid">
          {services.map((s) => (
            <a href={s.link} class="home-service-card">
              <div class="service-icon-box">{s.icon}</div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <span class="service-learn-more">Learn More &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 4 – Why Choose Us */}
    <section class="home-section home-alt-section">
      <div class="container">
        <div class="home-section-header">
          <p class="home-eyebrow">Why Choose Us</p>
          <h2 class="home-title">Why Global Enterprises Partner With Hegrix</h2>
          <p class="home-desc">We combine deep domain expertise, senior engineering talent, and business-first strategy.</p>
        </div>

        <div class="why-us-staggered">
          {whyUs.map((w, idx) => (
            <div class={`why-row ${idx % 2 === 1 ? 'reverse' : ''}`}>
              <div class="why-visual">
                <div class="why-icon-badge">{w.icon}</div>
              </div>
              <div class="why-content">
                <h3>{w.title}</h3>
                <p>{w.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 5 – Industries */}
    <section class="home-section">
      <div class="container">
        <div class="home-section-header">
          <p class="home-eyebrow">Industries</p>
          <h2 class="home-title">Tailored Digital Solutions for Every Sector</h2>
          <p class="home-desc">Deep industry expertise to solve specific compliance, operational, and reporting challenges.</p>
        </div>
        <div class="home-industries-grid">
          {industries.map((ind) => (
            <a href="/industries/" class="home-ind-card">
              <div class="ind-icon">{ind.icon}</div>
              <h3>{ind.name}</h3>
              <p>{ind.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 6 – Technology Expertise Wall */}
    <section class="home-section home-alt-section">
      <div class="container">
        <div class="home-section-header">
          <p class="home-eyebrow">Technology Stack</p>
          <h2 class="home-title">Enterprise Technology Stack</h2>
          <p class="home-desc">Modern, robust platforms chosen for speed, security, scalability, and maintainability.</p>
        </div>
        <div class="tech-wall-grid">
          {techWall.map((t) => (
            <div class="tech-cat-card">
              <h3>{t.category}</h3>
              <div class="tech-pills">
                {t.items.map((item) => (
                  <span class="tech-pill">{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 7 – Featured Success Stories */}
    <section class="home-section">
      <div class="container">
        <div class="home-section-header">
          <p class="home-eyebrow">Success Stories</p>
          <h2 class="home-title">Featured Business Transformations</h2>
          <p class="home-desc">Explore how growth-focused companies unlocked new efficiency with Hegrix digital solutions.</p>
        </div>
        <div class="home-cases-grid">
          <div class="home-case-card">
            <span class="case-tag">Manufacturing & ERP</span>
            <h3>Global Manufacturing Enterprise</h3>
            <div class="case-split-details">
              <div><strong>Challenge:</strong> 40% inventory discrepancies across 5 factories due to legacy spreadsheets.</div>
              <div><strong>Solution:</strong> End-to-end Odoo MRP, Inventory, and Accounting setup with barcode automation.</div>
              <div><strong>Result:</strong> 99.4% stock accuracy, +35% production efficiency, and $1.2M annual savings.</div>
            </div>
            <div class="case-stat-box">
              <span class="big-stat">+35%</span>
              <span class="lbl-stat">Production Efficiency</span>
            </div>
          </div>

          <div class="home-case-card">
            <span class="case-tag">Omnichannel Retail</span>
            <h3>Zenith Global Retail Chain</h3>
            <div class="case-split-details">
              <div><strong>Challenge:</strong> Disconnected stock between 25 physical retail outlets and online e-commerce storefront.</div>
              <div><strong>Solution:</strong> Unified Odoo POS, E-Commerce, and CRM setup hosted on cloud infrastructure.</div>
              <div><strong>Result:</strong> Instant real-time stock sync, 4.8x faster checkout speed, and zero stockouts.</div>
            </div>
            <div class="case-stat-box">
              <span class="big-stat">4.8x</span>
              <span class="lbl-stat">Faster Checkout Speed</span>
            </div>
          </div>

          <div class="home-case-card">
            <span class="case-tag">Logistics & AI</span>
            <h3>Nexora Logistics Corporation</h3>
            <div class="case-split-details">
              <div><strong>Challenge:</strong> Manual billing process taking 5 business days per monthly invoicing cycle.</div>
              <div><strong>Solution:</strong> Automated Odoo Invoicing, AI Document Processing, and Customer Portal.</div>
              <div><strong>Result:</strong> Monthly billing reduced from 5 days to 2 hours with 99.99% cloud uptime.</div>
            </div>
            <div class="case-stat-box">
              <span class="big-stat">90%</span>
              <span class="lbl-stat">Faster Monthly Billing</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 8 – Client Testimonials */}
    <section class="home-section home-alt-section">
      <div class="container">
        <div class="home-section-header">
          <p class="home-eyebrow">Testimonials</p>
          <h2 class="home-title">What Enterprise Leaders Say</h2>
          <p class="home-desc">Real feedback from executive partners who accelerated their business with Hegrix.</p>
        </div>
        <div class="home-testi-grid">
          <div class="home-testi-card">
            <div class="testi-stars">★★★★★</div>
            <p class="testi-body">"Hegrix brought structure to our enterprise software roadmap and helped us launch a clean customer portal experience in record time."</p>
            <div class="testi-author">
              <div class="author-avatar">DM</div>
              <div><strong>David Miller</strong><span>CTO, Apex Manufacturing</span></div>
            </div>
          </div>

          <div class="home-testi-card">
            <div class="testi-stars">★★★★★</div>
            <p class="testi-body">"Their team translated a highly complex retail workflow into software our store staff actually loved to use. Zero downtime during launch."</p>
            <div class="testi-author">
              <div class="author-avatar">SJ</div>
              <div><strong>Sarah Jenkins</strong><span>VP of Operations, Zenith Retail</span></div>
            </div>
          </div>

          <div class="home-testi-card">
            <div class="testi-stars">★★★★★</div>
            <p class="testi-body">"The Odoo ERP and AI automation Hegrix built eliminated hundreds of hours of manual finance work every month. Exceptional technical team."</p>
            <div class="testi-author">
              <div class="author-avatar">MV</div>
              <div><strong>Marcus Vance</strong><span>Managing Director, Nexora Logistics</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* SECTION 9 – Our Process */}
    <section class="home-section">
      <div class="container">
        <div class="home-section-header">
          <p class="home-eyebrow">Delivery Process</p>
          <h2 class="home-title">Our Proven 7-Step Delivery Methodology</h2>
          <p class="home-desc">A disciplined, transparent process from initial discovery to deployment and continuous growth.</p>
        </div>
        <div class="home-process-grid">
          {processSteps.map((p) => (
            <div class="process-card">
              <div class="process-num">{p.step}</div>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* SECTION 10 – Latest Insights */}
    <section class="home-section home-alt-section">
      <div class="container">
        <div class="home-section-header">
          <p class="home-eyebrow">Latest Insights</p>
          <h2 class="home-title">Digital Transformation Guides</h2>
          <p class="home-desc">Articles, whitepapers, and guides on Odoo ERP, AI automation, and cloud architecture.</p>
        </div>
        <div class="home-blog-grid">
          <article class="home-blog-card">
            <div class="blog-img-box b1"></div>
            <div class="blog-content">
              <span class="blog-tag">B2B Commerce</span>
              <h3>How to Plan a Scalable B2B Commerce Platform</h3>
              <p>Key architectural steps to connect self-service ordering portals with back-office ERP systems.</p>
              <a href="/blog/" class="blog-link">Read Guide &rarr;</a>
            </div>
          </article>

          <article class="home-blog-card">
            <div class="blog-img-box b2"></div>
            <div class="blog-content">
              <span class="blog-tag">ERP Strategy</span>
              <h3>ERP Integration Mistakes That Slow Growing Teams</h3>
              <p>How to avoid common data synchronization traps when implementing enterprise ERP systems.</p>
              <a href="/blog/" class="blog-link">Read Guide &rarr;</a>
            </div>
          </article>

          <article class="home-blog-card">
            <div class="blog-img-box b3"></div>
            <div class="blog-content">
              <span class="blog-tag">AI & Automation</span>
              <h3>Where AI Automation Creates the Fastest Business Value</h3>
              <p>Practical enterprise use cases for document processing, intelligent routing, and predictive analytics.</p>
              <a href="/blog/" class="blog-link">Read Guide &rarr;</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    {/* SECTION 11 – Final CTA */}
    <section class="home-section home-final-cta">
      <div class="container">
        <div class="home-cta-card">
          <h2>Let's Build Your Next Digital Success Story</h2>
          <p>Partner with our experts to transform your business using modern ERP, AI, cloud, and custom software solutions.</p>
          <div class="home-cta-btns">
            <a href="/contact-us/" class="home-btn-primary btn-white">Schedule Consultation &rarr;</a>
            <a href="/contact-us/" class="home-btn-secondary btn-outline">Contact Our Team</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
