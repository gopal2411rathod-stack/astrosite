---
import Layout from "../layouts/Layout.astro";

const coreServices = [
  {
    title: "Odoo & Enterprise ERP",
    desc: "End-to-end Odoo implementation, customization, migration, and ERP integrations. We automate business workflows and connect your operations into one unified platform.",
    features: ["Odoo Implementation", "Custom Module Development", "ERP Migration & Integration", "Business Workflow Automation"],
    link: "/services/odoo-development/",
    iconType: "erp",
    accent: "#7c3aed",
  },
  {
    title: "AI & Business Automation",
    desc: "Eliminate manual processes with AI-powered document processing, intelligent assistants, workflow routing, and custom automation built around your operations.",
    features: ["AI Agents & Assistants", "Document Processing & OCR", "Intelligent Workflow Routing", "Custom AI Applications"],
    link: "/solutions/ai-business-automation/",
    iconType: "ai",
    accent: "#0891b2",
  },
  {
    title: "Custom Enterprise Software",
    desc: "Tailored web applications, B2B platforms, multi-vendor marketplaces, customer portals, and enterprise integrations engineered for your specific business logic.",
    features: ["B2B Commerce Platforms", "Custom Web Applications", "Multi-Vendor Marketplaces", "Enterprise Integrations"],
    link: "/services/custom-software-development/",
    iconType: "software",
    accent: "#0b55d9",
  },
];

const solutions = [
  {
    title: "Business Process Automation",
    desc: "Replace manual approvals, data entry, and reporting with automated workflows that save time and reduce errors.",
    icon: "⚡",
  },
  {
    title: "Inventory & Operations Management",
    desc: "Real-time stock control, multi-location warehousing, purchasing automation, and barcode workflows.",
    icon: "📦",
  },
  {
    title: "ERP Integration & Modernization",
    desc: "Connect your ecommerce, finance, CRM, and analytics systems into a single operating view.",
    icon: "🔗",
  },
  {
    title: "B2B Commerce & Ordering",
    desc: "Account-based pricing, quote workflows, bulk ordering portals, and self-service buyer experiences.",
    icon: "🏪",
  },
  {
    title: "Customer & Partner Portals",
    desc: "Secure self-service dashboards for orders, invoices, tickets, documents, and communication.",
    icon: "🔐",
  },
  {
    title: "Data Intelligence & Reporting",
    desc: "Real-time executive dashboards, custom reporting pipelines, and data-driven decision support.",
    icon: "📊",
  },
];

const industries = [
  { name: "Manufacturing", desc: "MRP, BOM, shop floor tracking, and quality control.", link: "/industries/manufacturing/", icon: "🏭" },
  { name: "Retail & eCommerce", desc: "POS, inventory, loyalty programs, and omnichannel commerce.", link: "/industries/retail/", icon: "🛍️" },
  { name: "Healthcare", desc: "Patient portals, medical inventory, and compliant workflows.", link: "/industries/healthcare/", icon: "🏥" },
  { name: "Logistics", desc: "Fleet management, route optimization, and shipment tracking.", link: "/industries/logistics/", icon: "🚚" },
  { name: "Real Estate", desc: "Property listings, lease management, and CRM-connected portals.", link: "/industries/real-estate/", icon: "🏢" },
  { name: "Finance", desc: "Accounting automation, compliance workflows, and client portals.", link: "/industries/finance/", icon: "💰" },
];

const caseStudies = [
  {
    tag: "ERP Implementation",
    tagColor: "#7c3aed",
    client: "Manufacturing Enterprise",
    industry: "Manufacturing",
    challenge: "Legacy spreadsheet-based inventory tracking causing significant stock discrepancies across multiple factory locations.",
    solution: "Implemented end-to-end Odoo MRP, Inventory, and Accounting modules with barcode automation and real-time reporting dashboards.",
    stack: ["Odoo 17", "Python", "PostgreSQL", "Barcode API"],
    isPlaceholder: true,
  },
  {
    tag: "Omnichannel Retail",
    tagColor: "#0891b2",
    client: "Multi-Store Retail Chain",
    industry: "Retail",
    challenge: "Disconnected stock data between physical retail outlets and the online e-commerce storefront, causing overselling and stockouts.",
    solution: "Unified Odoo POS, eCommerce, and CRM on high-availability cloud infrastructure with real-time stock synchronization.",
    stack: ["Odoo 17", "React", "AWS", "REST API"],
    isPlaceholder: true,
  },
  {
    tag: "AI Automation",
    tagColor: "#059669",
    client: "Logistics Company",
    industry: "Logistics",
    challenge: "Manual invoice processing taking several business days per monthly billing cycle, causing delays and errors.",
    solution: "Automated invoicing with AI document processing, OCR extraction, approval routing, and a self-service customer portal.",
    stack: ["Python", "OpenAI", "Odoo", "Node.js"],
    isPlaceholder: true,
  },
];

const whyUs = [
  {
    title: "Business-Focused Engineering",
    desc: "Technology designed around real operational outcomes, revenue growth, and staff efficiency — not just code.",
    icon: "🎯",
  },
  {
    title: "Deep ERP Expertise",
    desc: "Experienced Odoo developers, Python engineers, and ERP architects who understand complex business workflows.",
    icon: "⚙️",
  },
  {
    title: "Custom-Built, Not Templates",
    desc: "Every solution is engineered for your specific processes. No generic out-of-the-box installations.",
    icon: "🔧",
  },
  {
    title: "Scalable Architecture",
    desc: "Modular software design built to expand seamlessly across new entities, regions, and user volumes.",
    icon: "📈",
  },
  {
    title: "Integration Specialists",
    desc: "We connect your ERP, CRM, ecommerce, accounting, and third-party systems into a unified workflow.",
    icon: "🔗",
  },
  {
    title: "Long-Term Partnership",
    desc: "Ongoing optimization, feature upgrades, and strategic advisory long after your system goes live.",
    icon: "🤝",
  },
];

const processSteps = [
  { step: "01", title: "Discovery", desc: "Deep-dive operational audit, workflow mapping, and goals alignment.", color: "#7c3aed" },
  { step: "02", title: "Planning", desc: "Technical architecture design, module selection, and project roadmap.", color: "#0b55d9" },
  { step: "03", title: "Design", desc: "User-centric UI/UX mockups, data flow diagrams, and prototype review.", color: "#0891b2" },
  { step: "04", title: "Development", desc: "Phased agile sprints, custom module coding, and API integrations.", color: "#059669" },
  { step: "05", title: "Testing", desc: "Rigorous UAT, performance testing, security audit, and data validation.", color: "#d97706" },
  { step: "06", title: "Deployment", desc: "Controlled production rollout with data migration and zero downtime.", color: "#be185d" },
  { step: "07", title: "Continuous Support", desc: "User training, SLA maintenance, optimization, and strategic growth advisory.", color: "#7c3aed" },
];

const testimonials = [
  {
    quote: "Hegrix brought structure to our enterprise software roadmap and helped us launch a customer portal experience ahead of schedule. The team consistently exceeded expectations.",
    author: "Project Lead",
    company: "Manufacturing Enterprise",
    initials: "PL",
    avatarColor: "#7c3aed",
    isRepresentative: true,
  },
  {
    quote: "Their team translated a complex retail workflow into software our store staff actually loved to use. Exceptional execution with zero downtime during launch.",
    author: "Operations Director",
    company: "Retail Chain",
    initials: "OD",
    avatarColor: "#0891b2",
    isRepresentative: true,
  },
  {
    quote: "The Odoo ERP and AI automation they built eliminated hundreds of hours of manual finance work every month. Best technical partnership we've experienced.",
    author: "Managing Director",
    company: "Logistics Company",
    initials: "MD",
    avatarColor: "#059669",
    isRepresentative: true,
  },
];

const homeSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Hegrix — Enterprise Software, Odoo ERP & AI Development",
  description: "Hegrix builds enterprise software, Odoo ERP solutions, AI automation, and custom digital platforms that simplify operations and accelerate business growth.",
  url: "https://hegrix.com/",
  provider: {
    "@type": "Organization",
    name: "Hegrix",
    url: "https://hegrix.com",
  },
};
---

<Layout
  title="Hegrix — Enterprise Software, Odoo ERP & AI Solutions"
  description="Hegrix builds enterprise software that makes businesses run smarter. Odoo ERP implementation, AI automation, custom software development, and B2B digital platforms."
  keywords="Odoo development company, enterprise software development, AI automation, ERP implementation, custom software, B2B ecommerce development"
  path="/"
  schema={homeSchema}
>
  <div class="hp">

    <!-- ═══════════════════════════════════════
         HERO SECTION
    ═══════════════════════════════════════ -->
    <section class="hp-hero" aria-label="Hero">
      <div class="hp-hero__bg" aria-hidden="true">
        <div class="hp-hero__gradient"></div>
        <div class="hp-hero__grid"></div>
      </div>

      <div class="container">
        <div class="hp-hero__inner">
          <div class="hp-hero__content">
            <div class="hp-hero__badge">
              <span class="hp-hero__badge-dot"></span>
              <span>Enterprise Software & ERP Development</span>
            </div>

            <h1 class="hp-hero__h1">
              We Build Enterprise Software That Makes Businesses
              <span class="hp-hero__accent">Run Smarter</span>
            </h1>

            <p class="hp-hero__sub">
              From Odoo ERP and AI automation to custom enterprise platforms, we engineer digital solutions that simplify operations, connect systems, and accelerate business growth.
            </p>

            <div class="hp-hero__actions">
              <a href="/contact-us/" class="hp-btn hp-btn--primary" id="hero-cta-consult">
                <span>Book a Free Consultation</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/solutions/" class="hp-btn hp-btn--ghost" id="hero-cta-work">
                <span>Explore Our Work</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>

            <div class="hp-hero__signals">
              <div class="hp-hero__signal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Odoo ERP Specialists</span>
              </div>
              <div class="hp-hero__signal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>AI & Process Automation</span>
              </div>
              <div class="hp-hero__signal">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Custom Enterprise Platforms</span>
              </div>
            </div>
          </div>

          <!-- Visual: Clean capability grid instead of fake dashboard -->
          <div class="hp-hero__visual" aria-hidden="true">
            <div class="hp-hero__cap-grid">
              <div class="hp-hero__cap-card hp-hero__cap-card--main">
                <div class="hp-hero__cap-icon" style="color:#7c3aed">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <span class="hp-hero__cap-label">Odoo ERP</span>
                <span class="hp-hero__cap-sub">Implementation & Customization</span>
              </div>
              <div class="hp-hero__cap-card">
                <div class="hp-hero__cap-icon" style="color:#0891b2">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                </div>
                <span class="hp-hero__cap-label">AI Automation</span>
              </div>
              <div class="hp-hero__cap-card">
                <div class="hp-hero__cap-icon" style="color:#0b55d9">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </div>
                <span class="hp-hero__cap-label">Custom Software</span>
              </div>
              <div class="hp-hero__cap-card">
                <div class="hp-hero__cap-icon" style="color:#059669">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
                </div>
                <span class="hp-hero__cap-label">Cloud & DevOps</span>
              </div>
              <div class="hp-hero__cap-card">
                <div class="hp-hero__cap-icon" style="color:#d97706">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                </div>
                <span class="hp-hero__cap-label">Business Intelligence</span>
              </div>
              <div class="hp-hero__cap-card">
                <div class="hp-hero__cap-icon" style="color:#be185d">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                </div>
                <span class="hp-hero__cap-label">Web Development</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         TRUST BAR
    ═══════════════════════════════════════ -->
    <section class="hp-trust" aria-label="Trusted by businesses">
      <div class="container">
        <div class="hp-trust__bar">
          <div class="hp-trust__item">
            <strong>Odoo ERP</strong>
            <span>Certified Expertise</span>
          </div>
          <div class="hp-trust__divider" aria-hidden="true"></div>
          <div class="hp-trust__item">
            <strong>Global</strong>
            <span>Delivery Capability</span>
          </div>
          <div class="hp-trust__divider" aria-hidden="true"></div>
          <div class="hp-trust__item">
            <strong>Agile</strong>
            <span>2-Week Sprint Cycles</span>
          </div>
          <div class="hp-trust__divider" aria-hidden="true"></div>
          <div class="hp-trust__item">
            <strong>Full-Stack</strong>
            <span>End-to-End Development</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         CORE SERVICES
    ═══════════════════════════════════════ -->
    <section class="hp-section" aria-labelledby="services-heading">
      <div class="container">
        <div class="hp-section__header hp-reveal">
          <p class="hp-eyebrow">Core Services</p>
          <h2 id="services-heading" class="hp-section__title">Three Pillars of Enterprise Technology</h2>
          <p class="hp-section__desc">Complete capabilities designed to transform your operations and drive measurable business growth.</p>
        </div>

        <div class="hp-core-grid">
          {coreServices.map((s) => (
            <a href={s.link} class="hp-core-card" style={`--card-accent: ${s.accent}`} id={`core-${s.iconType}`}>
              <div class="hp-core-card__icon">
                {s.iconType === "erp" && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
                {s.iconType === "ai" && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
                {s.iconType === "software" && <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>}
              </div>
              <h3 class="hp-core-card__title">{s.title}</h3>
              <p class="hp-core-card__desc">{s.desc}</p>
              <ul class="hp-core-card__features">
                {s.features.map((f) => <li>{f}</li>)}
              </ul>
              <span class="hp-core-card__cta">
                <span>Learn More</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>

        <div class="hp-section__footer">
          <a href="/services/" class="hp-btn hp-btn--outline" id="view-all-services">
            <span>Explore All Services</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         SOLUTIONS - BUSINESS PROBLEMS
    ═══════════════════════════════════════ -->
    <section class="hp-section hp-section--alt" aria-labelledby="solutions-heading">
      <div class="container">
        <div class="hp-section__header hp-reveal">
          <p class="hp-eyebrow">Solutions</p>
          <h2 id="solutions-heading" class="hp-section__title">Business Problems We Solve</h2>
          <p class="hp-section__desc">We focus on business outcomes — not just technology. Here's what our clients achieve.</p>
        </div>

        <div class="hp-solutions-grid">
          {solutions.map((s) => (
            <div class="hp-solution-card">
              <div class="hp-solution-card__icon">{s.icon}</div>
              <h3 class="hp-solution-card__title">{s.title}</h3>
              <p class="hp-solution-card__desc">{s.desc}</p>
            </div>
          ))}
        </div>

        <div class="hp-section__footer">
          <a href="/solutions/" class="hp-btn hp-btn--outline" id="view-all-solutions">
            <span>View All Solutions</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         INDUSTRIES
    ═══════════════════════════════════════ -->
    <section class="hp-section" aria-labelledby="industries-heading">
      <div class="container">
        <div class="hp-section__header hp-reveal">
          <p class="hp-eyebrow">Industries</p>
          <h2 id="industries-heading" class="hp-section__title">Tailored Solutions for Your Sector</h2>
          <p class="hp-section__desc">Deep domain expertise to address industry-specific compliance, operational, and reporting challenges.</p>
        </div>

        <div class="hp-ind-grid">
          {industries.map((ind) => (
            <a href={ind.link} class="hp-ind-card" id={`ind-${ind.name.toLowerCase().replace(/[^a-z]/g, '')}`}>
              <div class="hp-ind-card__icon">{ind.icon}</div>
              <div class="hp-ind-card__content">
                <h3 class="hp-ind-card__title">{ind.name}</h3>
                <p class="hp-ind-card__desc">{ind.desc}</p>
              </div>
              <span class="hp-ind-card__arrow">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>

        <div class="hp-section__footer">
          <a href="/industries/" class="hp-btn hp-btn--outline" id="view-all-industries">
            <span>View All Industries</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         CASE STUDIES
    ═══════════════════════════════════════ -->
    <section class="hp-section hp-section--alt" aria-labelledby="cases-heading">
      <div class="container">
        <div class="hp-section__header hp-reveal">
          <p class="hp-eyebrow">Case Studies</p>
          <h2 id="cases-heading" class="hp-section__title">Featured Business Transformations</h2>
          <p class="hp-section__desc">Representative examples of how businesses unlock new efficiency with Hegrix solutions.</p>
        </div>

        <div class="hp-cases-grid">
          {caseStudies.map((c) => (
            <div class="hp-case-card">
              <div class="hp-case-card__header">
                <span class="hp-case-card__tag" style={`background: ${c.tagColor}12; color: ${c.tagColor}; border-color: ${c.tagColor}30`}>
                  {c.tag}
                </span>
                {c.isPlaceholder && <span class="hp-case-card__placeholder-badge">Representative Example</span>}
              </div>
              <h3 class="hp-case-card__client">{c.client}</h3>
              <p class="hp-case-card__industry">{c.industry}</p>
              <div class="hp-case-card__details">
                <div class="hp-case-card__detail">
                  <strong>Challenge</strong>
                  <p>{c.challenge}</p>
                </div>
                <div class="hp-case-card__detail">
                  <strong>Solution</strong>
                  <p>{c.solution}</p>
                </div>
              </div>
              <div class="hp-case-card__stack">
                {c.stack.map((t) => <span class="hp-case-card__tech">{t}</span>)}
              </div>
              <a href="/contact-us/" class="hp-case-card__cta">
                <span>Discuss a Similar Project</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         WHY CHOOSE HEGRIX
    ═══════════════════════════════════════ -->
    <section class="hp-section" aria-labelledby="why-heading">
      <div class="container">
        <div class="hp-section__header hp-reveal">
          <p class="hp-eyebrow">Why Hegrix</p>
          <h2 id="why-heading" class="hp-section__title">Why Businesses Choose to Partner With Us</h2>
          <p class="hp-section__desc">We combine deep domain expertise, senior engineering talent, and a business-first strategy to deliver outcomes that matter.</p>
        </div>

        <div class="hp-why-grid">
          {whyUs.map((w) => (
            <div class="hp-why-card">
              <div class="hp-why-card__icon">{w.icon}</div>
              <h3 class="hp-why-card__title">{w.title}</h3>
              <p class="hp-why-card__desc">{w.desc}</p>
            </div>
          ))}
        </div>

        <div class="hp-section__footer">
          <a href="/about-us/" class="hp-btn hp-btn--outline" id="why-us-cta">
            <span>Learn More About Hegrix</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         DEVELOPMENT PROCESS
    ═══════════════════════════════════════ -->
    <section class="hp-section hp-section--alt" aria-labelledby="process-heading">
      <div class="container">
        <div class="hp-section__header hp-reveal">
          <p class="hp-eyebrow">How We Work</p>
          <h2 id="process-heading" class="hp-section__title">Our Proven Delivery Process</h2>
          <p class="hp-section__desc">A disciplined, transparent methodology from initial discovery through deployment and continuous support.</p>
        </div>

        <div class="hp-process">
          {processSteps.map((p) => (
            <div class="hp-process-step">
