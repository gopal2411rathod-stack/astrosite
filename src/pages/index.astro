        max-width: 580px;
        margin: 0 auto;
      }

      .hp-blog-grid {
        grid-template-columns: 1fr;
        max-width: 520px;
        margin: 0 auto;
      }
    }

    @media (max-width: 640px) {
      .hp-hero {
        padding: 60px 0 50px;
        min-height: auto;
      }

      .hp-hero__cap-grid {
        grid-template-columns: 1fr;
      }

      .hp-hero__cap-card--main {
        grid-column: span 1;
      }

      .hp-trust__bar {
