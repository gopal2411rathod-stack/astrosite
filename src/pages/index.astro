---
import Layout from "../layouts/Layout.astro";

const stats = [
  { number: "500+", label: "Projects Delivered", icon: "🚀" },
  { number: "200+", label: "Happy Clients", icon: "🤝" },
  { number: "15+", label: "Countries Served", icon: "🌍" },
  { number: "98%", label: "Client Satisfaction", icon: "⭐" },
  { number: "10+", label: "Years Experience", icon: "🏆" },
];

const services = [
  {
    title: "Odoo ERP",
    desc: "End-to-end Odoo implementation, custom Python module development, and workflow automation for enterprise operations.",
    iconType: "odoo",
    link: "/services/odoo-implementation-services/",
    tag: "Most Popular",
    color: "#7c3aed",
  },
  {
    title: "AI & Automation",
    desc: "Machine learning, predictive analytics, intelligent chatbots, and workflow automation to eliminate manual processes.",
    iconType: "ai",
    link: "/services/ai-automation/",
    tag: "Trending",
    color: "#0891b2",
  },
  {
    title: "Custom Software",
    desc: "Tailored web, desktop, and enterprise software built for unique operational workflows and business logic.",
    iconType: "software",
    link: "/services/custom-software-development/",
    tag: "",
    color: "#0b55d9",
  },
  {
    title: "ERP Consulting",
    desc: "Strategic process auditing, roadmap architecture, and expert ERP rollout advisory from certified architects.",
    iconType: "consulting",
    link: "/services/odoo-consulting-services/",
    tag: "",
    color: "#059669",
  },
  {
    title: "Cloud & DevOps",
    desc: "Cloud migration, server infrastructure, Kubernetes, and 24/7 DevOps management on AWS, Azure & GCP.",
    iconType: "cloud",
    link: "/services/cloud-devops/",
    tag: "",
    color: "#d97706",
  },
  {
    title: "Web Development",
    desc: "High-converting, SEO-optimized web applications and portal platforms using modern React and Next.js frameworks.",
    iconType: "web",
    link: "/services/custom-website-development/",
    tag: "",
    color: "#be185d",
  },
  {
    title: "Mobile Apps",
    desc: "Native and cross-platform iOS & Android mobile applications for field operations and consumer-facing teams.",
    iconType: "mobile",
    link: "/services/odoo-mobile-app-development/",
    tag: "",
    color: "#7c3aed",
  },
  {
    title: "Business Intelligence",
    desc: "Real-time executive dashboards, data warehousing, and custom reporting pipelines for data-driven decisions.",
    iconType: "bi",
    link: "/services/analytics/",
    tag: "",
    color: "#0b55d9",
  },
];

const whyUs = [
  {
    title: "Certified Experts",
    desc: "Certified Odoo architects, senior Python engineers, and cloud specialists with decade-plus experience.",
    iconType: "experts",
    metric: "50+",
    metricLabel: "Certified Developers",
  },
  {
    title: "Business-Focused Solutions",
    desc: "Technology engineered around real operational outcomes, revenue growth, and staff efficiency gains.",
    iconType: "solutions",
    metric: "98%",
    metricLabel: "Client Satisfaction",
  },
  {
    title: "Agile Development",
    desc: "Rapid 2-week sprint iterations with continuous deployment, testing, and feedback loops.",
    iconType: "agile",
    metric: "2wk",
    metricLabel: "Sprint Cycles",
  },
  {
    title: "Transparent Communication",
    desc: "Real-time project tracking, dedicated account managers, and clear documentation throughout.",
    iconType: "comm",
    metric: "24/7",
    metricLabel: "Project Visibility",
  },
  {
    title: "Scalable Architecture",
    desc: "Modular software design built to expand seamlessly across new entities, regions, and users.",
    iconType: "architecture",
    metric: "∞",
    metricLabel: "Scalable Design",
  },
  {
    title: "Long-Term Partnership",
    desc: "Ongoing optimization, feature upgrades, and strategic advisory long after go-live.",
    iconType: "partnership",
    metric: "10+",
    metricLabel: "Years Experience",
  },
];

const industries = [
  { name: "Manufacturing", desc: "Discrete & process MRP, BOM, work center tracking, and quality control.", iconType: "manufacturing", link: "/industries/manufacturing-erp-software-solutions/" },
  { name: "Retail", desc: "Omnichannel POS, barcode scanning, multi-warehouse stock, and loyalty rewards.", iconType: "retail", link: "/industries/" },
  { name: "Healthcare", desc: "Patient portals, medical inventory, asset tracking, and compliant billing.", iconType: "healthcare", link: "/industries/" },
  { name: "Construction", desc: "Project cost control, subcontractor invoicing, equipment tracking, and bidding.", iconType: "construction", link: "/industries/" },
  { name: "Education", desc: "Student portals, course enrollment, automated tuition billing, and attendance.", iconType: "education", link: "/industries/" },
  { name: "Finance", desc: "Double-entry accounting, automated reconciliation, tax compliance, and analytics.", iconType: "finance", link: "/industries/" },
  { name: "Logistics", desc: "Fleet management, route optimization, shipping carrier APIs, and WMS.", iconType: "logistics", link: "/industries/" },
  { name: "Real Estate", desc: "Property listings, lease management, tenant portals, and maintenance tracking.", iconType: "realestate", link: "/industries/real-estate-erp-software-solutions/" },
  { name: "Hospitality", desc: "Reservation engines, table POS, kitchen displays, and vendor procurement.", iconType: "hospitality", link: "/industries/travel-hospitality/" },
  { name: "Wholesale", desc: "B2B buyer portals, volume pricing matrices, multi-currency invoicing, and drop shipping.", iconType: "wholesale", link: "/industries/" },
];

const techWall = [
  { category: "ERP", items: ["Odoo", "SAP", "MS Dynamics"], color: "#7c3aed" },
  { category: "Frontend", items: ["React", "Next.js", "Vue", "Angular"], color: "#0891b2" },
  { category: "Backend", items: ["Python", "Node.js", "Laravel"], color: "#059669" },
  { category: "Mobile", items: ["Flutter", "React Native", "iOS", "Android"], color: "#d97706" },
  { category: "Cloud", items: ["AWS", "Azure", "GCP", "Docker", "K8s"], color: "#0b55d9" },
  { category: "Databases", items: ["PostgreSQL", "MongoDB", "Redis"], color: "#be185d" },
];

const processSteps = [
  { step: "01", title: "Discover", desc: "Deep-dive operational audit, workflow mapping, and goals alignment.", icon: "🔍" },
  { step: "02", title: "Plan", desc: "Technical architecture design, module selection, and project roadmap.", icon: "📋" },
  { step: "03", title: "Design", desc: "User-centric UI/UX mockups, data flow diagrams, and prototype approval.", icon: "🎨" },
  { step: "04", title: "Develop", desc: "Phased agile development, custom module coding, and API integrations.", icon: "⚙️" },
  { step: "05", title: "Test", desc: "Rigorous UAT, performance stress testing, security audit, and data validation.", icon: "✅" },
  { step: "06", title: "Deploy", desc: "Controlled production rollout with automated migration and zero downtime.", icon: "🚀" },
  { step: "07", title: "Support", desc: "Hypercare launch assistance, user training, and 24/7 SLA maintenance.", icon: "🛡️" },
];

const caseStudies = [
  {
    tag: "Manufacturing & ERP",
    tagColor: "#7c3aed",
    client: "Global Manufacturing Enterprise",
    challenge: "40% inventory discrepancies across 5 factories due to legacy spreadsheets.",
    solution: "End-to-end Odoo MRP, Inventory, and Accounting setup with barcode automation.",
    result: "99.4% stock accuracy, +35% production efficiency, and $1.2M annual savings.",
    bigStat: "+35%",
    statLabel: "Production Efficiency",
    statColor: "#059669",
  },
  {
    tag: "Omnichannel Retail",
    tagColor: "#0891b2",
    client: "Zenith Global Retail Chain",
    challenge: "Disconnected stock between 25 physical retail outlets and online e-commerce storefront.",
    solution: "Unified Odoo POS, E-Commerce, and CRM hosted on high-availability cloud infrastructure.",
    result: "Real-time stock sync, 4.8x faster checkout speed, and zero stockouts.",
    bigStat: "4.8x",
    statLabel: "Faster Checkout",
    statColor: "#0891b2",
  },
  {
    tag: "Logistics & AI",
    tagColor: "#d97706",
    client: "Nexora Logistics Corporation",
    challenge: "Manual billing process taking 5 business days per monthly invoicing cycle.",
    solution: "Automated Odoo Invoicing, AI Document Processing, and Customer Portal.",
    result: "Monthly billing reduced from 5 days to 2 hours with 99.99% cloud uptime.",
    bigStat: "90%",
    statLabel: "Faster Billing",
    statColor: "#d97706",
  },
];

const testimonials = [
  {
    quote: "Hegrix brought structure to our enterprise software roadmap and helped us launch a clean customer portal experience in record time. The team exceeded every expectation.",
    author: "David Miller",
    role: "CTO",
    company: "Apex Manufacturing",
    initials: "DM",
    avatarColor: "#7c3aed",
  },
  {
    quote: "Their team translated a highly complex retail workflow into software our store staff actually loved to use. Zero downtime during launch. Exceptional execution.",
    author: "Sarah Jenkins",
    role: "VP of Operations",
    company: "Zenith Retail",
    initials: "SJ",
    avatarColor: "#0891b2",
  },
  {
    quote: "The Odoo ERP and AI automation Hegrix built eliminated hundreds of hours of manual finance work every month. Best technical team we've ever worked with.",
    author: "Marcus Vance",
    role: "Managing Director",
    company: "Nexora Logistics",
    initials: "MV",
    avatarColor: "#059669",
  },
];
---

<Layout
  title="Hegrix | Enterprise Digital Transformation, Odoo ERP & AI Solutions"
  description="Hegrix delivers enterprise digital transformation through Odoo ERP implementation, custom software development, AI automation, cloud services, and mobile apps."
  keywords="Hegrix, digital transformation company, Odoo ERP implementation, custom software development, AI automation, cloud services"
  path="/"
>
  <div class="hp-root">

    <!-- ═══════════════════════════════════════════════
         SECTION 1 — HERO
    ═══════════════════════════════════════════════ -->
    <section class="hp-hero" aria-label="Hero">
      <!-- Background layers -->
      <div class="hp-hero__mesh" aria-hidden="true"></div>
      <div class="hp-hero__orb hp-hero__orb--1" aria-hidden="true"></div>
      <div class="hp-hero__orb hp-hero__orb--2" aria-hidden="true"></div>
      <div class="hp-hero__orb hp-hero__orb--3" aria-hidden="true"></div>
      <div class="hp-hero__grid-lines" aria-hidden="true"></div>

      <div class="container">
        <div class="hp-hero__inner">
          <!-- Left: Content -->
          <div class="hp-hero__content">
            <div class="hp-hero__badge">
              <span class="hp-hero__badge-dot"></span>
              <span>Enterprise Digital Transformation</span>
            </div>

            <h1 class="hp-hero__h1">
              Empowering Businesses Through
              <span class="hp-hero__gradient-text">Intelligent Digital Solutions</span>
            </h1>

            <p class="hp-hero__subtext">
              From Odoo ERP implementation to AI-powered automation and custom software development — we help businesses streamline operations, improve productivity, and accelerate growth with scalable technology.
            </p>

            <div class="hp-hero__actions">
              <a href="/contact-us/" class="hp-btn hp-btn--primary" id="hero-cta-primary">
                <span>Start Your Project</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="/contact-us/" class="hp-btn hp-btn--ghost" id="hero-cta-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013 12.43a19.79 19.79 0 01-3.07-8.67A2 2 0 011.9 1.77h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
                <span>Book Free Consultation</span>
              </a>
            </div>

            <div class="hp-hero__trust">
              <div class="hp-hero__trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#0bbf8a" stroke="none"><path d="M20 6L9 17l-5-5"/></svg>
                <span>500+ Projects Delivered</span>
              </div>
              <div class="hp-hero__trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#0bbf8a" stroke="none"><path d="M20 6L9 17l-5-5"/></svg>
                <span>98% Client Satisfaction</span>
              </div>
              <div class="hp-hero__trust-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#0bbf8a" stroke="none"><path d="M20 6L9 17l-5-5"/></svg>
                <span>15+ Countries Served</span>
              </div>
            </div>
          </div>

          <!-- Right: Dashboard Visual -->
          <div class="hp-hero__visual" aria-hidden="true">
            <!-- Floating badges -->
            <div class="hp-float-badge hp-float-badge--crm">
              <span class="hp-float-badge__icon">📊</span><span>CRM</span>
            </div>
            <div class="hp-float-badge hp-float-badge--sales">
              <span class="hp-float-badge__icon">💼</span><span>Sales</span>
            </div>
            <div class="hp-float-badge hp-float-badge--inventory">
              <span class="hp-float-badge__icon">📦</span><span>Inventory</span>
            </div>
            <div class="hp-float-badge hp-float-badge--ai">
              <span class="hp-float-badge__icon">🤖</span><span>AI Engine</span>
            </div>
            <div class="hp-float-badge hp-float-badge--cloud">
              <span class="hp-float-badge__icon">☁️</span><span>Cloud</span>
            </div>
            <div class="hp-float-badge hp-float-badge--auto">
              <span class="hp-float-badge__icon">⚡</span><span>Automation</span>
            </div>

            <!-- Main dashboard card -->
            <div class="hp-dash-card">
              <div class="hp-dash-card__header">
                <div class="hp-dash-card__dots">
                  <span class="dot dot--red"></span>
                  <span class="dot dot--yellow"></span>
                  <span class="dot dot--green"></span>
                </div>
                <span class="hp-dash-card__title">Hegrix Enterprise OS · v4.0</span>
                <div class="hp-dash-card__live">
                  <span class="live-dot"></span>
                  <span>Live</span>
                </div>
              </div>

              <div class="hp-dash-card__body">
                <!-- KPI Row -->
                <div class="hp-kpi-row">
                  <div class="hp-kpi">
                    <span class="hp-kpi__label">Ops Efficiency</span>
                    <strong class="hp-kpi__value">+94.8%</strong>
                    <span class="hp-kpi__change hp-kpi__change--up">↑ 12.3%</span>
                  </div>
                  <div class="hp-kpi">
                    <span class="hp-kpi__label">Active Users</span>
                    <strong class="hp-kpi__value">12,450</strong>
                    <span class="hp-kpi__change hp-kpi__change--up">↑ 5.2%</span>
                  </div>
                  <div class="hp-kpi">
                    <span class="hp-kpi__label">AI Automation</span>
                    <strong class="hp-kpi__value">Active</strong>
                    <span class="hp-kpi__badge">24/7</span>
                  </div>
                </div>

                <!-- Chart -->
                <div class="hp-chart-box">
                  <div class="hp-chart-box__header">
                    <span class="hp-chart-box__title">Real-Time Enterprise Intelligence</span>
                    <span class="hp-chart-box__sub">Last 30 days</span>
                  </div>
                  <svg viewBox="0 0 340 90" class="hp-chart-svg" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="rgba(11,85,217,0.25)"/>
                        <stop offset="100%" stop-color="rgba(11,85,217,0)"/>
                      </linearGradient>
                    </defs>
                    <path d="M0,65 C30,55 55,20 85,38 S135,10 170,18 S220,35 250,25 S305,8 340,3 L340,90 L0,90 Z" fill="url(#chartGrad)"/>
                    <path d="M0,65 C30,55 55,20 85,38 S135,10 170,18 S220,35 250,25 S305,8 340,3" stroke="#0b55d9" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                    <!-- Data points -->
                    <circle cx="85" cy="38" r="4" fill="#0b55d9"/>
                    <circle cx="170" cy="18" r="4" fill="#0b55d9"/>
                    <circle cx="250" cy="25" r="4" fill="#0b55d9"/>
                    <circle cx="340" cy="3" r="4" fill="#1fb6ff"/>
                  </svg>
                </div>

                <!-- Bottom modules -->
                <div class="hp-dash-modules">
                  <div class="hp-dash-module hp-dash-module--green">
                    <span>Revenue</span>
                    <strong>$2.4M</strong>
                  </div>
                  <div class="hp-dash-module hp-dash-module--blue">
                    <span>Inventory</span>
                    <strong>99.4%</strong>
                  </div>
                  <div class="hp-dash-module hp-dash-module--purple">
                    <span>NPS Score</span>
                    <strong>92</strong>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         SECTION 2 — STATS & SOCIAL PROOF
    ═══════════════════════════════════════════════ -->
    <section class="hp-stats" aria-label="Company statistics">
      <div class="container">
        <div class="hp-stats__card">
          {stats.map((stat, idx) => (
            <>
              <div class="hp-stat">
                <div class="hp-stat__icon">{stat.icon}</div>
                <div class="hp-stat__num">{stat.number}</div>
                <div class="hp-stat__label">{stat.label}</div>
              </div>
              {idx < stats.length - 1 && <div class="hp-stat__divider" aria-hidden="true"></div>}
            </>
          ))}
        </div>

        <div class="hp-logos">
          <p class="hp-logos__label">Trusted by Ambitious Enterprises Worldwide</p>
          <div class="hp-logos__track" aria-label="Client logos">
            <div class="hp-logos__inner">
              {["ACME Enterprise", "GlobalTech", "Zenith Industries", "Nexora Global", "Vertex Solutions", "BrightWay Logistics", "PrimeTech Corp", "Alpine Systems", "ACME Enterprise", "GlobalTech", "Zenith Industries", "Nexora Global", "Vertex Solutions", "BrightWay Logistics"].map((name) => (
                <span class="hp-logo-pill">{name}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         SECTION 3 — SERVICES
    ═══════════════════════════════════════════════ -->
    <section class="hp-section" aria-labelledby="services-heading">
      <div class="container">
        <div class="hp-section__header">
          <p class="hp-eyebrow">What We Do</p>
          <h2 id="services-heading" class="hp-section__title">Enterprise Digital Services</h2>
          <p class="hp-section__desc">Complete end-to-end technology capabilities designed to transform your operations and drive measurable growth.</p>
        </div>

        <div class="hp-services-grid">
          {services.map((s, idx) => (
            <a href={s.link} class={`hp-service-card ${idx === 0 ? 'hp-service-card--featured' : ''}`} style={`--card-accent: ${s.color}`} id={`service-${s.iconType}`}>
              <div class="hp-service-card__top">
                <div class="hp-service-card__icon-box" style={`background: ${s.color}18; color: ${s.color}`}>
                  {s.iconType === "odoo" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>}
                  {s.iconType === "consulting" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>}
                  {s.iconType === "software" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>}
                  {s.iconType === "web" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>}
                  {s.iconType === "mobile" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>}
                  {s.iconType === "cloud" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>}
                  {s.iconType === "ai" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>}
                  {s.iconType === "bi" && <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>}
                </div>
                {s.tag && <span class="hp-service-card__tag" style={`background: ${s.color}18; color: ${s.color}`}>{s.tag}</span>}
              </div>
              <h3 class="hp-service-card__title">{s.title}</h3>
              <p class="hp-service-card__desc">{s.desc}</p>
              <span class="hp-service-card__cta">
                <span>Learn More</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
              <div class="hp-service-card__border" aria-hidden="true"></div>
            </a>
          ))}
        </div>

        <div class="hp-section__footer">
          <a href="/services/" class="hp-btn hp-btn--outline" id="view-all-services">
            <span>Explore All Services</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         SECTION 4 — WHY CHOOSE US
    ═══════════════════════════════════════════════ -->
    <section class="hp-section hp-section--alt" aria-labelledby="why-heading">
      <div class="container">
        <div class="hp-why">
          <!-- Left: Text block -->
          <div class="hp-why__left">
            <p class="hp-eyebrow">Why Choose Us</p>
            <h2 id="why-heading" class="hp-section__title hp-section__title--left">Why Global Enterprises Partner With Hegrix</h2>
            <p class="hp-section__desc hp-section__desc--left">We combine deep domain expertise, senior engineering talent, and a business-first strategy to deliver outcomes that matter.</p>

            <div class="hp-why__checks">
              <div class="hp-why__check">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Certified Odoo Gold Partner</span>
              </div>
              <div class="hp-why__check">
