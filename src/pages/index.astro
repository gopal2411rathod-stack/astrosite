      }

      .hp-ind-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .hp-cases-grid {
        grid-template-columns: 1fr;
        max-width: 580px;
        margin: 0 auto;
      }

      .hp-why-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .hp-testi-grid {
