<script>
  // Client-side interactions
  document.addEventListener('DOMContentLoaded', () => {
    // Module Tabs
    const modTabs = document.querySelectorAll('.js-module-nav .re-mod-tab');
    const modPanels = document.querySelectorAll('.re-mod-panel');

    modTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target');
        modTabs.forEach(t => t.classList.remove('active'));
        modPanels.forEach(p => p.classList.remove('active'));
        
        tab.classList.add('active');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) targetPanel.classList.add('active');
      });
    });

    // Showcase Tabs
    const scTabs = document.querySelectorAll('.re-sc-tab');
    const scViews = document.querySelectorAll('.re-sc-view');

    scTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const viewId = tab.getAttribute('data-view');
        scTabs.forEach(t => t.classList.remove('active'));
        scViews.forEach(v => v.classList.remove('active'));

        tab.classList.add('active');
        const targetView = document.getElementById(viewId);
        if (targetView) targetView.classList.add('active');
      });
    });

    // Modal Trigger
    const modal = document.querySelector('.js-demo-modal');
    const openBtns = document.querySelectorAll('.js-open-demo-modal');
    const closeBtn = document.querySelector('.js-close-demo-modal');

    openBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (modal) modal.classList.add('active');
      });
    });

    if (closeBtn && modal) {
      closeBtn.addEventListener('click', () => {
        modal.classList.remove('active');
      });
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.remove('active');
      });
    }
  });
</script>

