    </section>

    <!-- 2. TRUSTED BY SECTION -->
    <section class="re-trusted">
      <div class="re-container">
        <p class="re-trusted-heading">Trusted by Leading Real Estate Developers, Builders & Property Management Firms</p>
        <div class="re-logos-grid">
