---
import Layout from "../layouts/Layout.astro";

const faqList = [
  {
    question: "Is the real estate software cloud-based?",
    answer: "Yes, our platform is 100% cloud-based. You can access property listings, sales pipelines, rental records, and analytics anytime, anywhere from any browser or mobile device with zero server maintenance required."
  },
  {
    question: "Can I manage multiple projects and property types simultaneously?",
    answer: "Absolutely. The platform supports multi-project management across residential apartments, villas, commercial complexes, plotting layouts, and mixed-use developments from a single centralized dashboard."
  },
  {
    question: "Does the solution include comprehensive rental management?",
    answer: "Yes. It covers tenant onboarding, lease agreement tracking, automated rent collection reminders, maintenance request ticketing, lease renewals, and vacant unit tracking."
  },
  {
    question: "How does the system track and follow up on customer inquiries?",
    answer: "Our built-in CRM automatically captures inquiries from your website, property portals, WhatsApp, and social campaigns. It assigns leads to sales reps and triggers automated follow-up reminders."
  },
  {
    question: "Does it include a dedicated CRM for real estate agents and sales teams?",
    answer: "Yes. The CRM is built specifically for real estate, featuring buyer preferences matching, site visit scheduling, communication logs, quotation generation, and deal stage tracking."
  },
  {
    question: "Can the platform manage contracts, agreements, and legal documents?",
    answer: "Yes. It includes digital document management with custom templates for booking forms, sales agreements, lease contracts, payment receipts, and automated e-signature workflows."
  },
  {
    question: "Is mobile access available for site managers and field agents?",
    answer: "Yes, we provide native iOS and Android mobile apps. Field agents can conduct site visits, capture client feedback, collect token payments, and upload construction progress photos in real time."
  },
  {
    question: "Do you provide implementation, data migration, and team training?",
    answer: "Yes. Our expert implementation team handles custom setup, legacy data migration, third-party API integration, role-based user configuration, and comprehensive hands-on staff training."
  }
];

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Hegrix Real Estate Software Solutions",
    operatingSystem: "Cloud, Web, Linux, Windows, iOS, Android",
    applicationCategory: "BusinessApplication",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
    },
    description: "Enterprise Real Estate ERP & CRM software for developers, builders, property management firms, and agencies. Manage listings, leads, sales, rentals, projects, and finance.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqList.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
interface Props {
  path?: string;
}

const { path = Astro.url.pathname } = Astro.props;
---

<Layout
  title="Real Estate Software Solutions | Enterprise ERP & CRM for Developers & Builders"
  description="Transform your real estate business with our intelligent B2B SaaS platform. Manage properties, leads, sales CRM, rentals, construction projects, and financial reports."
  keywords="Real Estate Software Solutions, Real Estate ERP, Real Estate CRM, Property Management Software, Real Estate Builder Software, Tenant Management System, Real Estate Sales Pipeline"
  path={path}
  schema={schemaData}
>
  <div class="re-wrapper">

    <!-- 1. HERO SECTION -->
    <section class="re-hero">
      <div class="re-hero-glow-1" aria-hidden="true"></div>
