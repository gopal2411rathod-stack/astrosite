      </div>
      <div class="ocs-hero-trust"><span class="ocs-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span><span>4.9/5 Rating</span><span class="ocs-sep">&#183;</span><span>250+ Projects</span><span class="ocs-sep">&#183;</span><span>100+ Happy Clients</span></div>
    </div>
    <div class="ocs-hero-visual ocs-fade-up-delay">
      <div class="ocs-dashboard-card">
        <div class="ocs-dash-header"><div class="ocs-dash-dots"><span></span><span></span><span></span></div><span class="ocs-dash-title">Odoo Custom Dashboard</span><div class="ocs-dash-live"><span class="ocs-live-dot"></span>Live</div></div>
        <div class="ocs-dash-kpi-row">
          <div class="ocs-kpi-card ocs-kpi-blue"><div class="ocs-kpi-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div><div><div class="ocs-kpi-val">+38%</div><div class="ocs-kpi-lbl">Efficiency</div></div></div>
          <div class="ocs-kpi-card ocs-kpi-green"><div class="ocs-kpi-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg></div><div><div class="ocs-kpi-val">$1.2M</div><div class="ocs-kpi-lbl">Revenue</div></div></div>
          <div class="ocs-kpi-card ocs-kpi-purple"><div class="ocs-kpi-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div><div class="ocs-kpi-val">-60%</div><div class="ocs-kpi-lbl">Manual Work</div></div></div>
        </div>
        <div class="ocs-workflow-row">
          <div class="ocs-flow-step ocs-flow-active"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"/></svg>Order</div>
          <span class="ocs-flow-arrow">&#8594;</span>
          <div class="ocs-flow-step"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/></svg>Inventory</div>
