<style>
.ocs-root{--op:#1265f3;--opd:#0b4fd4;--oc:#1fb6ff;--oi:#071a3d;--om:#5b6b82;--ol:#dce8f7;--os:#0bbf8a;--opp:#fff;--osf:#f5f9ff;--osb:#eaf3ff;--or:18px;--osh:0 8px 32px rgba(18,101,243,.10);--oshl:0 24px 60px rgba(7,26,61,.12);font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:var(--oi);background:var(--opp);overflow-x:hidden}
.ocs-container{max-width:1180px;margin:0 auto;padding:0 24px}
.ocs-section{padding:100px 0}
.ocs-soft-bg{background:#f5f9ff}
.ocs-why-bg{background:linear-gradient(180deg,#f5f9ff 0%,#fff 100%)}
.ocs-section-header{text-align:center;max-width:720px;margin:0 auto 60px}
.ocs-slabel{display:inline-block;background:var(--osb);color:var(--op);font-size:.78rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:6px 16px;border-radius:100px;border:1px solid rgba(18,101,243,.18);margin-bottom:18px}
.ocs-section-header h2{font-size:clamp(1.9rem,4vw,2.8rem);font-weight:800;color:var(--oi);line-height:1.15;margin-bottom:18px}
.ocs-section-header p{font-size:1.05rem;color:var(--om);line-height:1.7}
.ocs-fade-up{animation:ocsFU .9s cubic-bezier(.23,1,.32,1) both}
.ocs-fade-up-delay{animation:ocsFU .9s cubic-bezier(.23,1,.32,1) .2s both}
@keyframes ocsFU{from{opacity:0;transform:translateY(36px)}to{opacity:1;transform:translateY(0)}}
.ocs-reveal{opacity:0;transform:translateY(28px);transition:opacity .65s ease,transform .65s ease}
.ocs-reveal.ocs-visible{opacity:1;transform:translateY(0)}
.ocs-back-top{position:fixed;bottom:32px;right:32px;z-index:999;width:46px;height:46px;background:var(--op);color:#fff;border:none;border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 6px 24px rgba(18,101,243,.35);opacity:0;visibility:hidden;transform:translateY(12px);transition:all .3s}
.ocs-back-top.ocs-show{opacity:1;visibility:visible;transform:translateY(0)}
.ocs-back-top:hover{background:var(--opd);transform:translateY(-2px)}
.ocs-btn{display:inline-flex;align-items:center;gap:8px;padding:14px 28px;border-radius:12px;font-size:.97rem;font-weight:600;border:none;cursor:pointer;transition:all .22s ease;text-decoration:none;white-space:nowrap}
.ocs-btn-primary{background:var(--op);color:#fff;box-shadow:0 4px 18px rgba(18,101,243,.32)}
.ocs-btn-primary:hover{background:var(--opd);transform:translateY(-2px);box-shadow:0 8px 28px rgba(18,101,243,.38)}
.ocs-btn-outline{background:transparent;color:var(--op);border:1.5px solid var(--op)}
.ocs-btn-outline:hover{background:var(--osb);transform:translateY(-2px)}
.ocs-btn-white{background:#fff;color:var(--op);box-shadow:0 4px 18px rgba(0,0,0,.12)}
.ocs-btn-white:hover{background:var(--osb);transform:translateY(-2px)}
.ocs-btn-ghost{background:rgba(255,255,255,.12);color:#fff;border:1.5px solid rgba(255,255,255,.35);backdrop-filter:blur(8px)}
.ocs-btn-ghost:hover{background:rgba(255,255,255,.2);transform:translateY(-2px)}
.ocs-btn-full{width:100%;justify-content:center}
.ocs-hero{position:relative;padding:130px 0 100px;overflow:hidden;background:linear-gradient(170deg,#f5f9ff 0%,#eaf3ff 50%,#fff 100%)}
.ocs-hero-bg{position:absolute;inset:0;pointer-events:none}
.ocs-orb{position:absolute;border-radius:50%;filter:blur(80px);opacity:.5}
.ocs-orb-1{width:560px;height:560px;background:radial-gradient(circle,rgba(18,101,243,.18) 0%,transparent 70%);top:-180px;right:-120px}
.ocs-orb-2{width:380px;height:380px;background:radial-gradient(circle,rgba(31,182,255,.15) 0%,transparent 70%);bottom:-60px;left:-80px}
.ocs-hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(18,101,243,.04) 1px,transparent 1px),linear-gradient(90deg,rgba(18,101,243,.04) 1px,transparent 1px);background-size:40px 40px}
.ocs-hero-inner{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;position:relative;z-index:1}
.ocs-badge{display:inline-flex;align-items:center;gap:8px;background:rgba(18,101,243,.07);border:1px solid rgba(18,101,243,.2);color:var(--op);font-size:.82rem;font-weight:600;padding:7px 16px;border-radius:100px;margin-bottom:24px}
.ocs-badge-dot{width:8px;height:8px;background:var(--op);border-radius:50%;animation:ocsPulse 2s infinite}
@keyframes ocsPulse{0%,100%{box-shadow:0 0 0 0 rgba(18,101,243,.4)}50%{box-shadow:0 0 0 6px rgba(18,101,243,0)}}
.ocs-hero-title{font-size:clamp(2.2rem,5vw,3.4rem);font-weight:900;color:var(--oi);line-height:1.08;margin-bottom:24px;display:block}
.ocs-gradient-text{display:block;background:linear-gradient(135deg,var(--op) 0%,var(--oc) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.ocs-hero-desc{font-size:1.08rem;color:var(--om);line-height:1.75;margin-bottom:36px;max-width:520px}
.ocs-hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:32px}
.ocs-hero-trust{display:flex;align-items:center;gap:12px;font-size:.88rem;color:var(--om);flex-wrap:wrap}
.ocs-stars{color:#f59e0b;font-size:.95rem}
.ocs-sep{color:var(--ol);font-weight:700}
.ocs-hero-visual{position:relative}
.ocs-dashboard-card{background:#fff;border-radius:20px;padding:24px;box-shadow:0 20px 60px rgba(7,26,61,.12),0 0 0 1px rgba(18,101,243,.08)}
.ocs-dash-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px}
.ocs-dash-dots{display:flex;gap:6px}
.ocs-dash-dots span{width:10px;height:10px;border-radius:50%}
.ocs-dash-dots span:nth-child(1){background:#ef4444}
.ocs-dash-dots span:nth-child(2){background:#f59e0b}
.ocs-dash-dots span:nth-child(3){background:#0bbf8a}
.ocs-dash-title{font-size:.82rem;font-weight:600;color:var(--om)}
.ocs-dash-live{display:flex;align-items:center;gap:5px;font-size:.75rem;font-weight:700;color:var(--os)}
.ocs-live-dot{width:7px;height:7px;background:var(--os);border-radius:50%;animation:ocsBlink 1.5s infinite}
@keyframes ocsBlink{0%,100%{opacity:1}50%{opacity:.3}}
.ocs-dash-kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.ocs-kpi-card{border-radius:12px;padding:12px;display:flex;align-items:center;gap:10px}
.ocs-kpi-blue{background:rgba(18,101,243,.07)}
.ocs-kpi-green{background:rgba(11,191,138,.08)}
.ocs-kpi-purple{background:rgba(124,58,237,.07)}
.ocs-kpi-icon{width:32px;height:32px;display:flex;align-items:center;justify-content:center;border-radius:8px;background:rgba(255,255,255,.8);flex-shrink:0}
.ocs-kpi-blue .ocs-kpi-icon{color:var(--op)}
.ocs-kpi-green .ocs-kpi-icon{color:var(--os)}
.ocs-kpi-purple .ocs-kpi-icon{color:#7c3aed}
