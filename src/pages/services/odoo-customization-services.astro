<script>
document.addEventListener('DOMContentLoaded', () => {
  const revealEls = document.querySelectorAll('.ocs-reveal');
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) {
        const all = Array.from(revealEls);
        const idx = all.indexOf(e.target as HTMLElement);
        const delay = (idx % 4) * 80;
        setTimeout(() => (e.target as HTMLElement).classList.add('ocs-visible'), delay);
        revealObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => revealObs.observe(el));

  const counters = document.querySelectorAll('.ocs-counter');
  const counterObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target as HTMLElement;
        const target = parseInt(el.dataset.target || '0', 10);
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / 1800, 1);
          const ease = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.floor(ease * target).toString();
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
        counterObs.unobserve(el);
      }
    });
  }, { threshold: 0.5 });
  counters.forEach(c => counterObs.observe(c));

  const backTop = document.getElementById('ocsBackTop');
  window.addEventListener('scroll', () => { backTop?.classList.toggle('ocs-show', window.scrollY > 400); }, { passive: true });
  backTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

  const modal = document.getElementById('ocsModal');
  const modalClose = document.getElementById('ocsModalClose');
  const openModal = () => { modal?.removeAttribute('hidden'); document.body.style.overflow = 'hidden'; };
  const closeModal = () => { modal?.setAttribute('hidden', ''); document.body.style.overflow = ''; };
  document.querySelectorAll('.js-open-ocs-modal').forEach(btn => btn.addEventListener('click', openModal));
  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  const form = document.getElementById('ocsModalForm') as HTMLFormElement | null;
  const formStatus = document.getElementById('ocsFormStatus');
  const submitBtn = document.getElementById('ocsSubmitBtn');
  const submitLabel = document.getElementById('ocsSubmitLabel');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !submitLabel || !formStatus) return;
    submitLabel.textContent = 'Sending...';
    submitBtn.setAttribute('disabled', 'true');
    formStatus.className = 'ocs-form-status';
    const data = new FormData(form);
    const payload = {
      name: data.get('name')?.toString() || '',
      email: data.get('email')?.toString() || '',
      phone: data.get('phone')?.toString() || '',
      companyName: data.get('company')?.toString() || 'N/A',
      message: 'Service: ' + (data.get('service') || 'N/A') + ' | ' + (data.get('message') || ''),
      sourcePage: 'Odoo Customization Services Page (/services/odoo-customization-services/)'
    };
    try {
      const res = await fetch('/api/leads', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (res.ok) {
        formStatus.textContent = 'Your enquiry has been sent! We will be in touch within 4 hours.';
        formStatus.className = 'ocs-form-status ocs-success';
        form.reset();
        setTimeout(closeModal, 3000);
      } else { throw new Error(); }
    } catch {
      formStatus.textContent = 'Something went wrong. Please try again or email us directly.';
      formStatus.className = 'ocs-form-status ocs-error';
    } finally {
      submitLabel.textContent = 'Send My Enquiry';
      submitBtn.removeAttribute('disabled');
    }
  });

  const track = document.getElementById('ocsTestiTrack');
  const tdots = document.querySelectorAll('.ocs-tdot');
  const prevBtn = document.getElementById('ocsTestiPrev');
  const nextBtn = document.getElementById('ocsTestiNext');
  let cur = 0;
  const tot = document.querySelectorAll('.ocs-tcard').length;
  const goTo = (idx: number) => {
    cur = (idx + tot) % tot;
    if (track) (track as HTMLElement).style.transform = 'translateX(-' + (cur * 100) + '%)';
    tdots.forEach((d, i) => d.classList.toggle('ocs-tdot-active', i === cur));
  };
  prevBtn?.addEventListener('click', () => goTo(cur - 1));
  nextBtn?.addEventListener('click', () => goTo(cur + 1));
  tdots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));
  let ap = setInterval(() => goTo(cur + 1), 5500);
  document.getElementById('ocsTestiSlider')?.addEventListener('mouseenter', () => clearInterval(ap));
  document.getElementById('ocsTestiSlider')?.addEventListener('mouseleave', () => { ap = setInterval(() => goTo(cur + 1), 5500); });

  document.querySelectorAll('.ocs-faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.ocs-faq-q').forEach(b => b.setAttribute('aria-expanded', 'false'));
      document.querySelectorAll('.ocs-faq-a').forEach(a => { a.classList.remove('ocs-faq-open'); a.setAttribute('aria-hidden', 'true'); });
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        const answerId = btn.getAttribute('aria-controls');
        const answer = answerId ? document.getElementById(answerId) : null;
        if (answer) { answer.classList.add('ocs-faq-open'); answer.setAttribute('aria-hidden', 'false'); }
      }
    });
  });
});
</script>

</Layout>
