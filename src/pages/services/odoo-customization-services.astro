        <button class="ocs-btn ocs-btn-primary js-open-ocs-modal" id="heroCtaPrimary"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Get Free Consultation</button>
