                <path d="M 100 80 Q 200 120 280 200" stroke="#0b55d9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 4" />
                <path d="M 90 220 Q 180 240 260 270" stroke="#0b55d9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 4" />
                <path d="M 110 360 Q 200 340 270 320" stroke="#0b55d9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 4" />
                <path d="M 120 490 Q 220 440 300 380" stroke="#0b55d9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 4" />
                
                <path d="M 700 80 Q 600 120 520 200" stroke="#0b55d9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 4" />
                <path d="M 710 220 Q 620 240 540 270" stroke="#0b55d9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 4" />
                <path d="M 690 360 Q 600 340 530 320" stroke="#0b55d9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 4" />
                <path d="M 680 490 Q 580 440 500 380" stroke="#0b55d9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="4 4" />
