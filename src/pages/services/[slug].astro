---
import Layout from "../../layouts/Layout.astro";
import { servicePages } from "../../data/catalog";

export const prerender = true;

export function getStaticPaths() {
  return servicePages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const isOdooImplementation = page.slug === "odoo-implementation-services";
const isOdooMigration = page.slug === "odoo-migration-services";

const serviceName = page.title.replace(" Services", "");
const shortCode = serviceName
  .split(/\s+/)
  .map((word) => word.replace(/[^A-Za-z0-9]/g, "").slice(0, 1))
  .join("")
  .slice(0, 4)
  .toUpperCase();

const relatedServices = servicePages.filter((item) => item.slug !== page.slug).slice(0, 3);

const odooImplementationFaq = [
  {
    title: "What is included in Odoo implementation services?",
    text: "Hegrix covers business process discovery, module selection, Odoo configuration, workflow setup, data migration, integrations, testing, user training and launch support.",
  },
  {
    title: "Can Odoo be customized for my business workflows?",
    text: "Yes. Hegrix can customize Odoo modules, forms, approvals, dashboards, reports and integrations around your exact sales, inventory, finance, manufacturing or service workflow.",
  },
  {
    title: "How long does an Odoo implementation take?",
    text: "Timeline depends on modules, data quality, integrations and workflow complexity. A focused implementation can start in weeks, while larger ERP rollouts need phased planning.",
  },
  {
    title: "Do you provide support after Odoo goes live?",
    text: "Yes. Hegrix provides post-launch support, bug fixes, optimization, user help, performance tuning and continuous improvement after go-live.",
  },
];

const odooMigrationFaq = [
  {
    title: "How long does Odoo migration take?",
    text: "Most Odoo migrations take between 2 to 4 weeks depending on database size, version gap, and custom module complexity.",
  },
  {
    title: "Will my data be safe during migration?",
    text: "Yes. We execute a zero data loss strategy with complete database backups, staging trial runs, and automated record verification scripts.",
  },
  {
    title: "Can you migrate custom modules?",
    text: "Yes. Our certified Python developers refactor custom Odoo apps, views, models, and workflows to ensure 100% compatibility with the latest Odoo version.",
  },
  {
    title: "Can you migrate from Community to Enterprise?",
    text: "Yes. We upgrade Odoo Community databases to Odoo Enterprise seamlessly, unlocking advanced accounting, barcode, and mobile capabilities.",
  },
  {
    title: "Do you support older Odoo versions?",
    text: "Yes. We support migration from legacy versions including Odoo 10, 11, 12, 13, 14, 15, 16, and 17 to Odoo 18.",
  },
  {
    title: "Do you provide support after migration?",
    text: "Yes. We provide 24/7 post-launch hypercare, system monitoring, performance tuning, user training, and ongoing technical support.",
  },
];

const odooImplementationSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Odoo Implementation Services",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com",
    },
    areaServed: "Global",
    serviceType: "Odoo ERP implementation, configuration, migration and support",
    description:
      "Professional Odoo implementation services for ERP setup, module configuration, workflow automation, data migration, integrations, training and launch support.",
    url: "https://hegrix.com/services/odoo-implementation-services/",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: odooImplementationFaq.map((item) => ({
      "@type": "Question",
      name: item.title,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.text,
      },
    })),
  },
];

const odooMigrationSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Odoo Migration Services",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com",
    },
    areaServed: "Global",
    serviceType: "Odoo version upgrade, database migration, cloud migration, and module compatibility",
    description:
      "Enterprise Odoo migration services to upgrade your Odoo ERP to the latest version with zero data loss, custom module compatibility, and minimal downtime.",
    url: "https://hegrix.com/services/odoo-migration-services/",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: odooMigrationFaq.map((item) => ({
      "@type": "Question",
      name: item.title,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.text,
      },
    })),
  },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: page.title,
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com",
    },
    areaServed: "Global",
    serviceType: page.title,
    description: page.description,
    url: `https://hegrix.com/services/${page.slug}/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: `What is included in ${page.title}?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: `Hegrix supports strategy, UX planning, implementation, integrations, testing, launch and continuous improvement for ${page.title}.`,
        },
      },
      {
        "@type": "Question",
        name: `Can Hegrix customize ${page.title} around my business?`,
        acceptedAnswer: {
          "@type": "Answer",
          text: "Yes. Hegrix maps your workflows, users, data and growth goals before designing a custom implementation plan.",
        },
      },
    ],
  },
];
---

{isOdooImplementation ? (
  <Layout
    title="Odoo Implementation Services | Odoo ERP Setup, Migration & Support | Hegrix"
    description="Professional Odoo implementation services for ERP setup, module configuration, workflow automation, data migration, integrations, training and launch support."
    keywords="Odoo implementation services, Odoo ERP implementation, Odoo setup, Odoo migration, Odoo customization, Odoo consultant"
    path="/services/odoo-implementation-services/"
    schema={odooImplementationSchema}
  >
    <div class="odoo-landing-wrapper">
      {/* Main Hero Section */}
      <section class="odoo-hero-section">
        {/* Background Effects */}
        <div class="odoo-bg-glow odoo-bg-glow--top-left" aria-hidden="true"></div>
        <div class="odoo-bg-glow odoo-bg-glow--top-right" aria-hidden="true"></div>
        <div class="odoo-bg-dots" aria-hidden="true"></div>

        <div class="container odoo-hero-container">
          <div class="odoo-hero-grid">
            
            {/* Left Marketing Column */}
            <div class="odoo-hero-content">
