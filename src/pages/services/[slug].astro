                                <span class="kpi-trend positive">99.2%</span>
                              </div>
                              <div class="kpi-value">8,640 units</div>
                              <div class="kpi-sub">12 active work orders</div>
                            </div>
                          </div>

                          {/* Charts Grid */}
                          <div class="odoo-charts-grid">
                            <div class="odoo-chart-panel">
                              <div class="panel-header">
                                <div>
                                  <h4>Revenue & Growth Analytics</h4>
                                  <span class="panel-subtitle">Real-time Odoo ERP metrics</span>
                                </div>
                                <div class="chart-legend">
                                  <span class="legend-item"><i class="dot dot-blue"></i> Revenue</span>
                                  <span class="legend-item"><i class="dot dot-cyan"></i> Profit</span>
                                </div>
                              </div>
                              <div class="svg-chart-container">
                                <svg viewBox="0 0 400 130" fill="none" class="revenue-chart-svg">
                                  <defs>
                                    <linearGradient id="blueGradient" x1="0" y1="0" x2="0" y2="1">
                                      <stop offset="0%" stop-color="#0b55d9" stop-opacity="0.35"/>
                                      <stop offset="100%" stop-color="#0b55d9" stop-opacity="0.0"/>
                                    </linearGradient>
                                    <linearGradient id="cyanGradient" x1="0" y1="0" x2="0" y2="1">
                                      <stop offset="0%" stop-color="#1fb6ff" stop-opacity="0.25"/>
