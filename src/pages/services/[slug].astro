            <div class="cta-buttons">
              <a href="/contact-us/" class="odoo-btn-primary button-cta-white">Book Free Consultation</a>
              <a href="/contact-us/" class="odoo-btn-secondary button-cta-outline">Talk to Our Experts</a>
            </div>
          </div>
        </div>
      </section>

      {/* CONTACT FORM */}
      <section class="odoo-section odoo-contact-form-section">
        <div class="container">
          <div class="odoo-form-wrapper">
            <div class="form-header text-center">
              <p class="odoo-section-eyebrow">Get Assessment</p>
              <h2>Get Your Free Odoo Migration Assessment</h2>
              <p>Fill out the form below to receive a custom migration roadmap and estimate from our certified specialists.</p>
            </div>
            <form class="odoo-lead-form" action="/api/leads/" method="POST">
              <div class="form-grid">
                <div class="form-group">
                  <label for="m-name">Full Name *</label>
                  <input type="text" id="m-name" name="name" required placeholder="John Doe" />
                </div>
                <div class="form-group">
                  <label for="m-email">Business Email *</label>
                  <input type="email" id="m-email" name="email" required placeholder="john@company.com" />
                </div>
                <div class="form-group">
                  <label for="m-phone">Phone Number</label>
                  <input type="tel" id="m-phone" name="phone" placeholder="+1 (555) 000-0000" />
                </div>
                <div class="form-group">
                  <label for="m-company">Company</label>
                  <input type="text" id="m-company" name="company" placeholder="Acme Corporation" />
                </div>
                <div class="form-group">
                  <label for="m-current">Current Odoo Version</label>
                  <select id="m-current" name="current_version">
                    <option value="">Select Current Version</option>
                    <option value="Odoo 17">Odoo 17</option>
                    <option value="Odoo 16">Odoo 16</option>
                    <option value="Odoo 15">Odoo 15</option>
                    <option value="Odoo 14">Odoo 14</option>
                    <option value="Odoo 13">Odoo 13</option>
                    <option value="Odoo 12 or older">Odoo 12 or older</option>
                    <option value="Community Edition">Community Edition</option>
                  </select>
                </div>
                <div class="form-group">
                  <label for="m-target">Target Version</label>
                  <select id="m-target" name="target_version">
                    <option value="Odoo 18 Enterprise">Odoo 18 Enterprise (Recommended)</option>
                    <option value="Odoo 18 Community">Odoo 18 Community</option>
                    <option value="Odoo 17 Enterprise">Odoo 17 Enterprise</option>
                    <option value="Cloud Odoo.sh">Odoo.sh Cloud</option>
                  </select>
                </div>
                <div class="form-group full-width">
                  <label for="m-message">Project Requirements & Custom Modules</label>
                  <textarea id="m-message" name="message" rows="4" placeholder="Mention database size, custom modules, third-party integrations, or hosting requirements..."></textarea>
                </div>
              </div>
              <button type="submit" class="odoo-btn-primary form-submit-btn">Get Free Migration Consultation</button>
            </form>
          </div>
        </div>
      </section>
    </div>
  </Layout>
) : (
