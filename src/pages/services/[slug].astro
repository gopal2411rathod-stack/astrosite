                            <span>Analytics</span>
                          </div>
                        </aside>

                        {/* Content Area */}
                        <div class="odoo-dashboard-content">
                          {/* KPI Cards */}
                          <div class="odoo-kpi-grid">
                            <div class="odoo-kpi-card">
                              <div class="kpi-header">
                                <span>Total Revenue</span>
                                <span class="kpi-trend positive">+18.4%</span>
                              </div>
                              <div class="kpi-value">$2,485,900</div>
                              <div class="kpi-sub">vs last month</div>
                            </div>
                            <div class="odoo-kpi-card">
                              <div class="kpi-header">
                                <span>Sales Orders</span>
                                <span class="kpi-trend positive">+12.2%</span>
                              </div>
                              <div class="kpi-value">1,420</div>
                              <div class="kpi-sub">342 active shipments</div>
                            </div>
                            <div class="odoo-kpi-card">
                              <div class="kpi-header">
                                <span>Invoices Paid</span>
                                <span class="kpi-trend positive">98.5%</span>
                              </div>
                              <div class="kpi-value">$1,890,400</div>
                              <div class="kpi-sub">Avg payment: 4 days</div>
