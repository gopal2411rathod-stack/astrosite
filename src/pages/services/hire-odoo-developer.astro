        </div>
        <div class="hdev-stat">
          <span class="hdev-s-num">100+</span>
          <span class="hdev-s-lbl">Custom Modules Built</span>
        </div>
        <div class="hdev-stat">
          <span class="hdev-s-num">99.4%</span>
          <span class="hdev-s-lbl">Client Retention Rate</span>
        </div>
        <div class="hdev-stat">
          <span class="hdev-s-num">15+</span>
          <span class="hdev-s-lbl">Senior Odoo Developers</span>
        </div>
        <div class="hdev-stat">
          <span class="hdev-s-num">25+</span>
          <span class="hdev-s-lbl">Countries Served Globally</span>
        </div>
        <div class="hdev-stat">
          <span class="hdev-s-num">&lt; 15m</span>
          <span class="hdev-s-lbl">SLA Response Guarantee</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       3. WHY HIRE FROM HEGRIX (BENTO GRID)
  ═══════════════════════════════════════ -->
  <section class="hdev-sec hdev-sec-dark">
    <div class="container">
      <div class="hdev-sec-header">
        <span class="hdev-sec-eyebrow">Strategic Value</span>
        <h2>Why Businesses Hire Odoo Developers from Hegrix</h2>
        <p>Engineered around long-term performance, clean architecture, and transparent communication.</p>
      </div>

      <div class="hdev-bento-grid">
        <!-- Card 1 -->
        <div class="hdev-bento-card bento-large">
          <div class="hdev-bento-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
