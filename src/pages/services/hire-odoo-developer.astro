        </h1>

        <p class="hdev-hero-sub">
          Whether you need one developer or a dedicated team, our experienced Odoo professionals help you build, customize, integrate, and optimize ERP solutions that support long-term business growth.
        </p>

        <div class="hdev-hero-ctas">
          <button class="hdev-btn hdev-btn-primary js-open-hire-modal">
            <span>Hire an Odoo Developer</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <button class="hdev-btn hdev-btn-secondary js-open-hire-modal">
            <span>Schedule a Discovery Call</span>
          </button>
        </div>

        <div class="hdev-hero-social-proof">
          <div class="hdev-rating">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#00e676" stroke="#00e676"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#00e676" stroke="#00e676"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#00e676" stroke="#00e676"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#00e676" stroke="#00e676"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#00e676" stroke="#00e676"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <strong>4.98 / 5 Rating</strong>
          </div>
          <span class="hdev-dot-sep">•</span>
          <span>48-Hour Developer Onboarding</span>
        </div>
      </div>

      <!-- Right Interactive Developer Match Workstation Card -->
      <div class="hdev-hero-card-wrapper">
        <div class="hdev-match-card">
          <div class="hdev-card-top">
            <div class="hdev-status-indicator">
              <span class="hdev-live-dot"></span>
              <span>LIVE ODOO TALENT MATRIX</span>
            </div>
            <span class="hdev-v-tag">Odoo v17 / v18 OWL Ready</span>
          </div>

          <div class="hdev-dev-avatars">
            <div class="hdev-avatar-chip">
              <div class="hdev-av-circle av-1">PY</div>
              <div>
                <strong>Senior Python/Odoo Dev</strong>
                <small>8+ Yrs Exp • 40h/wk Available</small>
              </div>
            </div>
            <div class="hdev-avatar-chip">
              <div class="hdev-av-circle av-2">OWL</div>
              <div>
                <strong>OWL UI/UX Specialist</strong>
                <small>5+ Yrs Exp • Custom Dashboards</small>
              </div>
            </div>
          </div>

          <!-- Code Window -->
          <div class="hdev-mini-ide">
            <div class="hdev-ide-header">
              <span class="dot-red"></span>
              <span class="dot-yellow"></span>
              <span class="dot-green"></span>
              <small>custom_module.py</small>
            </div>
            <pre><code><span class="k">class</span> <span class="nc">DedicatedOdooSquad</span>(models.Model):
    _name = <span class="s">'hegrix.developer.squad'</span>
    
    dev_experience = fields.Char(default=<span class="s">'3 to 8+ Years'</span>)
    code_ownership = fields.Char(default=<span class="s">'100% IP Transferred'</span>)
    onboarding_speed = fields.Char(default=<span class="s">'Within 48 Hours'</span>)</code></pre>
          </div>

          <!-- Floating Badges -->
          <div class="hdev-card-footer-badges">
            <span>🔒 100% IP Code Transfer</span>
            <span>⚡ Risk-Free Trial</span>
            <span>🛡️ ISO 27001 Security</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       2. METRICS & TRUST STRIP
  ═══════════════════════════════════════ -->
