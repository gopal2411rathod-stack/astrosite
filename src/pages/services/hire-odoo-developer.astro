  </section>

  <!-- ═══════════════════════════════════════
       5. DEVELOPER PROFILES & EXPERTISE TIERS
  ═══════════════════════════════════════ -->
  <section class="hdev-sec hdev-sec-dark">
    <div class="container">
      <div class="hdev-sec-header">
        <span class="hdev-sec-eyebrow">Expertise Tiers</span>
        <h2>Select the Right Odoo Developer Profile for Your Project</h2>
        <p>Hire based on exact experience levels, technical skillsets, and complexity requirements.</p>
      </div>

      <div class="hdev-tiers-grid">
        <!-- Junior -->
        <div class="hdev-tier-card">
          <div class="hdev-tier-badge">Junior Tier</div>
