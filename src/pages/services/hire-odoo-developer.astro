---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const hireFaqList = [
  {
    question: "How quickly can a dedicated Odoo developer start on my project?",
    answer: "Our onboarding is fast. Once we understand your technical requirements, we present pre-vetted Odoo developer profiles within 24 hours. You can interview candidates and have your dedicated developer start work within 48 hours."
  },
  {
    question: "Can I interview and evaluate the Odoo developers before hiring?",
    answer: "Yes, absolutely. We encourage client interviews. You can conduct technical interviews, review past Odoo module portfolios, test coding skills, and evaluate communication before finalizing your developer."
  },
  {
    question: "Will the hired Odoo developer work in my local time zone?",
    answer: "Yes. Our developers offer flexible shift overlaps tailored to your time zone (US EST/PST, UK GMT, Europe CET, Australia AEST, or Asia). We ensure at least 4 to 8 hours of daily real-time work overlap."
  },
  {
    question: "Can your developers work on an existing, half-built, or legacy Odoo project?",
    answer: "Yes. Our senior Odoo engineers routinely audit, refactor, debug, and optimize pre-existing Odoo databases and custom modules, inheriting legacy codebases with zero operational disruption."
  },
  {
    question: "Can I scale my developer team up or down based on project demands?",
    answer: "Yes. Hegrix Technologies provides total scaling flexibility. You can add developers during major release sprints or downscale team size when transitioning into SLA maintenance mode."
  },
  {
    question: "Do you sign Non-Disclosure Agreements (NDAs) to protect our code and IP?",
    answer: "Yes. We sign strict enterprise NDAs and Intellectual Property (IP) assignment contracts before project kickoff. You retain 100% ownership of all custom Python source code, database scripts, and assets."
  },
  {
    question: "Which versions of Odoo do your developers support?",
    answer: "Our team supports all Odoo Enterprise and Community versions from Odoo v12 up to the latest Odoo v17 and v18, including modern OWL (Odoo Web Library) frontend and Python/PostgreSQL backends."
  },
  {
    question: "Do you provide post-launch support and technical maintenance?",
    answer: "Yes. We provide continuous 24/7 post-deployment SLA support, server monitoring, database backups, security patches, bug fixes, and feature enhancements to ensure uninterrupted ERP uptime."
  }
];

const hireSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hire Dedicated Odoo Developers | Hegrix Technologies",
    provider: {
      "@type": "Organization",
      name: "Hegrix Technologies",
      url: "https://hegrix.com"
    },
    areaServed: "Global",
    serviceType: "Hire Odoo Developers, Dedicated Odoo ERP Engineers, Odoo Customization & Integration Services",
    description: "Hire certified, dedicated Odoo developers from Hegrix Technologies. Custom Odoo module development, ERP integration, version migration, and 24/7 SLA maintenance.",
    url: "https://hegrix.com/services/hire-odoo-developer/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: hireFaqList.map(item => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://hegrix.com/"
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Services",
        item: "https://hegrix.com/services/"
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Hire Odoo Developer",
        item: "https://hegrix.com/services/hire-odoo-developer/"
      }
    ]
  }
];
---

<Layout
  title="Hire Odoo Developers | Dedicated Odoo ERP Experts | Hegrix"
  description="Hire certified dedicated Odoo developers from Hegrix Technologies. Expert Python, OWL & PostgreSQL developers for custom Odoo modules, ERP integration, migration & maintenance."
  keywords="Hire Odoo Developers, Dedicated Odoo Developers, Remote Odoo Developers, Odoo ERP Developers, Odoo Development Team, Hire Odoo Experts, Odoo Module Developers, Odoo Technical Consultants, Offshore Odoo Developers, Hire Python Odoo Engineer"
