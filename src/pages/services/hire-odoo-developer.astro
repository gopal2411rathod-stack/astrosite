          <label for="hdName">Full Name *</label>
          <input type="text" id="hdName" name="name" required placeholder="e.g. Michael Vance" />
        </div>

        <div class="hdev-field">
          <label for="hdEmail">Work Email *</label>
          <input type="email" id="hdEmail" name="email" required placeholder="michael@enterprise.com" />
        </div>

        <div class="hdev-field-row">
          <div class="hdev-field">
            <label for="hdPhone">Phone Number *</label>
            <input type="tel" id="hdPhone" name="phone" required placeholder="+1 (555) 000-0000" />
          </div>

          <div class="hdev-field">
            <label for="hdLevel">Developer Level / Hiring Model *</label>
            <select id="hdLevel" name="hiringModel" required>
              <option value="">Select Level...</option>
              <option value="Junior Odoo Developer">Junior Odoo Developer (1-3 yrs)</option>
              <option value="Mid-Level Odoo Developer">Mid-Level Odoo Developer (3-5 yrs)</option>
              <option value="Senior Odoo Developer">Senior Odoo Developer (6+ yrs)</option>
              <option value="Hourly Hiring">Hourly Hiring Model</option>
              <option value="Part-Time Dedicated">Part-Time Dedicated (20h/wk)</option>
              <option value="Full-Time Dedicated">Full-Time Dedicated (40h/wk)</option>
              <option value="Dedicated Team Squad">Dedicated Engineering Team Squad</option>
            </select>
          </div>
        </div>

        <div class="hdev-field">
          <label for="hdMsg">Project Requirements / Odoo Scope</label>
          <textarea id="hdMsg" name="message" rows="3" placeholder="Describe your Odoo modules, custom workflows, or team timeline..."></textarea>
        </div>

        <button type="submit" class="hdev-btn hdev-btn-primary hdev-btn-full" id="hdSubmitBtn">
          <span>Submit Request &amp; Get Candidate Profiles</span>
        </button>

        <p class="hdev-privacy">🔒 Your data is 100% confidential. Strict NDA protection guaranteed.</p>
