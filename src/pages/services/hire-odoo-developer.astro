<!-- ═══════════════════════════════════════
     CLIENT-SIDE SCRIPT
═══════════════════════════════════════ -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modalBackdrop = document.getElementById('hdHireModal');
    const closeBtn = document.getElementById('hdModalCloseBtn');
    const openBtns = document.querySelectorAll('.js-open-hire-modal');
    const modalForm = document.getElementById('hdModalForm') as HTMLFormElement | null;
    const levelSelect = document.getElementById('hdLevel') as HTMLSelectElement | null;
    const successMsg = document.getElementById('hdSuccessMsg');
    const closeSuccessBtn = document.getElementById('hdCloseSuccessBtn');

    // Open Modal
    openBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();

        const presetLevel = btn.getAttribute('data-level');
        const presetModel = btn.getAttribute('data-model');
        if (levelSelect && (presetLevel || presetModel)) {
          const targetValue = presetLevel || presetModel || '';
          for (let i = 0; i < levelSelect.options.length; i++) {
            if (levelSelect.options[i].value === targetValue) {
              levelSelect.selectedIndex = i;
              break;
            }
          }
        }

        if (modalBackdrop) {
          modalBackdrop.classList.add('is-open');
          modalBackdrop.setAttribute('aria-hidden', 'false');
        }
      });
    });

    const closeModal = () => {
      if (modalBackdrop) {
        modalBackdrop.classList.remove('is-open');
        modalBackdrop.setAttribute('aria-hidden', 'true');
      }
    };

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeSuccessBtn) closeSuccessBtn.addEventListener('click', closeModal);

    if (modalBackdrop) {
      modalBackdrop.addEventListener('click', (e) => {
        if (e.target === modalBackdrop) closeModal();
      });
    }

    // Handle Form Submit to /api/leads
    if (modalForm) {
      modalForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('hdSubmitBtn');
        const originalText = submitBtn ? submitBtn.innerHTML : '<span>Submit Request &amp; Get Candidate Profiles</span>';

        if (submitBtn) {
          submitBtn.innerHTML = '<span>Processing...</span>';
          (submitBtn as HTMLButtonElement).disabled = true;
        }

        const formData = new FormData(modalForm);
        const name = String(formData.get('name') || '').trim();
        const email = String(formData.get('email') || '').trim();
        const phone = String(formData.get('phone') || '').trim();
        const model = String(formData.get('hiringModel') || '').trim();
        const userMsg = String(formData.get('message') || '').trim();

        const messageCombined = model
          ? `[Hiring Level/Model: ${model}] ${userMsg}`.trim()
          : userMsg;

        const payload = {
          fullName: name,
          email: email,
          mobileNumber: phone,
          message: messageCombined,
          sourcePage: 'Hire Odoo Developers Page (/services/hire-odoo-developer/)',
        };

        try {
          const response = await fetch('/api/leads', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(payload),
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.message || 'Submission failed. Please check your inputs.');
          }

          modalForm.reset();
          modalForm.style.display = 'none';
          if (successMsg) successMsg.style.display = 'block';
        } catch (error) {
          alert(error instanceof Error ? error.message : 'Something went wrong. Please try again.');
        } finally {
          if (submitBtn) {
            submitBtn.innerHTML = originalText;
            (submitBtn as HTMLButtonElement).disabled = false;
          }
        }
      });
    }
  });
</script>
