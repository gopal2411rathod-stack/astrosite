  /* Modal Backdrop & Dialog */
  .od-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(7, 26, 61, 0.75);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
  }
  .od-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .od-modal-dialog {
    background: #ffffff;
    border-radius: 24px;
    max-width: 560px;
    width: 100%;
    padding: 36px;
    position: relative;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    transform: translateY(20px);
    transition: transform 0.25s ease;
  }
  .od-modal-backdrop.is-open .od-modal-dialog {
    transform: translateY(0);
  }

  .od-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.4rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: var(--muted, #5b6b82);
