                <div class="code-line indent">architecture: <span class="c-green">'CloudNativeMicroservices'</span>,</div>
                <div class="code-line indent">security: [<span class="c-green">'AES-256'</span>, <span class="c-green">'ZeroTrust'</span>, <span class="c-green">'SOC2'</span>],</div>
                <div class="code-line indent">scalability: <span class="c-green">'AutoScalingKubernetes'</span></div>
