                    <strong>Custom Frontend</strong>
                    <small>React / Next.js / Mobile</small>
                  </div>
                </div>

                <div class="arch-connector">
                  <span class="flow-line"></span>
                  <span class="flow-badge">gRPC / REST</span>
                </div>

                <div class="arch-node">
                  <div class="node-svg-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                  </div>
                  <div class="node-info">
                    <strong>Hegrix Core Engine</strong>
                    <small>Microservices & Logic</small>
                  </div>
                </div>

                <div class="arch-connector">
                  <span class="flow-line"></span>
                  <span class="flow-badge">Encrypted</span>
                </div>

                <div class="arch-node">
                  <div class="node-svg-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  </div>
                  <div class="node-info">
                    <strong>Cloud & AI Cluster</strong>
                    <small>PostgreSQL / AI Pipelines</small>
                  </div>
                </div>
              </div>

              <div class="csd-console-code">
                <div class="code-line"><span class="c-purple">import</span> &#123; <span class="c-blue">HegrixEngine</span> &#125; <span class="c-purple">from</span> <span class="c-green">'@hegrix/core'</span>;</div>
