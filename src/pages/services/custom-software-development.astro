<!-- INTERACTIVE SCRIPTS -->
<script>
  // Process Step Switcher
  const processContainer = document.getElementById('processInteractive');
  if (processContainer) {
    const tabs = processContainer.querySelectorAll('.csd-p-tab');
    const panels = processContainer.querySelectorAll('.csd-p-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const stepNum = tab.getAttribute('data-step');
        
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        tab.classList.add('active');
        const targetPanel = document.getElementById(`p-panel-${stepNum}`);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  }

  // Lead Modal Popup Handlers
  const modalBackdrop = document.querySelector('.js-lead-modal');
  const openLeadBtns = document.querySelectorAll('.js-open-lead-modal');
  const closeLeadBtns = document.querySelectorAll('.js-close-lead-modal');
  const leadForm = document.getElementById('csdLeadForm');
  const leadSuccess = document.getElementById('csdLeadSuccess');

  openLeadBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      if (modalBackdrop) {
        modalBackdrop.classList.add('is-open');
        modalBackdrop.setAttribute('aria-hidden', 'false');
      }
    });
  });

  closeLeadBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (modalBackdrop) {
        modalBackdrop.classList.remove('is-open');
        modalBackdrop.setAttribute('aria-hidden', 'true');
      }
    });
  });

  if (modalBackdrop) {
    modalBackdrop.addEventListener('click', (e) => {
      if (e.target === modalBackdrop) {
        modalBackdrop.classList.remove('is-open');
        modalBackdrop.setAttribute('aria-hidden', 'true');
      }
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modalBackdrop && modalBackdrop.classList.contains('is-open')) {
      modalBackdrop.classList.remove('is-open');
      modalBackdrop.setAttribute('aria-hidden', 'true');
    }
  });

  if (leadForm) {
    leadForm.addEventListener('submit', (e) => {
      e.preventDefault();
      leadForm.style.display = 'none';
      if (leadSuccess) {
        leadSuccess.style.display = 'block';
      }
    });
  }
</script>

