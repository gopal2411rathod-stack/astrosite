            <p>You own 100% of the IP and source code. Zero recurring per-user SaaS license fees holding back margins.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════
         4. SECTION 4 — CUSTOM SOFTWARE DEVELOPMENT SERVICES
    ═══════════════════════════════════════ -->
    <section id="services-list" class="csd-section csd-services-section soft-section">
      <div class="container">
        <div class="csd-section-head text-center">
