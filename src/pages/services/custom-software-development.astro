  }

  .csd-btn-lg {
    min-height: 58px;
    padding: 0 34px;
    font-size: 1.08rem;
  }

  .csd-btn-block {
    width: 100%;
    margin-top: 10px;
  }

  /* HEADINGS & TYPOGRAPHY */
  .csd-section {
    padding: 90px 0;
  }

  .csd-section-head {
    max-width: 820px;
    margin: 0 auto 50px;
  }

  .csd-eyebrow {
    display: inline-block;
    color: #2563eb;
    font-weight: 850;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .csd-h2 {
    font-size: clamp(2.1rem, 4vw, 3.1rem);
    color: #071a3d;
    font-weight: 900;
    line-height: 1.15;
  }

  .csd-lead {
    font-size: clamp(1.08rem, 1.8vw, 1.22rem);
    color: #475569;
    margin-top: 18px;
    line-height: 1.6;
  }

  .csd-gradient-text {
    background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 50%, #93c5fd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 1. HERO SECTION (POLISHED) */
  .csd-hero {
    position: relative;
    padding: 100px 0 84px;
    background: radial-gradient(circle at 80% 20%, rgba(37, 99, 235, 0.25), transparent 50%),
                linear-gradient(180deg, #05133b 0%, #071a3d 100%);
    color: #ffffff;
    overflow: hidden;
  }

  .csd-hero-ambient {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, rgba(31, 182, 255, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .csd-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }

  .csd-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(37, 99, 235, 0.2);
    border: 1px solid rgba(96, 165, 250, 0.3);
    color: #93c5fd;
    font-size: 0.8rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    margin-bottom: 24px;
  }

  .csd-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 10px #38bdf8;
  }

  .csd-hero-h1 {
    font-size: clamp(2.5rem, 4.6vw, 4rem);
    color: #ffffff;
    font-weight: 900;
    line-height: 1.1;
  }

  .csd-hero-lead {
    font-size: clamp(1.08rem, 1.8vw, 1.25rem);
    color: rgba(255, 255, 255, 0.88);
    margin-top: 22px;
    line-height: 1.6;
    max-width: 600px;
  }

  .csd-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
  }

  .csd-hero-trust-bar {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 20px;
    margin-top: 40px;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .csd-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    font-weight: 750;
  }

  /* Console Window Visual */
  .csd-hero-visual-card {
    position: relative;
  }

  .csd-console-window {
    background: #081736;
    border: 1px solid rgba(96, 165, 250, 0.28);
    border-radius: 20px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  .csd-console-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: #040e26;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .csd-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-r { background: #ef4444; }
  .dot-y { background: #f59e0b; }
  .dot-g { background: #10b981; }

  .csd-console-title {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #94a3b8;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .csd-console-status {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    color: #34d399;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 8px #34d399;
  }

  .csd-console-body {
    padding: 20px;
  }

  .csd-metrics-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 18px;
  }

  .csd-metric-box {
    background: rgba(15, 30, 60, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 10px 12px;
  }

  .metric-lbl {
    display: block;
    font-size: 0.7rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-val {
    display: block;
    font-size: 0.94rem;
    font-weight: 900;
    color: #ffffff;
    margin: 4px 0;
  }

  .metric-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    overflow: hidden;
  }

  .metric-fill {
    height: 100%;
    background: #3b82f6;
  }

  .metric-fill.green {
    background: #10b981;
  }

  .csd-architecture-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    background: rgba(4, 14, 38, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 14px;
    padding: 12px;
    margin-bottom: 16px;
  }

  .arch-node {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(30, 58, 110, 0.5);
    border: 1px solid rgba(96, 165, 250, 0.25);
    border-radius: 10px;
    padding: 8px;
  }

  .node-svg-icon {
    display: grid;
    place-items: center;
  }

  .node-info strong {
    display: block;
    font-size: 0.74rem;
    color: #ffffff;
  }

  .node-info small {
    display: block;
    font-size: 0.66rem;
    color: #94a3b8;
  }

  .arch-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .flow-line {
    width: 16px;
    height: 2px;
    background: linear-gradient(90deg, #3b82f6, #60a5fa);
  }

  .flow-badge {
    font-size: 0.6rem;
    color: #60a5fa;
    font-weight: 800;
  }

  .csd-console-code {
    background: #020817;
    border-radius: 10px;
    padding: 12px;
    font-family: monospace;
    font-size: 0.76rem;
    line-height: 1.55;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .c-purple { color: #c084fc; }
  .c-blue { color: #60a5fa; }
  .c-green { color: #4ade80; }
  .c-yellow { color: #fde047; }
  .indent { padding-left: 16px; }

  .csd-console-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #040e26;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 750;
  }

  /* 2. TRUST / STATS SECTION */
  .csd-trust-section {
    padding: 40px 0;
    background: #071a3d;
    border-bottom: 1px solid rgba(220, 232, 247, 0.15);
    color: #ffffff;
  }

  .csd-stats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    text-align: center;
  }

  .csd-stat-card {
    padding: 16px 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
  }

  .stat-num {
    display: block;
    font-size: clamp(1.7rem, 2.8vw, 2.3rem);
    font-weight: 900;
    color: #60a5fa;
    line-height: 1.1;
  }

  .stat-label {
    display: block;
    font-size: 0.86rem;
    font-weight: 800;
    color: #ffffff;
    margin-top: 4px;
  }

  .stat-sub {
    display: block;
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 2px;
  }

  .csd-logo-strip-title {
    text-align: center;
    font-size: 0.74rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    color: #94a3b8;
    margin: 32px 0 14px;
  }

  .csd-logo-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .csd-logo-pill {
    padding: 6px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.82rem;
    font-weight: 750;
    color: #e2e8f0;
  }

  /* 3. WHAT IS CUSTOM SOFTWARE (SVG ICONS) */
  .csd-benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .csd-benefit-card {
    background: #ffffff;
    border: 1px solid var(--csd-card-border);
    border-radius: 16px;
    padding: 26px 22px;
    box-shadow: 0 8px 24px rgba(8, 38, 92, 0.04);
    transition: all 0.22s ease;
  }

  .csd-benefit-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(8, 38, 92, 0.08);
    border-color: #2563eb;
  }

  .b-icon-box {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #eff6ff;
    color: #2563eb;
    margin-bottom: 16px;
  }

  .csd-benefit-card h3 {
    font-size: 1.08rem;
    color: #071a3d;
    font-weight: 850;
    margin-bottom: 8px;
  }

  .csd-benefit-card p {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.5;
  }

  /* 4. SERVICES GRID (SVG ICONS) */
  .csd-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }

  .csd-service-card {
    background: #ffffff;
    border: 1px solid var(--csd-card-border);
    border-radius: 18px;
    padding: 30px 26px;
    box-shadow: 0 10px 30px rgba(8, 38, 92, 0.05);
    transition: all 0.22s ease;
    display: flex;
    flex-direction: column;
  }

  .csd-service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 44px rgba(8, 38, 92, 0.09);
    border-color: #2563eb;
  }

  .s-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .s-icon-box {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: #eff6ff;
    color: #2563eb;
  }

  .s-card-tag {
    padding: 4px 10px;
    border-radius: 999px;
    background: #f1f5f9;
    color: #475569;
    font-size: 0.74rem;
    font-weight: 800;
  }

  .csd-service-card h3 {
    font-size: 1.2rem;
    color: #071a3d;
    font-weight: 850;
    margin-bottom: 10px;
  }

  .csd-service-card p {
    font-size: 0.92rem;
    color: #475569;
    line-height: 1.55;
    margin-bottom: 18px;
    flex: 1;
  }

  .s-bullet-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid #f1f5f9;
    padding-top: 14px;
  }

  .s-bullet-list li {
    position: relative;
    padding-left: 18px;
    font-size: 0.84rem;
    color: #334155;
    font-weight: 750;
    margin-bottom: 6px;
  }

  .s-bullet-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #2563eb;
    font-weight: 900;
  }

  /* 5. TYPES MATRIX (SVG ICONS) */
  .csd-types-matrix {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .type-box {
    background: #ffffff;
    border: 1px solid var(--csd-card-border);
    border-radius: 16px;
    padding: 24px;
    transition: all 0.2s ease;
  }

  .type-box:hover {
    border-color: #2563eb;
    box-shadow: 0 14px 32px rgba(8, 38, 92, 0.07);
  }

  .t-icon-svg {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: #eff6ff;
    color: #2563eb;
    margin-bottom: 12px;
  }

  .type-box h4 {
    font-size: 1.08rem;
    color: #071a3d;
    font-weight: 850;
    margin-bottom: 6px;
  }

  .type-box p {
    font-size: 0.88rem;
    color: #475569;
    line-height: 1.5;
  }

  /* 6. PROCESS INTERACTIVE */
  .csd-process-nav {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 10px;
    margin-bottom: 28px;
    border-bottom: 2px solid #e2e8f0;
  }

  .csd-p-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 0;
    background: transparent;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 800;
    font-size: 0.9rem;
    color: #64748b;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .csd-p-tab:hover {
    color: #2563eb;
    background: #eff6ff;
  }

  .csd-p-tab.active {
    color: #ffffff;
    background: #2563eb;
    box-shadow: 0 6px 18px rgba(37, 99, 235, 0.25);
  }

  .p-num {
    font-size: 0.78rem;
    opacity: 0.8;
  }

  .csd-process-content-wrapper {
    position: relative;
  }

  .csd-p-panel {
    display: none;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 32px;
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--csd-card-border);
    border-radius: 20px;
    padding: 36px;
    box-shadow: 0 14px 36px rgba(8, 38, 92, 0.05);
  }

  .csd-p-panel.active {
    display: grid;
    animation: fadeIn 0.3s ease;
  }

  .p-step-badge {
    display: inline-block;
    color: #2563eb;
    font-size: 0.8rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  .p-panel-left h3 {
    font-size: 1.5rem;
    color: #071a3d;
    font-weight: 900;
    margin-bottom: 12px;
  }

  .p-panel-left p {
    font-size: 1rem;
    color: #475569;
    line-height: 1.58;
    margin-bottom: 22px;
  }

  .p-outputs strong {
    display: block;
    font-size: 0.84rem;
    color: #071a3d;
    margin-bottom: 8px;
  }

  .p-outputs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .p-outputs span {
    padding: 5px 12px;
    border-radius: 8px;
    background: #f1f5f9;
    font-size: 0.82rem;
    font-weight: 750;
    color: #334155;
  }

  .p-stat-box {
    background: #071a3d;
    border-radius: 18px;
    padding: 32px 24px;
    color: #ffffff;
    text-align: center;
    box-shadow: 0 16px 36px rgba(7, 26, 61, 0.18);
  }

  .p-highlight {
    display: block;
    font-size: 1.5rem;
    font-weight: 900;
    color: #60a5fa;
    margin-bottom: 6px;
  }

  /* 7. TECH STACK (SVG ICONS) */
  .csd-tech-categories {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .csd-tech-cat {
    background: #ffffff;
    border: 1px solid var(--csd-card-border);
    border-radius: 16px;
    padding: 22px;
  }

  .cat-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .cat-svg-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: #eff6ff;
  }

  .cat-header h3 {
    font-size: 1.05rem;
    color: #071a3d;
    font-weight: 850;
  }

  .cat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .cat-tags span {
    padding: 5px 10px;
    border-radius: 6px;
    background: #f8fbff;
    border: 1px solid #dce8f7;
    font-size: 0.8rem;
    font-weight: 750;
    color: #334155;
  }

  /* 8. INDUSTRIES (SVG ICONS) */
  .csd-ind-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }

  .ind-card {
    background: #ffffff;
    border: 1px solid var(--csd-card-border);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 8px 24px rgba(8, 38, 92, 0.04);
  }

  .ind-svg-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #eff6ff;
    color: #2563eb;
    margin-bottom: 14px;
  }

  .ind-card h3 {
    font-size: 1.15rem;
    color: #071a3d;
    font-weight: 850;
    margin-bottom: 8px;
  }

  .ind-card p {
    font-size: 0.9rem;
    color: #475569;
    line-height: 1.5;
  }

  /* 9. WHY HEGRIX (SVG ICONS) */
  .csd-why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .why-card {
    background: #ffffff;
    border: 1px solid var(--csd-card-border);
    border-radius: 18px;
    padding: 26px;
    box-shadow: 0 10px 28px rgba(8, 38, 92, 0.04);
  }

  .w-svg-icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: #eff6ff;
    color: #2563eb;
    margin-bottom: 14px;
  }

  .why-card h3 {
    font-size: 1.15rem;
    color: #071a3d;
    font-weight: 850;
