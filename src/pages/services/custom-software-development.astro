---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const faqList = [
  {
    question: "What is custom software development?",
    answer: "Custom software development is designing, building, deploying, and maintaining software tailored specifically to meet your organization's unique processes, workflows, and goals—unlike off-the-shelf software designed for generic mass-market use."
  },
  {
    question: "How much does custom software development cost?",
    answer: "Costs depend on project scope, architectural complexity, and technical depth. A focused MVP or web app ranges from $15k to $45k, while complex enterprise platforms range from $50k to $150k+. Hegrix provides transparent, fixed proposals or squad pricing."
  },
  {
    question: "How long does custom software development take?",
    answer: "Targeted workflow apps take 6 to 10 weeks, while comprehensive enterprise platforms take 3 to 6 months. Hegrix uses agile 2-week release cycles so you see working builds from month one."
  },
  {
    question: "Why choose custom software instead of SaaS?",
    answer: "Custom software provides 100% IP ownership, total operational control, zero recurring per-user SaaS fees, flawless API integration, and unconstrained scalability tailored to your precise business needs."
  },
  {
    question: "Can Hegrix integrate custom software with existing systems?",
    answer: "Yes. We build custom API connectors for ERPs (Odoo, SAP, NetSuite), CRMs (Salesforce, HubSpot), legacy databases, payment gateways, and third-party SaaS tools without operational disruption."
  },
  {
    question: "Can you modernize legacy software?",
    answer: "Yes. We refactor monolithic codebases into cloud-native microservices, migrate legacy databases, rewrite outdated frontends, and implement modern security standards while preserving business data."
  },
  {
    question: "Can you add AI to existing software?",
    answer: "Yes. Hegrix embeds AI capabilities like natural language search, automated document processing, predictive analytics, and intelligent routing bots directly into existing web applications via APIs."
  },
  {
    question: "Do you provide software maintenance and support?",
    answer: "Yes. We offer 24/7 post-deployment SLA support, infrastructure monitoring, security updates, database tuning, and feature upgrades to ensure continuous uptime and performance."
  }
];

const schemaData = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Custom Software Development Services | Hegrix",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com"
    },
    areaServed: "Global",
    serviceType: "Custom Software Development, Enterprise Software Engineering, SaaS Product Development, Legacy Modernization",
    description: "Build scalable, secure, and intelligent custom software tailored to your workflows, customers, and business goals with Hegrix.",
    url: "https://hegrix.com/services/custom-software-development/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqList.map(item => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title="Custom Software Development Services | Hegrix"
  description="Build scalable, secure, and intelligent custom software tailored to your workflows, customers, and long-term goals. Enterprise engineering partner."
  keywords="custom software development, custom software development services, custom software development company, enterprise software development, custom application development, software development services, business software development, AI software development"
  path="/services/custom-software-development/"
  schema={schemaData}
>
  <div class="csd-wrapper">
    <!-- ═══════════════════════════════════════
         1. HERO SECTION (POLISHED & HIGH-IMPACT)
    ═══════════════════════════════════════ -->
