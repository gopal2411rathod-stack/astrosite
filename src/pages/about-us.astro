---
import Layout from "../layouts/Layout.astro";

const stats = [
  { number: "500+", label: "Projects Delivered", icon: "🚀" },
  { number: "200+", label: "Global Enterprise Clients", icon: "🤝" },
  { number: "98%", label: "Client SLA Retention", icon: "⭐" },
  { number: "15+", label: "Countries Served", icon: "🌍" },
  { number: "10+", label: "Years Engineering Experience", icon: "🏆" },
];

const timeline = [
  {
    year: "2014",
    title: "Company Founded",
    desc: "Established with a mission to build clean, high-performance web applications and custom software for scaling enterprises.",
    color: "#7c3aed",
  },
  {
    year: "2017",
    title: "ERP & Odoo Expansion",
    desc: "Expanded team with certified Python and Odoo architects, launching full enterprise system capabilities across industries.",
    color: "#0b55d9",
  },
  {
    year: "2020",
    title: "Cloud & DevOps Division",
    desc: "Introduced enterprise cloud infrastructure, continuous deployment pipelines, and 24/7 SLA monitoring on AWS & Azure.",
    color: "#0891b2",
  },
  {
    year: "2023",
    title: "AI Automation & Integration",
    desc: "Integrated AI workflows, predictive analytics, document automation, and multi-vendor commerce engines.",
    color: "#059669",
  },
  {
    year: "2026",
    title: "Global Enterprise Leader",
    desc: "500+ successful deployments across North America, Europe, Middle East, and APAC — trusted by 200+ clients worldwide.",
    color: "#d97706",
  },
];

const values = [
  {
    iconType: "transparency",
    title: "Radical Transparency",
    desc: "Clear roadmaps, open communication, and real-time sprint tracking with no hidden technical debt.",
    color: "#7c3aed",
  },
  {
    iconType: "craftsmanship",
    title: "Senior Engineering Craftsmanship",
    desc: "Built by experienced architects using clean architecture, rigorous testing, and resilient security standards.",
    color: "#0b55d9",
  },
  {
    iconType: "outcome",
    title: "Business Outcome Driven",
    desc: "Every feature, API, and database model is engineered around measurable revenue growth and operational efficiency.",
    color: "#0891b2",
  },
  {
    iconType: "security",
    title: "Enterprise Reliability & Security",
    desc: "ISO-aligned processes, strict data governance, automated backups, and 99.9% uptime guarantees.",
    color: "#059669",
  },
  {
    iconType: "ai",
    title: "Continuous AI Innovation",
    desc: "Leveraging cutting-edge machine learning and process automation to give clients a decisive market edge.",
    color: "#d97706",
  },
  {
    iconType: "partnership",
    title: "Long-Term Strategic Partnership",
    desc: "We stay aligned with your growth through ongoing system optimization, hypercare support, and scaling advisory.",
    color: "#be185d",
  },
];

const team = [
  {
    initials: "AM",
    name: "Alex Morgan",
    role: "Founder & CEO",
    bio: "12+ years leading enterprise digital transformations and software product strategy across global markets.",
    linkedin: "https://www.linkedin.com/company/hegrix",
    color: "#7c3aed",
    expertise: ["Product Strategy", "Digital Transformation", "Enterprise Architecture"],
  },
  {
    initials: "SC",
    name: "Sophia Chen",
    role: "VP of Engineering & ERP",
    bio: "Certified Odoo architect and Python specialist with 10+ years scaling enterprise backbones for Fortune-500 clients.",
    linkedin: "https://www.linkedin.com/company/hegrix",
    color: "#0b55d9",
    expertise: ["Odoo ERP", "Python", "Enterprise Systems"],
  },
  {
    initials: "MV",
    name: "Marcus Vance",
    role: "Chief Cloud & AI Officer",
    bio: "AWS & Kubernetes certified cloud lead specializing in high-throughput microservices and AI automation pipelines.",
    linkedin: "https://www.linkedin.com/company/hegrix",
    color: "#0891b2",
    expertise: ["AWS", "Kubernetes", "AI/ML Pipelines"],
  },
  {
    initials: "ER",
    name: "Elena Rostova",
    role: "Head of Product & UX",
    bio: "Design leader obsessed with creating frictionless workflows for complex enterprise software management systems.",
    linkedin: "https://www.linkedin.com/company/hegrix",
    color: "#059669",
    expertise: ["UX Research", "Product Design", "Workflow Engineering"],
  },
];

const culturePillars = [
  {
    iconType: "growth",
    title: "Continuous Growth",
    desc: "We invest heavily in ongoing certifications, R&D in AI technologies, and technical mastery.",
    color: "#7c3aed",
  },
  {
    iconType: "global",
    title: "Global Collaboration",
    desc: "Remote-first mindset with engineering hubs operating across multiple time zones for seamless delivery.",
    color: "#0b55d9",
  },
  {
    iconType: "autonomy",
    title: "Engineering Autonomy",
    desc: "Empowered teams encouraged to explore modern frameworks, optimize algorithms, and solve hard problems.",
    color: "#0891b2",
  },
  {
    iconType: "pacing",
    title: "Sustainable Pacing",
    desc: "We prioritize deep focus work, clear sprint boundaries, and long-term team well-being over burn-out.",
    color: "#059669",
  },
];

const techWall = [
  { category: "ERP Systems", items: ["Odoo Certified", "SAP Integration", "Microsoft Dynamics"], icon: "⚙️", color: "#7c3aed" },
  { category: "Frontend Stack", items: ["React", "Next.js", "Astro", "Vue.js", "TypeScript"], icon: "🎨", color: "#0b55d9" },
  { category: "Backend Engineering", items: ["Python", "Node.js", "FastAPI", "Django", "PostgreSQL"], icon: "🔧", color: "#0891b2" },
  { category: "Cloud & DevOps", items: ["AWS", "Azure", "Docker", "Kubernetes", "CI/CD Pipelines"], icon: "☁️", color: "#059669" },
  { category: "AI & Automation", items: ["LLM Workflows", "Predictive Analytics", "Document OCR", "Python ML"], icon: "🤖", color: "#d97706" },
];

const testimonials = [
  {
    stars: 5,
    body: "Hegrix transformed our fragmented supply chain and manual accounting into a single unified Odoo ERP platform. Their technical depth and business clarity were second to none.",
    author: "David Miller",
    position: "CTO",
    company: "Apex Industrial Solutions",
    avatar: "DM",
    color: "#7c3aed",
    result: "40% efficiency boost",
  },
  {
    stars: 5,
    body: "Partnering with Hegrix allowed us to launch our multi-vendor marketplace 3 months ahead of schedule. Their senior engineers felt like a natural extension of our leadership team.",
    author: "Sarah Jenkins",
    position: "VP of Digital",
    company: "Zenith Commerce",
    avatar: "SJ",
    color: "#0b55d9",
    result: "3 months early delivery",
  },
  {
    stars: 5,
    body: "From custom cloud microservices to AI invoice processing, Hegrix has delivered exceptional reliability. Our operational overhead dropped by 35% in year one.",
    author: "Robert Taylor",
    position: "Head of IT",
    company: "Nexora Logistics Global",
    avatar: "RT",
    color: "#059669",
    result: "35% cost reduction",
  },
];

const faqs = [
  {
    q: "What types of companies does Hegrix partner with?",
    a: "We work with scaling mid-market enterprises, B2B/B2C commerce brands, industrial manufacturers, logistics providers, and growth-stage tech companies looking for senior engineering execution.",
  },
  {
    q: "How does Hegrix ensure project quality and timeline adherence?",
    a: "We operate in structured 2-week agile sprints with transparent roadmaps, continuous integration testing, and dedicated technical account management. You always know what is built, tested, and shipped.",
  },
  {
    q: "Does Hegrix provide post-launch support and SLA management?",
    a: "Yes. We offer continuous SLA maintenance plans, security monitoring, infrastructure patching, and ongoing performance optimization so your platform scales smoothly.",
  },
  {
    q: "Who owns the intellectual property (IP) of custom code?",
    a: "You do. Upon project completion and payment, 100% of the custom code, architecture diagrams, and intellectual property rights are fully transferred to your company.",
  },
  {
    q: "Can Hegrix augment our existing engineering or IT team?",
    a: "Absolutely. We offer flexible engagement models including full turn-key platform delivery, dedicated developer pods, and specialized ERP advisory teams.",
  },
];

const trustBadges = [
  { label: "ISO-Aligned Processes", icon: "🛡️" },
  { label: "Certified Odoo Partner", icon: "✅" },
  { label: "AWS Certified Engineers", icon: "☁️" },
  { label: "24/7 SLA Support", icon: "⏰" },
  { label: "100% IP Ownership", icon: "🔐" },
  { label: "NDA Protected", icon: "📋" },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
};
---

<Layout
  title="About Hegrix | Enterprise Software, Cloud & AI Automation Company"
  description="Learn about Hegrix, a premier enterprise software development company building Odoo ERP, custom software, cloud infrastructure, AI automation, and mobile platforms."
  keywords="about Hegrix, software development company, Odoo ERP partners, AI automation, digital product development team"
  path="/about-us/"
  schema={faqSchema}
>
  <div class="au-root">

    <!-- HERO -->
    <section class="au-hero" aria-label="About Hegrix Hero">
      <div class="au-hero__mesh" aria-hidden="true"></div>
      <div class="au-hero__orb au-hero__orb--1" aria-hidden="true"></div>
      <div class="au-hero__orb au-hero__orb--2" aria-hidden="true"></div>
      <div class="au-hero__orb au-hero__orb--3" aria-hidden="true"></div>

      <div class="container">
        <div class="au-hero__inner">
          <div class="au-hero__content">
            <div class="au-hero__badge">
              <span class="au-hero__badge-pulse"></span>
              <span>Who We Are &amp; What Drives Us</span>
            </div>

            <h1 class="au-hero__h1">
              We Build
              <span class="au-gradient-text">Dependable Digital Systems</span>
              for Scaling Enterprise Leaders.
            </h1>

            <p class="au-hero__desc">
              Hegrix combines strategic product design, senior ERP engineering, cloud infrastructure, and AI automation to transform operational bottlenecks into sustainable growth engines.
            </p>

            <div class="au-hero__actions">
              <a href="/contact-us/" class="au-btn au-btn--primary" id="hero-cta-primary">
                <span>Schedule Consultation</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <a href="#team" class="au-btn au-btn--ghost" id="hero-cta-team">
                <span>Meet Leadership Team</span>
              </a>
            </div>

            <div class="au-hero__trust-row">
              <div class="au-hero__trust-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Certified Engineers</span>
              </div>
              <div class="au-hero__trust-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>Product-Minded Delivery</span>
              </div>
              <div class="au-hero__trust-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                <span>24/7 SLA Support</span>
              </div>
            </div>
          </div>

          <div class="au-hero__visual">
            <div class="au-hero__card">
              <div class="au-card-header">
                <span class="au-dot au-dot--red"></span>
                <span class="au-dot au-dot--yellow"></span>
                <span class="au-dot au-dot--green"></span>
                <span class="au-card-title">Hegrix Operational Framework</span>
              </div>
              <div class="au-card-body">
                <div class="au-code-line"><span class="au-k">const</span> enterprise = <span class="au-k">new</span> HegrixPartner();</div>
                <div class="au-code-line"><span class="au-f">await</span> enterprise.auditSystemWorkflows();</div>
                <div class="au-code-line"><span class="au-f">await</span> enterprise.deployCustomPlatform(&#123;</div>
                <div class="au-code-line au-tab"><span class="au-p">erp:</span> <span class="au-s">"Odoo Certified Enterprise"</span>,</div>
                <div class="au-code-line au-tab"><span class="au-p">cloud:</span> <span class="au-s">"AWS Kubernetes Cluster"</span>,</div>
                <div class="au-code-line au-tab"><span class="au-p">ai:</span> <span class="au-s">"Automated Document Pipelines"</span>,</div>
                <div class="au-code-line"><span class="au-f">&#125;);</span></div>
                <div class="au-status-line">
                  <span class="au-status-dot"></span>
                  <span class="au-s">System Status: Optimal Performance (99.99%)</span>
                </div>
              </div>
            </div>

            <div class="au-float-badge au-float-badge--tr">
              <span class="au-float-icon">⚡</span>
              <div>
                <strong>10+ Years</strong>
                <span>Engineering Craft</span>
              </div>
            </div>

            <div class="au-float-badge au-float-badge--bl">
              <span class="au-float-icon">⭐</span>
              <div>
                <strong>98% Retention</strong>
                <span>SLA Partner Satisfaction</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST BADGES STRIP -->
    <section class="au-trust-strip" aria-label="Trust badges">
      <div class="container">
        <p class="au-trust-strip__label">Why Enterprise Leaders Choose Hegrix</p>
        <div class="au-trust-strip__badges">
          {trustBadges.map((b) => (
            <div class="au-trust-badge">
              <span class="au-trust-badge__icon">{b.icon}</span>
              <span>{b.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- IMPACT METRICS -->
    <section class="au-section au-section--alt" aria-labelledby="stats-heading">
      <div class="container">
        <div class="au-section__header">
          <p class="au-eyebrow">Proven Track Record</p>
          <h2 id="stats-heading" class="au-section__title">Numbers That Define Our Excellence</h2>
          <p class="au-section__desc">A decade of enterprise deliveries measured in outcomes, not just deliverables.</p>
        </div>

        <div class="au-stats-grid">
          {stats.map((s) => (
            <div class="au-stat-card">
              <div class="au-stat-card__icon">{s.icon}</div>
              <div class="au-stat-card__number">{s.number}</div>
              <div class="au-stat-card__label">{s.label}</div>
              <div class="au-stat-card__bar"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MISSION & VISION -->
    <section class="au-section" aria-labelledby="purpose-heading">
      <div class="container">
        <div class="au-section__header">
          <p class="au-eyebrow">Strategic Purpose</p>
          <h2 id="purpose-heading" class="au-section__title">Engineered to Support Your Growth at Every Stage</h2>
          <p class="au-section__desc">Our foundation rests on clarity, senior execution, and delivering software that impacts your bottom line.</p>
        </div>

        <div class="au-mv-grid">
          <div class="au-mv-card au-mv-card--mission">
            <div class="au-mv-card__glow"></div>
            <div class="au-mv-card__icon-box">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v8M8 12h8"></path></svg>
            </div>
            <h3>Our Mission</h3>
            <p>To eliminate operational complexity for expanding businesses by engineering reliable, scalable, and intuitive software platforms.</p>
            <ul class="au-mv-list">
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                Turn manual, fragmented processes into unified automated workflows
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                Ensure zero data loss and seamless legacy migrations
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                Deliver clean code that is easy to extend and maintain
              </li>
            </ul>
          </div>

          <div class="au-mv-card au-mv-card--vision">
            <div class="au-mv-card__glow"></div>
            <div class="au-mv-card__icon-box au-mv-card__icon-box--cyan">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-3.05 11a22.35 22.35 0 0 1-3.95 2z"></path></svg>
            </div>
            <h3>Our Vision</h3>
            <p>To set the global benchmark for enterprise software development where technical mastery meets true business alignment.</p>
            <ul class="au-mv-list">
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1fb6ff" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                Pioneer practical enterprise AI and workflow automation
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1fb6ff" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                Maintain an unyielding standard for performance, speed, and security
              </li>
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1fb6ff" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                Build long-term technology partnerships grounded in trust
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- GROWTH TIMELINE (dark) -->
    <section class="au-section au-section--dark" aria-labelledby="journey-heading">
      <div class="container">
        <div class="au-section__header">
          <p class="au-eyebrow au-eyebrow--light">Our Journey</p>
          <h2 id="journey-heading" class="au-section__title au-section__title--light">A Decade of Continuous Innovation</h2>
          <p class="au-section__desc au-section__desc--light">From humble beginnings to a trusted global digital transformation partner.</p>
        </div>

        <div class="au-timeline">
          <div class="au-timeline__line" aria-hidden="true"></div>
          {timeline.map((t, i) => (
            <div class={`au-timeline-item ${i % 2 === 0 ? 'au-timeline-item--left' : 'au-timeline-item--right'}`}>
              <div class="au-timeline-item__dot" style={`background: ${t.color}; box-shadow: 0 0 0 6px ${t.color}30`}></div>
              <div class="au-timeline-item__card">
                <span class="au-timeline-item__year" style={`color: ${t.color}`}>{t.year}</span>
                <h3>{t.title}</h3>
                <p>{t.desc}</p>
                <div class="au-timeline-item__accent" style={`background: ${t.color}`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CORE VALUES -->
    <section class="au-section" aria-labelledby="values-heading">
      <div class="container">
        <div class="au-section__header">
          <p class="au-eyebrow">Guiding Principles</p>
          <h2 id="values-heading" class="au-section__title">The Values Behind Every Line of Code</h2>
          <p class="au-section__desc">We operate by standards that guarantee accountability, code quality, and predictable outcomes.</p>
        </div>

        <div class="au-values-grid">
          {values.map((v) => (
            <div class="au-value-card" style={`--card-color: ${v.color}`}>
              <div class="au-value-card__icon-box" style={`background: ${v.color}15; color: ${v.color}`}>
                {v.iconType === "transparency" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                )}
                {v.iconType === "craftsmanship" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
                )}
                {v.iconType === "outcome" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
                )}
                {v.iconType === "security" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                )}
                {v.iconType === "ai" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                )}
                {v.iconType === "partnership" && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                )}
              </div>
              <h3>{v.title}</h3>
              <p>{v.desc}</p>
              <div class="au-value-card__border" style={`background: linear-gradient(90deg, ${v.color}, transparent)`}></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- TECH STACK -->
    <section class="au-section au-section--alt" aria-labelledby="tech-heading">
      <div class="container">
        <div class="au-section__header">
          <p class="au-eyebrow">Technical Mastery</p>
          <h2 id="tech-heading" class="au-section__title">Modern Technologies We Command</h2>
          <p class="au-section__desc">We combine industry-standard enterprise frameworks with modern cloud infrastructure.</p>
        </div>

        <div class="au-tech-grid">
          {techWall.map((t) => (
            <div class="au-tech-card" style={`--tech-color: ${t.color}`}>
              <div class="au-tech-card__header">
                <span class="au-tech-card__emoji">{t.icon}</span>
                <h3 class="au-tech-card__title">{t.category}</h3>
                <div class="au-tech-card__dot" style={`background: ${t.color}`}></div>
              </div>
              <div class="au-tech-card__pills">
                {t.items.map((item) => (
                  <span class="au-tech-pill" style={`border-color: ${t.color}50; color: ${t.color}`}>{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- LEADERSHIP TEAM -->
    <section class="au-section" id="team" aria-labelledby="team-heading">
      <div class="container">
        <div class="au-section__header">
          <p class="au-eyebrow">Leadership</p>
          <h2 id="team-heading" class="au-section__title">Meet the Minds Shaping Hegrix</h2>
          <p class="au-section__desc">Experienced architects, design directors, and engineers committed to your success.</p>
        </div>

