---
import Layout from "../../layouts/Layout.astro";
import { blogPosts } from "../../data/blog";

export const prerender = true;

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const relatedPosts = blogPosts.filter((item) => item.slug !== post.slug).slice(0, 3);

// Format date nicely
const formattedDate = new Date(post.date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Map callout types to visual config
const calloutConfig: Record<string, { label: string; icon: string; bgClass: string }> = {
  tip:      { label: "Pro Tip",   icon: "💡", bgClass: "ba-callout--tip" },
  warning:  { label: "Watch Out", icon: "⚠️", bgClass: "ba-callout--warning" },
  important:{ label: "Important", icon: "🔔", bgClass: "ba-callout--important" },
  cta:      { label: "How We Help", icon: "🚀", bgClass: "ba-callout--cta" },
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  keywords: post.keywords,
  author: {
    "@type": "Organization",
    name: "Hegrix",
  },
  publisher: {
    "@type": "Organization",
    name: "Hegrix",
    logo: {
      "@type": "ImageObject",
      url: "https://hegrix.com/favicon.svg",
    },
  },
  mainEntityOfPage: `https://hegrix.com/blog/${post.slug}/`,
};
---

<Layout
  title={`${post.title} | Hegrix Blog`}
  description={post.excerpt}
  keywords={post.keywords}
  path={`/blog/${post.slug}/`}
  schema={articleSchema}
>
  <div class="ba-root">

    <!-- ══════════════════════════════════════
         HERO HEADER
    ══════════════════════════════════════ -->
    <header class="ba-hero">
      <div class="ba-hero__mesh" aria-hidden="true"></div>
      <div class="ba-hero__orb ba-hero__orb--1" aria-hidden="true"></div>
      <div class="ba-hero__orb ba-hero__orb--2" aria-hidden="true"></div>

      <div class="container">
        <!-- Breadcrumb -->
        <nav class="ba-breadcrumb" aria-label="Breadcrumb">
          <a href="/" class="ba-breadcrumb__item">Home</a>
          <span class="ba-breadcrumb__sep" aria-hidden="true">›</span>
          <a href="/blog/" class="ba-breadcrumb__item">Blog</a>
          <span class="ba-breadcrumb__sep" aria-hidden="true">›</span>
          <span class="ba-breadcrumb__current">{post.category}</span>
        </nav>

        <div class="ba-hero__inner">
          <!-- Category + Meta -->
          <div class="ba-hero__meta">
            <span class="ba-category-badge">{post.category}</span>
            <span class="ba-hero__sep" aria-hidden="true">·</span>
            <span class="ba-meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              {formattedDate}
            </span>
            <span class="ba-hero__sep" aria-hidden="true">·</span>
            <span class="ba-meta-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {post.readTime}
            </span>
          </div>

          <!-- Headline -->
          <h1 class="ba-hero__title">{post.title}</h1>
          <p class="ba-hero__excerpt">{post.excerpt}</p>

          <!-- Author row -->
          <div class="ba-author-row">
            <div class="ba-author-avatar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="ba-author-info">
              <span class="ba-author-name">{post.author}</span>
              <span class="ba-author-org">Hegrix · Expert Editorial</span>
            </div>
            <div class="ba-share-row">
              <span class="ba-share-label">Share:</span>
              <a href={`https://www.linkedin.com/sharing/share-offsite/?url=https://hegrix.com/blog/${post.slug}/`} target="_blank" rel="noopener noreferrer" class="ba-share-btn" aria-label="Share on LinkedIn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
              <a href={`https://x.com/intent/tweet?url=https://hegrix.com/blog/${post.slug}/&text=${encodeURIComponent(post.title)}`} target="_blank" rel="noopener noreferrer" class="ba-share-btn" aria-label="Share on X">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Stats Bar (if post has stats) -->
        {post.stats && (
          <div class="ba-stats-bar">
            {post.stats.map((stat) => (
              <div class="ba-stat">
                <span class="ba-stat__value">{stat.value}</span>
                <span class="ba-stat__label">{stat.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </header>

    <!-- ══════════════════════════════════════
         ARTICLE BODY
    ══════════════════════════════════════ -->
    <div class="ba-body">
      <div class="container">
        <div class="ba-layout">

          <!-- MAIN ARTICLE CONTENT -->
          <article class="ba-content" id="article-content">

            {post.sections.map((section) => {
              const cc = section.callout ? calloutConfig[section.callout.type] : null;
              return (
                <section class="ba-section" id={section.id}>
                  <div class="ba-section__heading-row">
                    {section.icon && <span class="ba-section__icon" aria-hidden="true">{section.icon}</span>}
                    <h2 class="ba-section__h2">{section.heading}</h2>
                  </div>

                  {section.paragraphs.map((p) => (
                    <p class="ba-section__p">{p}</p>
                  ))}

                  {section.callout && cc && (
                    <div class={`ba-callout ${cc.bgClass}`}>
                      <div class="ba-callout__header">
                        <span class="ba-callout__icon">{cc.icon}</span>
                        <span class="ba-callout__label">{cc.label}</span>
                      </div>
                      <p class="ba-callout__text">{section.callout.text}</p>
                      {section.callout.type === "cta" && (
                        <a href="/contact-us/" class="ba-callout__btn">
                          <span>Talk to our ERP team</span>
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                      )}
                    </div>
                  )}

                  {section.points && (
                    <ul class="ba-checklist">
                      {section.points.map((point) => (
                        <li class="ba-checklist__item">
                          <span class="ba-checklist__check" aria-hidden="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
                          </span>
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </section>
              );
            })}

            <!-- Bottom share / CTA strip -->
            <div class="ba-bottom-cta">
              <div class="ba-bottom-cta__left">
                <p class="ba-bottom-cta__label">Was this helpful?</p>
                <div class="ba-share-row">
                  <a href={`https://www.linkedin.com/sharing/share-offsite/?url=https://hegrix.com/blog/${post.slug}/`} target="_blank" rel="noopener noreferrer" class="ba-share-btn ba-share-btn--dark" aria-label="Share on LinkedIn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
                    Share on LinkedIn
                  </a>
                </div>
              </div>
              <a href="/contact-us/" class="hp-btn hp-btn--primary ba-bottom-cta__btn">
                <span>Work with Hegrix</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>

          <!-- STICKY SIDEBAR -->
          <aside class="ba-sidebar" aria-label="Article navigation">

            <!-- Table of Contents -->
            {post.toc && (
              <div class="ba-sidebar-panel">
                <div class="ba-sidebar-panel__header">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                  <h2 class="ba-sidebar-panel__title">In this article</h2>
                </div>
                <nav class="ba-toc" aria-label="Table of contents">
                  {post.toc.map((item) => (
                    <a href={`#${item.anchor}`} class="ba-toc__link">{item.label}</a>
                  ))}
                </nav>
              </div>
            )}

            <!-- CTA Panel -->
            <div class="ba-sidebar-panel ba-sidebar-panel--cta">
              <div class="ba-sidebar-cta__icon">⚙️</div>
              <h2 class="ba-sidebar-panel__title ba-sidebar-panel__title--white">Need ERP help?</h2>
              <p class="ba-sidebar-cta__desc">Hegrix helps growing businesses plan, integrate, and launch Odoo ERP — on time and without surprises.</p>
              <a href="/contact-us/" class="ba-sidebar-cta__btn" id="sidebar-cta-blog">
                <span>Start a conversation</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
              <ul class="ba-sidebar-cta__list">
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                  Free 30-min consultation
                </li>
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                  No obligation, no cost
                </li>
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                  Response within 48 hours
                </li>
              </ul>
            </div>

            <!-- Article meta -->
            <div class="ba-sidebar-panel ba-sidebar-meta">
              <div class="ba-sidebar-meta__row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <div>
                  <span class="ba-sidebar-meta__label">Author</span>
                  <span class="ba-sidebar-meta__val">{post.author}</span>
                </div>
              </div>
              <div class="ba-sidebar-meta__row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <div>
                  <span class="ba-sidebar-meta__label">Published</span>
                  <span class="ba-sidebar-meta__val">{formattedDate}</span>
                </div>
              </div>
              <div class="ba-sidebar-meta__row">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--muted)" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <div>
                  <span class="ba-sidebar-meta__label">Reading Time</span>
                  <span class="ba-sidebar-meta__val">{post.readTime}</span>
                </div>
              </div>
            </div>

          </aside>
        </div>
      </div>
    </div>

    <!-- ══════════════════════════════════════
         RELATED ARTICLES
    ══════════════════════════════════════ -->
    <section class="ba-related" aria-labelledby="related-heading">
      <div class="container">
        <div class="ba-related__header">
          <p class="hp-eyebrow">Keep Reading</p>
          <h2 id="related-heading" class="ba-related__title">Related Articles</h2>
        </div>
        <div class="ba-related-grid">
          {relatedPosts.map((item, i) => (
            <article class="ba-related-card">
              <div class={`ba-related-card__thumb ba-related-card__thumb--${(i % 3) + 1}`}>
                <span class="ba-related-card__label">{item.heroLabel}</span>
                <span class="ba-related-card__cat">{item.category}</span>
              </div>
              <div class="ba-related-card__body">
                <div class="ba-related-card__meta">
                  <span>{item.readTime}</span>
                </div>
                <h3 class="ba-related-card__title">{item.title}</h3>
                <p class="ba-related-card__excerpt">{item.excerpt}</p>
                <a href={`/blog/${item.slug}/`} class="ba-related-card__link">
                  <span>Read article</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

  </div>
</Layout>
