    {/* SECTION 6 — HOW HEGRIX RETAIL360 WORKS */}
    <section class="odoo-section">
      <div class="container">
        <div class="odoo-section-header">
          <p class="odoo-section-eyebrow">Implementation</p>
          <h2 class="odoo-section-title">How Hegrix Retail360 Is Deployed</h2>
          <p class="odoo-section-desc">A structured 10-step path from initial audit to go-live and ongoing growth.</p>
        </div>

        <div class="odoo-timeline">
          <div class="timeline-step"><div class="step-num">01</div><h3>Business Discovery</h3><p>Analyze your store network, SKUs, and sales channels.</p></div>
          <div class="timeline-step"><div class="step-num">02</div><h3>Retail Analysis</h3><p>Audit current POS hardware, spreadsheets, and WMS gaps.</p></div>
          <div class="timeline-step"><div class="step-num">03</div><h3>Solution Planning</h3><p>Design multi-store architecture and workflow blueprints.</p></div>
          <div class="timeline-step"><div class="step-num">04</div><h3>Customization</h3><p>Configure Odoo modules, receipt templates, and POS screens.</p></div>
