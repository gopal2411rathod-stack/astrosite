    {/* SECTION 4 — KEY FEATURES (BENTO GRID) */}
    <section class="odoo-section">
      <div class="container">
        <div class="odoo-section-header">
          <p class="odoo-section-eyebrow">Platform Capabilities</p>
          <h2 class="odoo-section-title">Everything You Need to Scale Your Retail Business</h2>
          <p class="odoo-section-desc">Explore the powerful features built into Hegrix Retail360.</p>
        </div>

        <div class="bento-grid">
          <div class="bento-card featured wide">
            <div>
              <div class="glass-icon" style="margin-bottom: 12px;">📊</div>
