---
import Layout from "../layouts/Layout.astro";

const retail360Faq = [
  {
    title: "Can Hegrix Retail360 manage multiple retail stores?",
    text: "Yes. Hegrix Retail360 provides centralized multi-store management, allowing you to control pricing, inventory transfers, sales dashboards, and staff permissions across dozens of physical locations and online storefronts in real time."
  },
  {
    title: "Does it support hardware barcode scanners and thermal receipt printers?",
    text: "Yes. The Odoo POS engine in Hegrix Retail360 offers native plug-and-play support for USB & Bluetooth barcode scanners, scales, cash drawers, customer displays, and thermal receipt printers."
  },
  {
    title: "Can Hegrix Retail360 integrate with Shopify or WooCommerce?",
    text: "Yes. We deploy bidirectional connectors that automatically sync products, stock levels, customer data, and orders between Shopify, WooCommerce, Amazon, and your Odoo core database."
  },
  {
    title: "Can I manage inventory in real time across online and offline channels?",
    text: "Absoluely. Every POS transaction or online sale immediately adjusts global stock records, preventing overselling and inventory mismatches across all channels."
  },
  {
    title: "Does it support customer loyalty programs and gift cards?",
    text: "Yes. Retail360 includes built-in customer loyalty tiers, points accumulation, promotional coupon codes, digital gift cards, and targeted marketing automation."
  },
  {
    title: "Can it automate purchasing and vendor reordering?",
    text: "Yes. You can define minimum stock rules for every product line. When stock dips below thresholds, Retail360 automatically generates automated Purchase Orders (POs) for vendor approval."
  }
];

const retail360Schema = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Hegrix Retail360",
    operatingSystem: "Cloud, Web, Linux, Windows, iOS, Android",
    applicationCategory: "BusinessApplication",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
    },
    description: "Complete retail business management platform powered by Odoo ERP. Inventory, POS, eCommerce, CRM, accounting & live analytics.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: retail360Faq.map((item) => ({
      "@type": "Question",
      name: item.title,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.text,
      },
    })),
  },
];
---

<Layout
  title="Hegrix Retail360 | Retail ERP Software Powered by Odoo"
  description="Hegrix Retail360 is an all-in-one retail management software powered by Odoo ERP. POS, inventory management, multi-store stock, eCommerce, CRM, and real-time analytics."
  keywords="Retail ERP Software, Odoo Retail ERP, Retail Management Software, POS Management System, Inventory Management Software, Multi Store ERP, Retail Business Automation, Retail ERP Solution, Retail Inventory Management, Odoo POS, Omnichannel Retail ERP, Retail CRM"
  path="/hegrix-retail360/"
  schema={retail360Schema}
>
  <div class="odoo-landing-wrapper">
    {/* SECTION 1 — HERO */}
