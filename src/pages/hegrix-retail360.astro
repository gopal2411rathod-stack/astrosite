            <div class="ps-card problem"><span class="ps-icon">✕</span><span class="ps-text">Poor Customer Retention & Loyalty</span></div>
            <div class="ps-card problem"><span class="ps-icon">✕</span><span class="ps-text">Delayed Sales & Margin Reporting</span></div>
            <div class="ps-card problem"><span class="ps-icon">✕</span><span class="ps-text">Purchase Reordering Delays</span></div>
            <div class="ps-card problem"><span class="ps-icon">✕</span><span class="ps-text">Warehouse Misplacement & Shrinkage</span></div>
          </div>

          <div class="ps-card-list">
            <div class="ps-card solution"><span class="ps-icon">✓</span><span class="ps-text">Real-Time Automated Stock Replenishment</span></div>
            <div class="ps-card solution"><span class="ps-icon">✓</span><span class="ps-text">Unified Multi-Store Stock Matrix</span></div>
            <div class="ps-card solution"><span class="ps-icon">✓</span><span class="ps-text">Fast Barcode Scanning & POS Billing</span></div>
            <div class="ps-card solution"><span class="ps-icon">✓</span><span class="ps-text">Unified Omnichannel Inventory Engine</span></div>
            <div class="ps-card solution"><span class="ps-icon">✓</span><span class="ps-text">Integrated Retail Loyalty & Gift Cards</span></div>
            <div class="ps-card solution"><span class="ps-icon">✓</span><span class="ps-text">Live Executive BI Reports & Dashboards</span></div>
            <div class="ps-card solution"><span class="ps-icon">✓</span><span class="ps-text">Automated Smart Purchasing & POs</span></div>
            <div class="ps-card solution"><span class="ps-icon">✓</span><span class="ps-text">Barcode-Driven WMS & Audit Trails</span></div>
          </div>
