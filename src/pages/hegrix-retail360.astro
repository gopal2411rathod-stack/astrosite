    </section>

    {/* SECTION 2 — WHY RETAIL360 */}
    <section class="odoo-section">
      <div class="container">
        <div class="odoo-section-header">
          <p class="odoo-section-eyebrow">Product Purpose</p>
          <h2 class="odoo-section-title">Built Specifically for Modern Retail Businesses</h2>
