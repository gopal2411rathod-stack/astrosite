            <h3>✅ Hegrix Retail360 Solutions</h3>
          </div>

          <div class="ps-card-list">
            <div class="ps-card problem"><span class="ps-icon">✕</span><span class="ps-text">Frequent Stock Shortages & Overstocking</span></div>
            <div class="ps-card problem"><span class="ps-icon">✕</span><span class="ps-text">Inventory Mismatch Between Stores</span></div>
