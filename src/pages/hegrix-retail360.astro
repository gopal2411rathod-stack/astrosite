                  <option value="6-20 Stores">6-20 Stores</option>
                  <option value="20+ Stores">20+ Stores</option>
                  <option value="Online Only">Online Only (eCommerce)</option>
                </select>
              </div>
              <div class="form-group">
                <label for="r-software">Current Software</label>
                <input type="text" id="r-software" name="software" placeholder="e.g. QuickBooks, Excel, Tally, Custom POS" />
