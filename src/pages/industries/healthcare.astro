---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const hcFaqs = [
  {
    question: "What types of healthcare software do you build?",
    answer: "We build custom EHR/EMR systems, patient portals, telemedicine platforms, hospital management software, healthcare CRM, pharmacy POS, laboratory management (LIS), and healthcare analytics."
  },
  {
    question: "Can you integrate with our existing healthcare systems?",
    answer: "Yes. We seamlessly connect with legacy EHRs (Epic, Cerner, Allscripts), FHIR/HL7 standards, lab instruments, payment gateways, and medical devices via secure APIs."
  },
  {
    question: "Can you build software for startups?",
    answer: "Yes. We help healthcare startups turn initial concepts into compliance-ready MVPs and scalable production platforms designed for fast market entry."
  },
  {
    question: "How do you approach healthcare data security?",
    answer: "Security is built-in from day one, incorporating end-to-end AES-256 encryption, role-based access control, audit logs, and architectures designed for HIPAA and GDPR compliance."
  },
  {
    question: "Can you modernize an existing healthcare application?",
    answer: "Yes. We evaluate legacy applications to upgrade user experience, eliminate technical debt, modernize databases, and migrate to secure cloud infrastructure without downtime."
  },
  {
    question: "Do you provide post-launch support?",
    answer: "Yes. We provide 24/7 technical monitoring, SLA maintenance, security patches, system optimizations, and ongoing feature updates after deployment."
  }
];

const hcSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Healthcare Software Solutions",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com"
    },
    areaServed: "Global",
    serviceType: "Custom Healthcare Software Development, EHR/EMR Integration, Telemedicine, Patient Portals & Analytics",
    description: "Build secure, scalable healthcare software tailored to your workflows. Connect fragmented systems, automate clinical processes, and deliver modern digital care.",
    url: "https://hegrix.com/industries/healthcare/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: hcFaqs.map(f => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.answer
      }
    }))
  }
];
---

<Layout
  title="Healthcare Software Solutions | Secure & Scalable Healthcare Technology | Hegrix"
  description="Build secure, scalable healthcare software tailored to your workflows. From EHR and telemedicine to patient portals, integrations, and healthcare analytics."
  keywords="Healthcare software solutions, Healthcare software development, Healthcare technology solutions, Custom healthcare software, Healthcare app development, Healthcare software development company, Telemedicine software, EHR software development, Patient portal development"
  path="/industries/healthcare/"
  schema={hcSchema}
>

  <div class="hc-page">

    <!-- ═══════════════════════════════════════
         1. HERO SECTION
    ═══════════════════════════════════════ -->
    <section class="hc-hero">
      <div class="container hc-hero__wrap">
        
        <div class="hc-hero__content">
          <div class="hc-eyebrow">
            <span class="hc-eyebrow__pulse"></span>
            HEALTHCARE SOFTWARE SOLUTIONS
          </div>
          
          <h1 class="hc-hero__title">
            Healthcare Software Built Around <span class="hc-gradient-text">Your Workflows.</span>
          </h1>

          <p class="hc-hero__lead">
            Transform complex healthcare processes into secure, connected, and intuitive digital experiences. We build custom healthcare software that helps providers operate smarter and patients experience better care.
          </p>

          <!-- Core USP Banner Card -->
          <div class="hc-usp-banner">
            <div class="hc-usp-banner__tag">CORE USP</div>
            <p class="hc-usp-banner__main">
              “Healthcare software built around your workflows—not the other way around.”
            </p>
            <p class="hc-usp-banner__sub">
              Secure, scalable, and interoperable healthcare solutions that streamline operations, connect fragmented systems, and deliver better digital experiences for providers and patients.
            </p>
          </div>

          <div class="hc-hero__actions">
            <a href="#contact-form" class="hc-btn hc-btn--primary">
              Book a Consultation
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
            <a href="#solutions" class="hc-btn hc-btn--secondary">
              Explore Our Solutions
            </a>
          </div>

          <div class="hc-hero__badges">
            <span class="hc-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Security-by-Design
            </span>
            <span class="hc-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              FHIR &amp; HL7 Ready
            </span>
            <span class="hc-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0D9488" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Enterprise Scale
            </span>
          </div>
        </div>

        <!-- Hero Right Visual: Clinical Command Dashboard -->
        <div class="hc-hero__visual">
          
          <!-- Floating UI Pill 1 -->
          <div class="hc-float-card hc-float-card--top">
            <div class="hc-float-card__icon hc-float-card__icon--teal">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
            </div>
            <div>
              <div class="hc-float-card__val">+24%</div>
              <div class="hc-float-card__lbl">Operational Efficiency</div>
            </div>
          </div>

          <!-- Floating UI Pill 2 -->
          <div class="hc-float-card hc-float-card--mid">
            <div class="hc-float-card__icon hc-float-card__icon--blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <div>
              <div class="hc-float-card__val">Secure &amp; Connected</div>
              <div class="hc-float-card__lbl">Encrypted Data Layer</div>
            </div>
          </div>

          <!-- Floating UI Pill 3 -->
          <div class="hc-float-card hc-float-card--bot">
            <div class="hc-float-card__icon hc-float-card__icon--green">
