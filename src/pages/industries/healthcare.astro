          </div>

          <!-- Solution Card 04 -->
          <div class="hc-solution-card">
            <div class="hc-solution-card__head">
              <div class="hc-solution-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              </div>
              <span class="hc-solution-card__idx">04</span>
            </div>
            <h3 class="hc-solution-card__title">Patient Portals</h3>
            <p class="hc-solution-card__desc">
              Give patients convenient access to appointments, records, prescriptions, secure clinician messaging, and healthcare services.
            </p>
            <a href="#contact-form" class="hc-solution-card__link">
              Learn More <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>

          <!-- Solution Card 05 -->
          <div class="hc-solution-card">
            <div class="hc-solution-card__head">
              <div class="hc-solution-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <span class="hc-solution-card__idx">05</span>
            </div>
            <h3 class="hc-solution-card__title">Healthcare CRM</h3>
            <p class="hc-solution-card__desc">
              Build stronger patient relationships with personalized communication, care reminders, engagement, and workflow automation.
            </p>
            <a href="#contact-form" class="hc-solution-card__link">
              Learn More <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>

          <!-- Solution Card 06 -->
          <div class="hc-solution-card">
