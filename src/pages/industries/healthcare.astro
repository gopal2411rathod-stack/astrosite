            </div>
            <div>
              <div class="hc-float-card__val">98.7%</div>
              <div class="hc-float-card__lbl">System Uptime</div>
            </div>
          </div>

          <!-- Main Dashboard Graphic -->
          <div class="hc-dashboard">
            <div class="hc-dash__head">
              <div class="hc-dash__dots">
                <span></span><span></span><span></span>
              </div>
              <div class="hc-dash__title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                Clinical Operations &amp; Care Command Center
              </div>
              <div class="hc-dash__status">
                <span class="hc-live-dot"></span> LIVE
              </div>
            </div>

            <div class="hc-dash__body">
              <div class="hc-dash__kpis">
                <div class="hc-kpi-item">
                  <div class="hc-kpi-item__num">14,280</div>
                  <div class="hc-kpi-item__label">Active Patients</div>
                </div>
                <div class="hc-kpi-item">
                  <div class="hc-kpi-item__num">482</div>
                  <div class="hc-kpi-item__label">Today's Visits</div>
                </div>
                <div class="hc-kpi-item">
                  <div class="hc-kpi-item__num">99.8%</div>
                  <div class="hc-kpi-item__label">Sync Speed</div>
                </div>
              </div>

              <!-- Mini Chart Graphic -->
              <div class="hc-dash__chart-container">
                <div class="hc-dash__chart-header">
                  <span>Patient Encounters &amp; Capacity Load</span>
                  <span class="hc-badge-sm">Real-time Stream</span>
                </div>
                <div class="hc-chart-visual">
                  <div class="hc-chart-bar" style="--h: 45%;"><span>Mon</span></div>
                  <div class="hc-chart-bar" style="--h: 70%;"><span>Tue</span></div>
                  <div class="hc-chart-bar" style="--h: 88%;"><span>Wed</span></div>
                  <div class="hc-chart-bar" style="--h: 62%;"><span>Thu</span></div>
                  <div class="hc-chart-bar" style="--h: 95%;"><span>Fri</span></div>
                  <div class="hc-chart-bar" style="--h: 55%;"><span>Sat</span></div>
                  <div class="hc-chart-bar" style="--h: 40%;"><span>Sun</span></div>
                </div>
              </div>

              <!-- Stream Rows -->
              <div class="hc-dash__stream">
                <div class="hc-stream-row">
                  <div class="hc-stream-row__status hc-stream-row__status--success">●</div>
                  <div class="hc-stream-row__info">
                    <strong>Telehealth Consultation #4092</strong>
                    <span>Dr. Sarah Jenkins · Patient Check-in Verified</span>
                  </div>
                  <div class="hc-stream-row__time">Just Now</div>
                </div>
                <div class="hc-stream-row">
                  <div class="hc-stream-row__status hc-stream-row__status--blue">●</div>
                  <div class="hc-stream-row__info">
                    <strong>FHIR Sync — Lab Results</strong>
