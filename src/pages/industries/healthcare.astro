<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("healthcare-lead-form") as HTMLFormElement | null;
    const submitBtn = document.getElementById("hc-submit-btn") as HTMLButtonElement | null;
    const statusMsg = document.getElementById("form-status-msg");
    const modal = document.getElementById("hc-success-modal");
    const modalClose = document.getElementById("hc-modal-close");
    const modalOk = document.getElementById("hc-modal-ok");
    const modalBackdrop = document.getElementById("hc-modal-backdrop");

    const closeModal = () => {
      modal?.setAttribute("hidden", "");
    };

    modalClose?.addEventListener("click", closeModal);
    modalOk?.addEventListener("click", closeModal);
    modalBackdrop?.addEventListener("click", closeModal);

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form || !submitBtn) return;

      const btnText = submitBtn.querySelector(".hc-btn-text");
      const originalText = btnText ? btnText.textContent : "Start the Conversation";

      if (btnText) btnText.textContent = "Submitting...";
      submitBtn.disabled = true;

      if (statusMsg) {
        statusMsg.hidden = true;
        statusMsg.textContent = "";
        statusMsg.className = "hc-form-status";
      }

      const formData = new FormData(form);
      const name = formData.get("name")?.toString() || "";
      const email = formData.get("email")?.toString() || "";
      const company = formData.get("company")?.toString() || "";
      const phone = formData.get("phone")?.toString() || "";
      const solution = formData.get("solution")?.toString() || "";
      const messageDetails = formData.get("message")?.toString() || "";

      const payload = {
        name,
        email,
        company,
        phone,
        message: `[Solution Need: ${solution}]\n${messageDetails}`.trim(),
        sourcePage: "Healthcare Software Solutions (/industries/healthcare/)",
      };

      try {
        const res = await fetch("/api/leads", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.message || "Failed to submit form. Please check details.");
        }

        form.reset();
        modal?.removeAttribute("hidden");
      } catch (err) {
        if (statusMsg) {
          statusMsg.textContent = err instanceof Error ? err.message : "An error occurred. Please try again.";
          statusMsg.className = "hc-form-status hc-form-status--error";
          statusMsg.hidden = false;
        }
      } finally {
        if (btnText) btnText.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  });
</script>

