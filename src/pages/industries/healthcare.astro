          </div>

        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════
         2. TRUST / SOCIAL PROOF STRIP
    ═══════════════════════════════════════ -->
    <section class="hc-trust-strip">
      <div class="container">
        <p class="hc-trust-strip__headline">
