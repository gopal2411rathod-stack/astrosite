            </a>
            <a href="#solutions" class="rt-btn rt-btn--secondary rt-btn--lg">
              <span>Explore Retail Solutions</span>
            </a>
          </div>

          <div class="rt-hero__trust">
            <div class="rt-trust-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <strong>250+</strong> Projects Delivered
            </div>
            <div class="rt-trust-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <strong>15+</strong> Industries Served
            </div>
            <div class="rt-trust-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <strong>10+</strong> Years Experience
            </div>
            <div class="rt-trust-pill">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              <strong>98%</strong> Client Satisfaction
            </div>
          </div>
        </div>

        <!-- Hero Right: Retail Tech Ecosystem Dashboard -->
        <div class="rt-hero__visual">
          <!-- Main Dashboard Card -->
          <div class="rt-dashboard">
            <div class="rt-dashboard__header">
              <div class="rt-dashboard__title-wrap">
                <span class="rt-dashboard__dot"></span>
                <span class="rt-dashboard__title">Retail Command Center</span>
              </div>
              <span class="rt-demo-badge">Sample Data</span>
            </div>

            <div class="rt-dash-metrics">
              <div class="rt-dash-metric">
                <span class="rt-dash-metric__lbl">Today's Sales</span>
                <span class="rt-dash-metric__val">$48,920</span>
                <span class="rt-dash-metric__up">↑ 12.4%</span>
              </div>
              <div class="rt-dash-metric">
