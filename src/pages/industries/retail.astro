          <div class="rt-challenge-card">
            <div class="rt-challenge-card__before">
              <span class="rt-challenge-tag rt-challenge-tag--problem">Challenge</span>
              <div class="rt-challenge-card__icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              </div>
              <h3>Complex Warehouse Operations</h3>
            </div>
            <div class="rt-challenge-card__arrow">→</div>
            <div class="rt-challenge-card__after">
