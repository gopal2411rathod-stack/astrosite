<script>
// ── FAQ Accordion ──
const faqList = document.getElementById('rtFaqList');
if (faqList) {
  faqList.addEventListener('click', (e) => {
    const btn = e.target.closest('.rt-faq-item__q');
    if (!btn) return;
    const item = btn.closest('.rt-faq-item');
    const answer = item.querySelector('.rt-faq-item__a');
    const isOpen = btn.getAttribute('aria-expanded') === 'true';

    // Close all
    faqList.querySelectorAll('.rt-faq-item__q').forEach(b => {
      b.setAttribute('aria-expanded', 'false');
      b.closest('.rt-faq-item').querySelector('.rt-faq-item__a').hidden = true;
    });

    if (!isOpen) {
      btn.setAttribute('aria-expanded', 'true');
      answer.hidden = false;
    }
  });
}

// ── Animated Stats Counter ──
const animateCounters = () => {
  const statNums = document.querySelectorAll('.rt-stat-box__num[data-target]');
  statNums.forEach(el => {
    const target = parseInt(el.getAttribute('data-target'), 10);
    const duration = 1800;
    const step = target / (duration / 16);
    let current = 0;
    const timer = setInterval(() => {
      current += step;
      if (current >= target) {
        current = target;
        clearInterval(timer);
      }
      el.textContent = Math.floor(current);
    }, 16);
  });
};

const statObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      animateCounters();
      statObserver.disconnect();
    }
  });
}, { threshold: 0.3 });

const statsGrid = document.querySelector('.rt-stats-grid');
if (statsGrid) statObserver.observe(statsGrid);

// ── Contact Form ──
const rtForm = document.getElementById('rtContactForm');
const rtStatus = document.getElementById('rtFormStatus');
const rtSubmitBtn = document.getElementById('rtSubmitBtn');
const rtSubmitText = document.getElementById('rtSubmitText');
const rtModal = document.getElementById('rtSuccessModal');

if (rtForm) {
  rtForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    rtSubmitBtn.disabled = true;
    rtSubmitText.textContent = 'Sending…';

    const formData = new FormData(rtForm);
    const data = Object.fromEntries(formData.entries());
    data.subject = 'Retail Software Solutions Inquiry';
    data.page = '/industries/retail/';

    try {
      const res = await fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (res.ok) {
        rtForm.reset();
        if (rtModal) rtModal.hidden = false;
      } else {
        throw new Error('Server error');
      }
    } catch {
      rtStatus.textContent = 'Something went wrong. Please try again or contact us directly.';
      rtStatus.className = 'rt-form-status error';
      rtStatus.hidden = false;
    } finally {
      rtSubmitBtn.disabled = false;
      rtSubmitText.textContent = 'Discuss My Retail Project';
    }
  });
}

// Modal close
const rtModalClose = document.getElementById('rtModalClose');
const rtModalBackdrop = document.getElementById('rtModalBackdrop');
const rtModalBtn = document.getElementById('rtModalBtn');
[rtModalClose, rtModalBackdrop, rtModalBtn].forEach(el => {
  if (el) el.addEventListener('click', () => { if (rtModal) rtModal.hidden = true; });
});
</script>

