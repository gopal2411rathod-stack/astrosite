  gap: 0.4rem;
  padding: 0.4rem 0.85rem;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 9999px;
  font-size: 0.82rem;
  color: #CBD5E1;
}
.rt-trust-pill strong { color: #fff; }

/* ── Hero Dashboard ── */
.rt-hero__visual { position: relative; }
.rt-dashboard {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 20px;
  padding: 1.5rem;
  backdrop-filter: blur(20px);
  position: relative;
  z-index: 2;
}
.rt-dashboard__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.25rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.rt-dashboard__title-wrap { display: flex; align-items: center; gap: 0.5rem; }
.rt-dashboard__dot {
  width: 8px; height: 8px;
  background: #10B981;
  border-radius: 50%;
  animation: rtPulse 2s infinite;
}
.rt-dashboard__title { font-size: 0.85rem; font-weight: 600; color: #E2E8F0; }
.rt-demo-badge {
  font-size: 0.65rem;
  font-weight: 600;
  background: rgba(245,158,11,0.15);
  color: #F59E0B;
  border: 1px solid rgba(245,158,11,0.3);
  border-radius: 9999px;
  padding: 0.2rem 0.6rem;
  letter-spacing: 0.04em;
}

.rt-dash-metrics {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 0.75rem;
  margin-bottom: 1rem;
}
.rt-dash-metric {
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px;
  padding: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}
.rt-dash-metric__lbl { font-size: 0.65rem; color: #64748B; text-transform: uppercase; letter-spacing: 0.06em; }
.rt-dash-metric__val { font-size: 1.05rem; font-weight: 700; color: #E2E8F0; }
.rt-dash-metric__up { font-size: 0.65rem; color: #10B981; font-weight: 600; }
.rt-dash-metric__neutral { font-size: 0.65rem; color: #60A5FA; font-weight: 600; }

.rt-module-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 1rem;
}
.rt-module-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.3rem 0.7rem;
  border-radius: 9999px;
  font-size: 0.7rem;
  font-weight: 600;
}
.rt-module-pill--blue { background: rgba(37,99,235,0.15); color: #93C5FD; border: 1px solid rgba(37,99,235,0.25); }
.rt-module-pill--emerald { background: rgba(16,185,129,0.15); color: #6EE7B7; border: 1px solid rgba(16,185,129,0.25); }
.rt-module-pill--violet { background: rgba(124,58,237,0.15); color: #C4B5FD; border: 1px solid rgba(124,58,237,0.25); }
.rt-module-pill--amber { background: rgba(245,158,11,0.15); color: #FCD34D; border: 1px solid rgba(245,158,11,0.25); }
.rt-module-pill--cyan { background: rgba(6,182,212,0.15); color: #67E8F9; border: 1px solid rgba(6,182,212,0.25); }
.rt-module-pill--rose { background: rgba(244,63,94,0.15); color: #FDA4AF; border: 1px solid rgba(244,63,94,0.25); }

.rt-dash-chart { }
.rt-dash-chart__label { font-size: 0.7rem; color: #64748B; display: block; margin-bottom: 0.4rem; }
.rt-chart-svg { width: 100%; height: 48px; display: block; }

/* Floating Cards */
.rt-float-card {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.65rem 1rem;
  background: rgba(15,23,42,0.92);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 12px;
  backdrop-filter: blur(16px);
  z-index: 3;
  white-space: nowrap;
}
.rt-float-card--1 { top: -18px; right: -20px; animation: rtFloat1 4s ease-in-out infinite; }
.rt-float-card--2 { bottom: 20px; left: -24px; animation: rtFloat2 4.5s ease-in-out infinite; }
.rt-float-card--3 { top: 50%; right: -28px; transform: translateY(-50%); animation: rtFloat1 5s ease-in-out infinite; }
.rt-float-card--4 { bottom: -16px; right: 24px; animation: rtFloat2 3.8s ease-in-out infinite; }
@keyframes rtFloat1 { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
@keyframes rtFloat2 { 0%,100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
.rt-float-card--3 { animation: rtFloat3 5s ease-in-out infinite; }
@keyframes rtFloat3 { 0%,100% { transform: translateY(-50%) translateX(0); } 50% { transform: translateY(-50%) translateX(-4px); } }
.rt-float-card__icon {
  width: 32px; height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.rt-float-card__icon--emerald { background: rgba(16,185,129,0.2); color: #10B981; }
.rt-float-card__icon--blue { background: rgba(37,99,235,0.2); color: #3B82F6; }
.rt-float-card__icon--violet { background: rgba(124,58,237,0.2); color: #8B5CF6; }
.rt-float-card__icon--amber { background: rgba(245,158,11,0.2); color: #F59E0B; }
.rt-float-card__val { display: block; font-size: 0.8rem; font-weight: 700; color: #E2E8F0; }
.rt-float-card__sub { display: block; font-size: 0.67rem; color: #94A3B8; }

/* ── Trust Strip ── */
.rt-trust-strip {
  background: var(--rt-navy);
  padding: 3.5rem 0;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.rt-trust-strip__title {
  text-align: center;
  font-size: 1rem;
  font-weight: 600;
  color: #94A3B8;
  letter-spacing: 0.03em;
  margin-bottom: 1.75rem;
}
.rt-logo-strip {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  margin-bottom: 3rem;
}
.rt-logo-item {
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: #475569;
  padding: 0.4rem 0.8rem;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 8px;
  text-transform: uppercase;
}
.rt-stats-grid {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0;
}
.rt-stat-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 1.25rem 2.5rem;
  border-right: 1px solid rgba(255,255,255,0.08);
}
.rt-stat-box:last-child { border-right: none; }
.rt-stat-box__num { font-size: 2.25rem; font-weight: 900; color: #fff; line-height: 1; }
.rt-stat-box__plus { font-size: 1.5rem; font-weight: 900; color: #3B82F6; display: inline; }
.rt-stat-box__num-static { font-size: 2.25rem; font-weight: 900; color: #fff; line-height: 1; }
.rt-stat-box__label { font-size: 0.8rem; color: #64748B; margin-top: 0.3rem; text-align: center; }

/* ── Challenge Cards ── */
.rt-challenge-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 1rem;
}
.rt-challenge-card {
  background: #fff;
  border: 1px solid var(--rt-border);
  border-radius: var(--rt-radius);
  overflow: hidden;
  display: flex;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.rt-challenge-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(37,99,235,0.12); border-color: rgba(37,99,235,0.2); }
.rt-challenge-card__before {
  flex: 1;
  padding: 1.25rem;
  background: #FAFBFC;
}
.rt-challenge-tag {
  display: inline-block;
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  padding: 0.2rem 0.5rem;
  border-radius: 9999px;
  margin-bottom: 0.6rem;
}
.rt-challenge-tag--problem { background: rgba(239,68,68,0.1); color: #EF4444; }
.rt-challenge-tag--solution { background: rgba(16,185,129,0.1); color: #10B981; }
.rt-challenge-card__icon {
  width: 40px; height: 40px;
  background: rgba(37,99,235,0.08);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.6rem;
  color: var(--rt-blue);
}
.rt-challenge-card__before h3 { font-size: 0.88rem; font-weight: 700; color: var(--rt-text-dark); }
.rt-challenge-card__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 0.5rem;
  font-size: 1.2rem;
  color: #CBD5E1;
  flex-shrink: 0;
}
.rt-challenge-card__after {
  flex: 1.1;
  padding: 1.25rem;
  background: rgba(37,99,235,0.03);
  border-left: 1px solid rgba(37,99,235,0.1);
}
.rt-challenge-card__after h3 { font-size: 0.88rem; font-weight: 700; color: var(--rt-blue); margin-bottom: 0.4rem; }
.rt-challenge-card__after p { font-size: 0.8rem; color: var(--rt-text-muted); line-height: 1.5; }

/* ── Bento Grid ── */
.rt-bento-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}
.rt-bento-card {
  background: #fff;
  border: 1px solid var(--rt-border);
  border-radius: var(--rt-radius);
  padding: 1.75rem;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
}
.rt-bento-card--wide { grid-column: span 2; }
.rt-bento-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 16px 40px rgba(0,0,0,0.08);
  border-color: rgba(37,99,235,0.2);
}
.rt-bento-card__icon {
  width: 48px; height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
}
.rt-bento-card__icon--blue { background: rgba(37,99,235,0.1); color: var(--rt-blue); }
.rt-bento-card__icon--emerald { background: rgba(16,185,129,0.1); color: var(--rt-emerald); }
.rt-bento-card__icon--violet { background: rgba(124,58,237,0.1); color: var(--rt-violet); }
.rt-bento-card__icon--amber { background: rgba(245,158,11,0.1); color: var(--rt-amber); }
.rt-bento-card__icon--cyan { background: rgba(6,182,212,0.1); color: var(--rt-cyan); }
.rt-bento-card__icon--rose { background: rgba(244,63,94,0.1); color: var(--rt-rose); }
.rt-bento-card__title { font-size: 1.05rem; font-weight: 700; color: var(--rt-text-dark); margin-bottom: 0.6rem; }
.rt-bento-card__desc { font-size: 0.9rem; line-height: 1.6; color: var(--rt-text-muted); flex: 1; margin-bottom: 1rem; }
.rt-bento-card__link { font-size: 0.85rem; font-weight: 600; color: var(--rt-blue); text-decoration: none; margin-top: auto; }
.rt-bento-card__link:hover { text-decoration: underline; }

/* ── Features Grid ── */
.rt-features-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1rem;
}
.rt-feature-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--rt-radius);
  padding: 1.25rem;
  transition: all 0.3s ease;
}
.rt-feature-card:hover {
  background: rgba(255,255,255,0.07);
  border-color: rgba(59,130,246,0.3);
  transform: translateY(-2px);
}
.rt-feature-card__icon {
  width: 40px; height: 40px;
  background: rgba(59,130,246,0.15);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #60A5FA;
  margin-bottom: 0.75rem;
}
.rt-feature-card h3 { font-size: 0.88rem; font-weight: 700; color: #E2E8F0; margin-bottom: 0.4rem; }
.rt-feature-card p { font-size: 0.78rem; line-height: 1.55; color: #64748B; }

/* ── Industry Grid ── */
.rt-industry-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
}
.rt-industry-card {
  background: #fff;
  border: 1px solid var(--rt-border);
  border-radius: var(--rt-radius);
  padding: 1.5rem;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  cursor: default;
}
.rt-industry-card:hover {
  border-color: rgba(37,99,235,0.3);
  box-shadow: 0 10px 30px rgba(37,99,235,0.1);
  transform: translateY(-2px);
}
.rt-industry-card__icon {
  width: 44px; height: 44px;
  background: rgba(37,99,235,0.08);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--rt-blue);
  margin-bottom: 0.85rem;
}
.rt-industry-card h3 { font-size: 0.95rem; font-weight: 700; color: var(--rt-text-dark); margin-bottom: 0.5rem; }
.rt-industry-card p { font-size: 0.82rem; line-height: 1.55; color: var(--rt-text-muted); padding-bottom: 1.5rem; }
.rt-industry-card__arrow {
  position: absolute;
  bottom: 1rem;
  right: 1.25rem;
  font-size: 1.1rem;
  color: var(--rt-blue);
  opacity: 0;
  transition: opacity 0.2s ease, right 0.2s ease;
}
.rt-industry-card:hover .rt-industry-card__arrow { opacity: 1; right: 1rem; }

/* ── Omnichannel ── */
.rt-omni {
  background: linear-gradient(135deg, #0B1426 0%, #1A2942 60%, #0F1E3A 100%);
  padding: 6rem 0;
  position: relative;
  overflow: hidden;
}
.rt-omni::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 50%, rgba(37,99,235,0.15) 0%, transparent 70%);
}
.rt-omni__content { position: relative; z-index: 1; text-align: center; }
.rt-omni-hub {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 3rem 0;
  min-height: 300px;
}
.rt-omni-center {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
}
.rt-omni-core {
  width: 90px; height: 90px;
  background: linear-gradient(135deg, #2563EB, #7C3AED);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 0.7rem;
  font-weight: 700;
  gap: 0.3rem;
  box-shadow: 0 0 40px rgba(37,99,235,0.4);
}
.rt-omni-ring {
  position: absolute;
  width: 200px; height: 200px;
  border: 1px solid rgba(59,130,246,0.2);
  border-radius: 50%;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  animation: rtRing 8s linear infinite;
}
@keyframes rtRing { to { transform: translate(-50%,-50%) rotate(360deg); } }
.rt-omni-nodes {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 1rem;
  max-width: 900px;
  margin: 0 auto;
  position: relative;
}
.rt-omni-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 1.25rem;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--rt-radius);
  color: #CBD5E1;
  font-size: 0.78rem;
  font-weight: 600;
  transition: all 0.2s ease;
  min-width: 100px;
}
.rt-omni-node:hover { background: rgba(37,99,235,0.15); border-color: rgba(37,99,235,0.4); }
.rt-omni-node__icon {
  width: 38px; height: 38px;
  background: rgba(37,99,235,0.15);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #60A5FA;
}
.rt-omni__cta { margin-top: 3rem; }

/* ── Custom Development ── */
.rt-custom-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}
.rt-custom-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}
.rt-custom-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1rem;
  background: #F8FAFC;
  border: 1px solid var(--rt-border);
  border-radius: 9999px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--rt-text-dark);
  transition: all 0.2s ease;
  cursor: default;
}
.rt-custom-pill:hover { background: rgba(37,99,235,0.06); border-color: rgba(37,99,235,0.25); color: var(--rt-blue); }
.rt-custom-pill svg { color: var(--rt-blue); }

/* ── Technology ── */
.rt-tech-groups {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}
.rt-tech-group {
  display: flex;
  align-items: flex-start;
  gap: 2rem;
}
.rt-tech-group__label {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #94A3B8;
  min-width: 90px;
  padding-top: 0.5rem;
}
.rt-tech-group__cards { display: flex; flex-wrap: wrap; gap: 0.75rem; flex: 1; }
.rt-tech-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 1.25rem;
  background: #fff;
  border: 1px solid var(--rt-border);
  border-radius: var(--rt-radius-sm);
  min-width: 90px;
  transition: all 0.2s ease;
}
.rt-tech-card:hover { border-color: rgba(37,99,235,0.3); box-shadow: 0 4px 16px rgba(0,0,0,0.06); transform: translateY(-2px); }
.rt-tech-card span { font-size: 0.78rem; font-weight: 600; color: var(--rt-text-slate); }

/* ── Benefits ── */
.rt-benefits-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
  margin-bottom: 2rem;
}
.rt-benefit-card {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: var(--rt-radius);
  padding: 2rem 1.75rem;
  transition: all 0.3s ease;
}
.rt-benefit-card:hover { background: rgba(255,255,255,0.07); border-color: rgba(59,130,246,0.3); transform: translateY(-2px); }
.rt-benefit-card__num {
  font-size: 2.5rem;
  font-weight: 900;
  color: #3B82F6;
  line-height: 1;
  margin-bottom: 0.75rem;
  background: linear-gradient(135deg, #3B82F6, #06B6D4);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.rt-benefit-card h3 { font-size: 1rem; font-weight: 700; color: #E2E8F0; margin-bottom: 0.5rem; }
.rt-benefit-card p { font-size: 0.85rem; line-height: 1.6; color: #64748B; }
.rt-metrics-note { text-align: center; font-size: 0.78rem; color: #475569; font-style: italic; }

/* ── Comparison ── */
.rt-comparison {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 2rem;
  align-items: start;
}
.rt-comparison__col { border-radius: var(--rt-radius); overflow: hidden; }
.rt-comparison__col--before { border: 1px solid #FECACA; }
.rt-comparison__col--after { border: 1px solid #A7F3D0; }
.rt-comparison__head {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}
.rt-comparison__col--before .rt-comparison__head { background: #FEF2F2; }
.rt-comparison__col--after .rt-comparison__head { background: #ECFDF5; }
.rt-comparison__head h3 { font-size: 1rem; font-weight: 700; }
.rt-comp-tag {
  display: inline-block;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.2rem 0.6rem;
  border-radius: 9999px;
}
.rt-comp-tag--before { background: rgba(239,68,68,0.1); color: #DC2626; }
.rt-comp-tag--after { background: rgba(16,185,129,0.1); color: #059669; }
.rt-comp-list { list-style: none; padding: 1.25rem 1.5rem; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
.rt-comp-list__item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
}
.rt-comp-list__item--bad { color: #64748B; }
.rt-comp-list__item--good { color: var(--rt-text-dark); font-weight: 500; }
.rt-comparison__divider {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding-top: 6rem;
}
.rt-comp-arrow {
  width: 56px; height: 56px;
  background: linear-gradient(135deg, #2563EB, #7C3AED);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 24px rgba(37,99,235,0.3);
}
.rt-comparison__divider span {
  font-size: 0.75rem;
  font-weight: 700;
