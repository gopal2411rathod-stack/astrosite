            <span class="rt-stat-box__num" data-target="250">0</span><span class="rt-stat-box__plus">+</span>
            <span class="rt-stat-box__label">Projects</span>
          </div>
          <div class="rt-stat-box">
            <span class="rt-stat-box__num" data-target="100">0</span><span class="rt-stat-box__plus">+</span>
