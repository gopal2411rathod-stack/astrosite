---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const finFaqs = [
  {
    question: "What types of finance software do you build?",
    answer: "We build custom financial platforms including accounting systems, payment solutions, billing platforms, expense management systems, financial dashboards, automation tools, and integrated finance applications."
  },
  {
    question: "Can you integrate with our existing financial systems?",
    answer: "Yes. We can design integrations around accounting platforms, ERP systems, payment providers, banking APIs, CRM systems, and other third-party technologies."
  },
  {
    question: "Can you build software for FinTech startups?",
    answer: "Yes. We can support the journey from product strategy and MVP development to scalable production platforms."
  },
  {
    question: "Can you modernize legacy financial software?",
    answer: "Yes. We can gradually modernize legacy systems, improve user experiences, introduce APIs, migrate infrastructure, and integrate modern technologies."
  },
  {
    question: "How do you approach financial data security?",
    answer: "Security is considered throughout architecture, infrastructure, development, authentication, authorization, data protection, integrations, monitoring, and testing."
  },
  {
    question: "Do you provide ongoing support?",
    answer: "Yes. Offer ongoing maintenance, monitoring, security updates, optimization, and feature development."
  }
];

const finSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Finance Software Solutions",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com"
    },
    areaServed: "Global",
    serviceType: "Custom Finance Software Development, Financial Technology Modernization, Payment Systems, Financial Analytics & Automation",
    description: "Build secure, scalable finance software tailored to your workflows. Modernize accounting, payments, billing, financial analytics, automation, and system integrations.",
    url: "https://hegrix.com/industries/finance/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: finFaqs.map(f => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.answer
      }
    }))
  }
];
---

<Layout
  title="Finance Software Solutions | Secure & Scalable Financial Technology | Hegrix"
  description="Build secure, scalable finance software tailored to your workflows. Modernize accounting, payments, billing, financial analytics, automation, and system integrations."
  keywords="Finance software solutions, Financial software development, Finance software development company, FinTech software development, Custom finance software, Financial technology solutions, Financial software solutions, Finance automation software, Payment software development, Financial analytics software"
  path="/industries/finance/"
  schema={finSchema}
>

  <div class="fin-page">

    <!-- ═══════════════════════════════════════
         1. HERO SECTION
    ═══════════════════════════════════════ -->
    <section class="fin-hero">
      <div class="container fin-hero__wrap">
        
        <div class="fin-hero__content">
          <div class="fin-eyebrow">
            <span class="fin-eyebrow__pulse"></span>
            FINANCE SOFTWARE SOLUTIONS
          </div>
          
          <h1 class="fin-hero__title">
            Turn Financial Complexity Into <span class="fin-gradient-text">Business Clarity.</span>
          </h1>

          <p class="fin-hero__lead">
            Build smarter financial operations with secure, scalable software that automates workflows, connects systems, and transforms financial data into actionable insights.
          </p>

          <div class="fin-hero__actions">
            <a href="#contact" class="fin-btn fin-btn--primary fin-btn--lg">
              <span>Talk to a Finance Expert</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="#solutions" class="fin-btn fin-btn--secondary fin-btn--lg">
              <span>Explore Solutions →</span>
            </a>
          </div>

          <!-- Trust Pillars below CTA -->
          <div class="fin-hero__pillars">
            <div class="fin-hero-pillar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Secure Architecture</span>
            </div>
            <div class="fin-hero-pillar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
              <span>Scalable Infrastructure</span>
            </div>
            <div class="fin-hero-pillar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
              <span>Real-Time Insights</span>
            </div>
          </div>

          <!-- Core USP Banner Card -->
          <div class="fin-usp-banner">
            <div class="fin-usp-banner__header">
              <span class="fin-usp-banner__tag">CORE USP</span>
              <span class="fin-usp-banner__line"></span>
            </div>
            <p class="fin-usp-banner__main">
              “Finance software built around the way your business works.”
            </p>
            <p class="fin-usp-banner__sub">
              Secure, scalable, and intelligent financial technology that connects your systems, automates complex workflows, and turns financial data into better decisions.
            </p>
          </div>
        </div>

        <!-- Right Side: Financial Analytics Dashboard UI Mockup -->
        <div class="fin-hero__visual">
          <div class="fin-hero-dashboard">
            <div class="fin-hero-dashboard__header">
              <div class="fin-hero-dashboard__title-wrap">
                <span class="fin-hero-dashboard__status-dot"></span>
                <span class="fin-hero-dashboard__title">Enterprise Financial Engine v4.2</span>
              </div>
              <span class="fin-demo-badge">Sample Demo Data</span>
            </div>

            <!-- Dashboard Key Metrics Grid -->
            <div class="fin-dash-grid">
              <div class="fin-dash-metric">
                <span class="fin-dash-metric__label">Total Revenue</span>
                <div class="fin-dash-metric__val-wrap">
                  <span class="fin-dash-metric__val">$2.84M</span>
                  <span class="fin-dash-metric__badge fin-dash-metric__badge--up">+18.6%</span>
                </div>
              </div>

              <div class="fin-dash-metric">
                <span class="fin-dash-metric__label">Cash Flow</span>
                <div class="fin-dash-metric__val-wrap">
                  <span class="fin-dash-metric__val">$642K</span>
                  <span class="fin-dash-metric__badge fin-dash-metric__badge--up">+12.4%</span>
                </div>
              </div>

              <div class="fin-dash-metric">
                <span class="fin-dash-metric__label">Collection Rate</span>
                <div class="fin-dash-metric__val-wrap">
                  <span class="fin-dash-metric__val">94.8%</span>
                  <span class="fin-dash-metric__badge fin-dash-metric__badge--up">+3.2%</span>
                </div>
              </div>

              <div class="fin-dash-metric">
                <span class="fin-dash-metric__label">Profit Margin</span>
                <div class="fin-dash-metric__val-wrap">
                  <span class="fin-dash-metric__val">39.4%</span>
                  <span class="fin-dash-metric__badge fin-dash-metric__badge--neutral">Optimal</span>
                </div>
              </div>
            </div>

            <!-- Financial Performance Chart Visual -->
            <div class="fin-chart-box">
              <div class="fin-chart-box__header">
                <span class="fin-chart-box__title">Revenue & Expense Trend (30 Days)</span>
                <div class="fin-chart-box__legend">
                  <span class="legend-item legend-item--rev">Revenue</span>
                  <span class="legend-item legend-item--exp">Expenses</span>
                </div>
              </div>

              <div class="fin-chart-graphic">
                <svg viewBox="0 0 500 150" class="fin-chart-svg" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="revGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#06B6D4" stop-opacity="0.3"/>
                      <stop offset="100%" stop-color="#06B6D4" stop-opacity="0"/>
                    </linearGradient>
                    <linearGradient id="expGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.2"/>
                      <stop offset="100%" stop-color="#3B82F6" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  
                  <!-- Grid Lines -->
                  <line x1="0" y1="30" x2="500" y2="30" stroke="#334155" stroke-dasharray="4 4" stroke-opacity="0.3"/>
                  <line x1="0" y1="75" x2="500" y2="75" stroke="#334155" stroke-dasharray="4 4" stroke-opacity="0.3"/>
                  <line x1="0" y1="120" x2="500" y2="120" stroke="#334155" stroke-dasharray="4 4" stroke-opacity="0.3"/>

                  <!-- Revenue Curve & Area -->
                  <path d="M0,110 Q75,70 150,85 T300,45 T450,25 L500,20 L500,150 L0,150 Z" fill="url(#revGrad)"/>
                  <path d="M0,110 Q75,70 150,85 T300,45 T450,25 L500,20" fill="none" stroke="#06B6D4" stroke-width="3"/>

                  <!-- Expense Curve & Area -->
                  <path d="M0,130 Q75,110 150,115 T300,90 T450,70 L500,65 L500,150 L0,150 Z" fill="url(#expGrad)"/>
                  <path d="M0,130 Q75,110 150,115 T300,90 T450,70 L500,65" fill="none" stroke="#3B82F6" stroke-width="2.5" stroke-dasharray="6 2"/>
                </svg>
              </div>
            </div>

            <!-- Recent Stream Activity -->
            <div class="fin-stream">
              <div class="fin-stream__item">
                <span class="fin-stream__dot fin-stream__dot--cyan"></span>
                <span class="fin-stream__text">Accounts Receivable Auto-Reconciled</span>
                <span class="fin-stream__val">+$18,400</span>
              </div>
              <div class="fin-stream__item">
                <span class="fin-stream__dot fin-stream__dot--blue"></span>
                <span class="fin-stream__text">SEPA Batch Settlement Complete</span>
                <span class="fin-stream__val">2,410 Txns</span>
              </div>
            </div>

            <!-- Floating UI Cards overlayed -->
            <div class="fin-float-card fin-float-card--1">
              <div class="fin-float-card__icon fin-float-card__icon--blue">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div>
                <span class="fin-float-card__title">Invoice Paid</span>
                <span class="fin-float-card__sub">+$24,500</span>
              </div>
            </div>

            <div class="fin-float-card fin-float-card--2">
              <div class="fin-float-card__icon fin-float-card__icon--teal">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
              </div>
              <div>
                <span class="fin-float-card__title">Payment Processed</span>
                <span class="fin-float-card__sub">Status: Successful</span>
              </div>
            </div>

            <div class="fin-float-card fin-float-card--3">
              <div class="fin-float-card__icon fin-float-card__icon--blue">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <div>
                <span class="fin-float-card__title">Risk Alert</span>
                <span class="fin-float-card__sub">Score: Low (0.02%)</span>
              </div>
            </div>

            <div class="fin-float-card fin-float-card--4">
              <div class="fin-float-card__icon fin-float-card__icon--cyan">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <span class="fin-float-card__title">Automation Rate</span>
                <span class="fin-float-card__sub">87% Workflows Active</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </section>


    <!-- ═══════════════════════════════════════
         2. TRUST STRIP SECTION
    ═══════════════════════════════════════ -->
    <section class="fin-trust-strip" id="trust">
      <div class="container">
        <h2 class="fin-trust-strip__title">Technology designed for modern financial operations.</h2>
        
        <div class="fin-trust-grid">
          <div class="fin-trust-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Secure by Design</span>
          </div>
          <div class="fin-trust-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            <span>API-First Architecture</span>
          </div>
          <div class="fin-trust-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            <span>Scalable Infrastructure</span>
          </div>
          <div class="fin-trust-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            <span>Real-Time Data</span>
          </div>
          <div class="fin-trust-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            <span>Automated Workflows</span>
          </div>
          <div class="fin-trust-card">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Enterprise Integration</span>
          </div>
        </div>

        <div class="fin-logos">
          <span class="fin-logos__label">Trusted by financial teams & tech innovators worldwide</span>
          <div class="fin-logos__row">
            <div class="fin-logo-item">FINTECH CORP</div>
            <div class="fin-logo-item">NEXUS CAPITAL</div>
            <div class="fin-logo-item">APEX BANKING</div>
            <div class="fin-logo-item">GLOBAL FINANCE</div>
            <div class="fin-logo-item">VERTEX PAYMENTS</div>
            <div class="fin-logo-item">CRESTWOOD TECH</div>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════
         3. PROBLEM SECTION
    ═══════════════════════════════════════ -->
    <section class="fin-section fin-section--light" id="problems">
      <div class="container">
        <div class="fin-section-header fin-section-header--center">
          <div class="fin-badge">THE CHALLENGE</div>
          <h2 class="fin-section-title">
            Financial operations shouldn't be held together by spreadsheets and disconnected systems.
          </h2>
          <p class="fin-section-subtitle">
            Legacy systems, manual processes, fragmented data, and limited visibility can slow financial teams down. We replace complexity with connected, intelligent software designed around your workflows.
          </p>
        </div>

        <div class="fin-problem-grid">
          <!-- Card 1 -->
          <div class="fin-problem-card">
            <div class="fin-problem-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
            </div>
            <h3 class="fin-problem-card__title">Fragmented Financial Systems</h3>
            <p class="fin-problem-card__desc">
              Connect accounting, payments, banking, ERP, CRM, and operational platforms into a single unified ecosystem.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="fin-problem-card">
            <div class="fin-problem-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <h3 class="fin-problem-card__title">Manual Processes</h3>
            <p class="fin-problem-card__desc">
              Automate repetitive financial tasks, approvals, reconciliation, reporting, and complex multi-step workflows.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="fin-problem-card">
            <div class="fin-problem-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3 class="fin-problem-card__title">Limited Visibility</h3>
            <p class="fin-problem-card__desc">
              Bring critical financial data into centralized real-time dashboards and executive reporting frameworks.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="fin-problem-card">
            <div class="fin-problem-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
            <h3 class="fin-problem-card__title">Operational Risk</h3>
            <p class="fin-problem-card__desc">
              Reduce costly human errors, enforce strict access controls, and create audit-ready financial processes.
            </p>
          </div>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════
         4. SOLUTIONS SECTION
    ═══════════════════════════════════════ -->
    <section class="fin-section" id="solutions">
      <div class="container">
        <div class="fin-section-header fin-section-header--center">
          <div class="fin-badge">SOLUTIONS LIFECYCLE</div>
          <h2 class="fin-section-title">
            Software solutions for the entire financial lifecycle.
          </h2>
          <p class="fin-section-subtitle">
            From accounting and payments to financial analytics and automation, we build connected solutions that simplify complex financial operations.
          </p>
        </div>

        <div class="fin-solutions-grid">
          <!-- Solution 01 -->
          <div class="fin-solution-card">
            <div class="fin-solution-card__top">
              <span class="fin-solution-card__num">01</span>
              <div class="fin-solution-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
              </div>
            </div>
            <h3 class="fin-solution-card__title">Financial Management Software</h3>
            <p class="fin-solution-card__desc">
              Centralize financial operations, reporting, budgeting, forecasting, and business performance across entities.
            </p>
            <a href="#contact" class="fin-solution-card__link">
              Explore Solution <span>→</span>
            </a>
          </div>

          <!-- Solution 02 -->
          <div class="fin-solution-card">
            <div class="fin-solution-card__top">
              <span class="fin-solution-card__num">02</span>
              <div class="fin-solution-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h4M6 12h8M6 16h6"/></svg>
              </div>
            </div>
            <h3 class="fin-solution-card__title">Accounting Software</h3>
            <p class="fin-solution-card__desc">
              Modernize accounting workflows including invoicing, expenses, bank reconciliation, reporting, and ledger records.
            </p>
            <a href="#contact" class="fin-solution-card__link">
              Explore Solution <span>→</span>
            </a>
          </div>

          <!-- Solution 03 -->
          <div class="fin-solution-card">
            <div class="fin-solution-card__top">
              <span class="fin-solution-card__num">03</span>
              <div class="fin-solution-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
              </div>
            </div>
            <h3 class="fin-solution-card__title">Payment Solutions</h3>
            <p class="fin-solution-card__desc">
              Build secure payment workflows, transaction processing gateways, multi-currency routing, and settlement tracking.
            </p>
            <a href="#contact" class="fin-solution-card__link">
              Explore Solution <span>→</span>
            </a>
          </div>

          <!-- Solution 04 -->
          <div class="fin-solution-card">
            <div class="fin-solution-card__top">
              <span class="fin-solution-card__num">04</span>
              <div class="fin-solution-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              </div>
            </div>
            <h3 class="fin-solution-card__title">Billing & Invoicing</h3>
            <p class="fin-solution-card__desc">
              Automate recurring subscription billing, invoice generation, payment collection, reminders, and dunning management.
            </p>
            <a href="#contact" class="fin-solution-card__link">
              Explore Solution <span>→</span>
            </a>
          </div>

          <!-- Solution 05 -->
          <div class="fin-solution-card">
            <div class="fin-solution-card__top">
              <span class="fin-solution-card__num">05</span>
              <div class="fin-solution-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
              </div>
            </div>
            <h3 class="fin-solution-card__title">Financial Analytics</h3>
            <p class="fin-solution-card__desc">
              Turn raw financial data into actionable insights with custom executive dashboards, trends, and predictive models.
            </p>
            <a href="#contact" class="fin-solution-card__link">
              Explore Solution <span>→</span>
            </a>
          </div>

          <!-- Solution 06 -->
          <div class="fin-solution-card">
            <div class="fin-solution-card__top">
              <span class="fin-solution-card__num">06</span>
              <div class="fin-solution-card__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
            </div>
            <h3 class="fin-solution-card__title">Expense Management</h3>
            <p class="fin-solution-card__desc">
              Digitize expense submission, mobile receipt scanning, policy controls, multi-level approval, and reimbursement.
            </p>
            <a href="#contact" class="fin-solution-card__link">
              Explore Solution <span>→</span>
            </a>
