<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    
    /* 1. Dashboard Tab Filtering */
    const tabs = document.querySelectorAll('#finDashboardTabs .fin-tab-btn');
    const kpiRevenue = document.getElementById('kpiRevenue');
    const kpiExpenses = document.getElementById('kpiExpenses');
    const kpiProfit = document.getElementById('kpiProfit');
    const kpiCash = document.getElementById('kpiCash');

    const periodData = {
      today: { rev: "$84.2K", exp: "$42.1K", profit: "$42.1K", cash: "$1.24M" },
      "7days": { rev: "$612.4K", exp: "$340.2K", profit: "$272.2K", cash: "$1.24M" },
      "30days": { rev: "$2.84M", exp: "$1.72M", profit: "$684K", cash: "$1.24M" },
      quarter: { rev: "$8.45M", exp: "$5.10M", profit: "$3.35M", cash: "$1.24M" },
      year: { rev: "$34.2M", exp: "$21.8M", profit: "$12.4M", cash: "$1.24M" }
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const period = tab.dataset.period;
        if (periodData[period]) {
          if (kpiRevenue) kpiRevenue.textContent = periodData[period].rev;
          if (kpiExpenses) kpiExpenses.textContent = periodData[period].exp;
          if (kpiProfit) kpiProfit.textContent = periodData[period].profit;
          if (kpiCash) kpiCash.textContent = periodData[period].cash;
        }
      });
    });

    /* 2. Lead Form Submission to Supabase API & Success Modal */
    const form = document.getElementById('finLeadForm');
    const modal = document.getElementById('finSuccessModal');
    const backdrop = document.getElementById('finModalBackdrop');
    const closeBtn = document.getElementById('finModalClose');
    const gotItBtn = document.getElementById('finModalBtn');
    const statusBox = document.getElementById('finFormStatus');
    const submitBtn = document.getElementById('finSubmitBtn');
    const submitText = document.getElementById('finSubmitText');

    function closeModal() {
      if (modal) modal.hidden = true;
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (statusBox) {
          statusBox.hidden = true;
          statusBox.textContent = '';
          statusBox.className = 'fin-form-status';
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = 'Submitting Request...';

        const formData = new FormData(form);
        const name = formData.get('name') || '';
        const email = formData.get('email') || '';
        const company = formData.get('company') || '';
        const phone = formData.get('phone') || '';
        const industry = formData.get('industry') || '';
        const solution = formData.get('solution') || '';
        const message = formData.get('message') || '';

        const payload = {
          fullName: name,
          email: email,
          companyName: company,
          mobileNumber: phone || 'N/A',
          message: `[Industry Sector: ${industry}] [Objective: ${solution}]\n${message}`.trim(),
          sourcePage: "Finance Software Solutions (/industries/finance/)"
        };

        try {
          const response = await fetch('/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.message || 'Error submitting request. Please try again.');
          }

          form.reset();
          if (modal) modal.hidden = false;
        } catch (err) {
          if (statusBox) {
            statusBox.hidden = false;
            statusBox.className = 'fin-form-status fin-form-status--error';
            statusBox.textContent = err.message || 'Connection error. Please try again.';
          }
        } finally {
          if (submitBtn) submitBtn.disabled = false;
          if (submitText) submitText.textContent = 'Start the Conversation';
        }
      });
    }

    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (gotItBtn) gotItBtn.addEventListener('click', closeModal);
  });
</script>
