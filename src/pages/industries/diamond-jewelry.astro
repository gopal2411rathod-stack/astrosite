<Layout
  title="Diamond & Jewelry Software Solutions | Inventory, Manufacturing, POS & CRM | Hegrix"
  description="Transform your diamond and jewelry business with intelligent software. Manage inventory, manufacturing, retail POS, wholesale, CRM, accounting, diamond certificates, and multi-store operations from one powerful platform."
  keywords="diamond jewelry software solutions, jewelry inventory software, diamond inventory system, jewelry POS software, jewelry ERP, diamond certificate management, jewelry manufacturing software, GST jewelry billing, RFID jewelry software"
  path="/industries/diamond-jewelry/"
  schema={djSchema}
>

  <!-- HERO -->
  <section class="dj-hero">
    <div class="container dj-hero-grid">
      <div class="dj-hero-left">
        <p class="eyebrow">Diamond & Jewelry Software Solutions</p>
        <h1>Transform Your Diamond & Jewelry Business with Intelligent Software</h1>
        <p class="lead">
          Manage inventory, manufacturing, retail, wholesale, CRM, accounting, certifications, and multi-store operations from one powerful platform built exclusively for the jewelry industry.
        </p>
        <p class="dj-hero-copy">
          Purpose-built for manufacturers, retailers, traders, and export houses — with GST, GIA/IGI/HRD certificate management, RFID, barcode, and real-time analytics included.
        </p>
        <div class="hero-actions">
          <a class="button" href="/contact-us/">Book a Free Demo</a>
          <a class="button button-ghost" href="/contact-us/">Contact Sales</a>
        </div>
      </div>

      <div class="dj-hero-visual" aria-label="Jewelry Business Platform dashboard preview">
        <div class="dj-dash-top">
          <span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"/></svg>
            Jewelry Operations Center
          </span>
          <strong class="dj-live">● LIVE</strong>
        </div>
        <div class="dj-dash-kpis">
          <div class="dj-kpi">
            <strong>₹2.8 Cr</strong>
            <span>Today's Sales</span>
          </div>
          <div class="dj-kpi">
            <strong>99.8%</strong>
            <span>Inventory Acc.</span>
          </div>
          <div class="dj-kpi">
            <strong>1,248</strong>
            <span>Active Orders</span>
          </div>
          <div class="dj-kpi">
            <strong>3,892</strong>
            <span>Certificates</span>
          </div>
        </div>
        <div class="dj-dash-chart-area">
          <p class="dj-chart-lbl">Revenue Analytics — Weekly</p>
          <div class="dj-bars-row">
            <div class="dj-bar" style="height:42%"><span>M</span></div>
            <div class="dj-bar" style="height:65%"><span>T</span></div>
            <div class="dj-bar" style="height:50%"><span>W</span></div>
            <div class="dj-bar" style="height:82%"><span>T</span></div>
            <div class="dj-bar" style="height:70%"><span>F</span></div>
            <div class="dj-bar dj-bar--hi" style="height:96%"><span>S</span></div>
            <div class="dj-bar" style="height:58%"><span>S</span></div>
          </div>
        </div>
        <div class="dj-flow-pills">
          <span>Inventory</span>
          <span>Manufacturing</span>
          <span>POS</span>
          <span>Diamonds</span>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUSTED BY -->
  <section class="dj-trusted">
    <div class="container">
      <p class="dj-trusted-label">Trusted by Jewelry Manufacturers, Retailers & Diamond Traders</p>
      <div class="dj-trusted-row">
        {["Surat Diamond Exchange", "Jaipur Gems House", "Mumbai Gold Traders", "Delhi Jewels Co.", "Chennai Diamonds", "Kolkata Goldsmiths"].map(name => (
          <div class="dj-trust-chip">{name}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- CHALLENGES -->
  <section class="section soft-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Industry Challenges</p>
        <h2>Problems Costing Your Business Time & Money Every Day</h2>
        <p>The jewelry industry operates with extreme complexity. Manual processes and disconnected systems create costly inefficiencies that are hard to fix without the right platform.</p>
      </div>
      <div class="dj-challenge-grid">
        {challenges.map(c => (
          <article class="dj-challenge-card">
            <div class="dj-challenge-icon-box" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </div>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Why Choose Our Solution</p>
        <h2>Everything Your Jewelry Business Needs in One Platform</h2>
        <p>Purpose-built for the jewelry industry with features no generic ERP can offer. Integrated, intelligent, and designed around how jewelry businesses actually work.</p>
      </div>
      <div class="dj-features-grid">
        {features.map(f => (
          <article class="dj-feature-card">
            <div class="dj-feat-icon" aria-hidden="true" set:html={f.svg} />
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MODULES -->
  <section class="section soft-section" id="modules">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Complete Modules</p>
        <h2>A Complete Jewelry Business Software Suite</h2>
        <p>Every module your business needs, designed to work together seamlessly from inventory to accounting.</p>
      </div>
      <div class="dj-modules-grid">
        {modules.map(mod => (
          <div class="dj-module-card">
            <div class="dj-module-head">
              <div class="dj-mod-icon" aria-hidden="true" set:html={mod.svg} />
              <h3>{mod.title}</h3>
            </div>
            <ul class="dj-mod-list">
              {mod.items.map(item => (
                <li>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Industries We Serve</p>
        <h2>Built for Every Segment of the Jewelry & Diamond Trade</h2>
        <p>Whether you are a manufacturer, retailer, trader, or export house, the platform adapts to your exact workflow and business model.</p>
      </div>
      <div class="dj-industry-grid">
        {industries.map(ind => (
          <article class="dj-industry-card">
            <div class="dj-ind-icon" aria-hidden="true" set:html={ind.svg} />
            <h3>{ind.title}</h3>
            <p>{ind.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="section soft-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Business Benefits</p>
        <h2>Real Results for Jewelry Businesses Like Yours</h2>
        <p>Clients see measurable improvements within weeks of going live. Here are the most common outcomes reported across the network.</p>
      </div>
      <div class="dj-benefits-grid">
        {benefits.map(b => (
          <article class="dj-benefit-card">
            <div class="dj-benefit-icon" aria-hidden="true" set:html={b.svg} />
            <div class="dj-benefit-stat">{b.stat}</div>
            <h3>{b.label}</h3>
            <p>{b.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WORKFLOW -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Business Workflow</p>
        <h2>Your Entire Business Process, Automated End-to-End</h2>
        <p>From purchasing raw materials to generating financial reports, every step is connected and tracked in real time on one platform.</p>
      </div>
      <div class="dj-workflow-grid">
        {workflow.map((w, i) => (
          <div class="dj-wf-item">
            <div class="dj-wf-num">{w.step}</div>
            <div class="dj-wf-icon" aria-hidden="true" set:html={w.svg} />
            <strong>{w.label}</strong>
            <span>{w.desc}</span>
            {i < workflow.length - 1 && <div class="dj-wf-arrow" aria-hidden="true"></div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- STATISTICS -->
  <section class="section dj-stats-section">
    <div class="container">
      <div class="section-heading dj-stats-head">
        <p class="eyebrow dj-eyebrow-light">Our Impact</p>
        <h2 class="dj-h2-light">Numbers That Speak for Themselves</h2>
        <p class="dj-p-light">Measurable outcomes across 500+ jewelry businesses worldwide.</p>
      </div>
      <div class="dj-stats-grid">
        {stats.map(s => (
          <div class="dj-stat-card">
            <div class="dj-stat-icon" aria-hidden="true" set:html={s.svg} />
            <div class="dj-stat-value">{s.value}</div>
            <div class="dj-stat-lbl">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INTEGRATIONS -->
  <section class="section soft-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Integrations</p>
        <h2>Connects with the Tools Your Business Already Uses</h2>
        <p>Plug-and-play integrations with industry-leading platforms for accounting, communication, payments, certifications, and more.</p>
      </div>
      <div class="dj-integrations-grid">
        {integrations.map(intg => (
          <div class="dj-intg-card">
            <div class="dj-intg-icon" aria-hidden="true" set:html={intg.svg} />
            <span>{intg.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Testimonials</p>
        <h2>What Jewelry Business Owners Say</h2>
        <p>Real success stories from jewelry manufacturers, retailers, and diamond traders across India.</p>
      </div>
      <div class="dj-testi-grid">
        {testimonials.map(t => (
          <div class="dj-testi-card">
            <div class="dj-testi-stars" aria-label="5 stars">★★★★★</div>
            <blockquote>"{t.text}"</blockquote>
            <div class="dj-testi-author">
              <div class="dj-testi-avatar">{t.initials}</div>
              <div class="dj-testi-meta">
                <strong>{t.name}</strong>
                <span>{t.role}, {t.company}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section soft-section">
    <div class="container narrow">
      <div class="section-heading">
        <p class="eyebrow">FAQ</p>
        <h2>Frequently Asked Questions</h2>
        <p>Everything you need to know before getting started with Hegrix Jewelry Software.</p>
      </div>
      <div class="faq-list">
        {djFaq.map(f => (
          <details class="dj-faq-item">
            <summary>{f.title}</summary>
            <p>{f.text}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section final-cta">
    <div class="container split-cta">
      <div>
        <p class="eyebrow">Get Started</p>
        <h2>Ready to Modernize Your Jewelry Business?</h2>
        <p>Join 500+ jewelry businesses already running smarter operations with Hegrix. Book a personalized demo and see the platform in action.</p>
      </div>
      <div class="dj-cta-btns">
        <a class="button button-light" href="/contact-us/">Schedule Demo</a>
        <a class="button button-light dj-btn-ghost-light" href="/contact-us/">Talk to an Expert</a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ---- SECTION HEADING ---- */
  .section-heading {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 52px;
  }
  .section-heading h2 { margin-bottom: 14px; }
  .section-heading p { color: var(--muted); font-size: 1.05rem; }

  /* ---- HERO ---- */
  .dj-hero {
    background: linear-gradient(135deg, var(--blue-950) 0%, var(--blue-900) 60%, var(--blue-700) 100%);
    padding: 100px 0 80px;
    overflow: hidden;
  }

  .dj-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .dj-hero-left .eyebrow { color: var(--cyan); }
  .dj-hero-left h1 { color: #fff; font-size: clamp(2rem, 4vw, 3rem); }
  .dj-hero-left .lead { color: rgba(255,255,255,0.72); }
  .dj-hero-copy {
    color: rgba(255,255,255,0.55);
    font-size: 0.92rem;
    margin-top: 16px;
    line-height: 1.65;
  }

  /* Dashboard visual card */
  .dj-hero-visual {
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: var(--radius);
    padding: 22px;
    box-shadow: 0 32px 80px rgba(0,0,0,0.35);
  }

  .dj-dash-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .dj-dash-top span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dj-live {
    background: rgba(11,191,138,0.15);
    color: var(--success);
    padding: 3px 10px;
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    border: 1px solid rgba(11,191,138,0.3);
    animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink { 0%,100%{opacity:1}50%{opacity:.55} }

  .dj-dash-kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 18px;
  }

  .dj-kpi {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: var(--radius-sm);
    padding: 12px;
  }
  .dj-kpi strong {
    display: block;
    font-size: 17px;
    font-weight: 800;
    color: var(--cyan);
    line-height: 1.2;
  }
  .dj-kpi span { font-size: 10px; color: rgba(255,255,255,0.45); font-weight: 500; }

  .dj-dash-chart-area {
    background: rgba(255,255,255,0.04);
    border-radius: var(--radius-sm);
    padding: 14px;
    margin-bottom: 14px;
  }
  .dj-chart-lbl { font-size: 10px; color: rgba(255,255,255,0.4); font-weight: 600; margin-bottom: 12px; }

  .dj-bars-row {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 64px;
  }
  .dj-bar {
    flex: 1;
    background: rgba(11,85,217,0.4);
    border-radius: 4px 4px 0 0;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    transition: background 0.2s;
  }
  .dj-bar--hi { background: var(--blue-700); }
  .dj-bar span {
    position: absolute;
    bottom: -16px;
    font-size: 8px;
    color: rgba(255,255,255,0.35);
    font-weight: 600;
  }

  .dj-flow-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .dj-flow-pills span {
    background: rgba(11,85,217,0.25);
    border: 1px solid rgba(11,85,217,0.4);
    color: var(--cyan);
    font-size: 10px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 100px;
  }

  /* ---- TRUSTED ---- */
  .dj-trusted {
    padding: 36px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--soft);
  }
  .dj-trusted-label {
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .dj-trusted-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .dj-trust-chip {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 9px 18px;
