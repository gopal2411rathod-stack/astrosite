          <div class="dj-kpi"><strong>99.8%</strong><span>Inventory Acc.</span></div>
          <div class="dj-kpi"><strong>1,248</strong><span>Active Orders</span></div>
          <div class="dj-kpi"><strong>3,892</strong><span>Certificates</span></div>
        </div>

        <div class="dj-chart-box">
          <p class="dj-chart-title">Revenue Analytics — Weekly</p>
          <div class="dj-chart-bars">
            <div class="dj-cbar" style="height:42%"><span>M</span></div>
            <div class="dj-cbar" style="height:65%"><span>T</span></div>
            <div class="dj-cbar" style="height:50%"><span>W</span></div>
            <div class="dj-cbar" style="height:82%"><span>T</span></div>
            <div class="dj-cbar" style="height:70%"><span>F</span></div>
            <div class="dj-cbar dj-cbar--hi" style="height:96%"><span>S</span></div>
            <div class="dj-cbar" style="height:58%"><span>S</span></div>
          </div>
        </div>

        <div class="dj-pill-row">
          <span>📦 Inventory</span>
          <span>⚙️ Manufacturing</span>
          <span>🏪 POS</span>
          <span>💎 Diamonds</span>
