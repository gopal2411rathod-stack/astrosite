          </div>
          <h3 class="dj-card-title">Inaccurate Reporting</h3>
          <p class="dj-card-desc">Decisions based on incomplete or outdated reports directly damage profitability and growth.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       WHY CHOOSE
  ═══════════════════════════════════════ -->
  <section class="dj-section">
    <div class="container">
      <div class="dj-section-head">
        <p class="dj-eyebrow">Why Choose Our Solution</p>
        <h2 class="dj-section-title">Everything Your Jewelry Business Needs in One Platform</h2>
