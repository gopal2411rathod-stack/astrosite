  { title: "Manufacturing Delays", desc: "Lack of production tracking creates job work delays and missed delivery commitments to customers." },
  { title: "Stock Mismatch", desc: "Disconnected systems mean physical stock never matches system records, hurting business decisions." },
  { title: "Customer Follow-ups", desc: "Sales teams miss follow-ups leading to lost orders and poor customer relationship management." },
  { title: "Multi-Branch Management", desc: "Managing multiple showrooms without a unified system is chaotic and impossible to scale." },
  { title: "Certificate Tracking", desc: "Diamond certificates get lost or misplaced without a linked digital system for each stone." },
  { title: "Inaccurate Reporting", desc: "Decisions based on incomplete or outdated reports directly damage profitability and growth." },
];

