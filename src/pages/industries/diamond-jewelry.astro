<style>
/* ============================================
   PAGE WRAPPER
============================================ */
.dj-page {
  font-family: var(--font-sans, Inter, sans-serif);
}

/* ============================================
   EYEBROW
============================================ */
.dj-eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--blue-700);
  background: var(--blue-100);
  padding: 4px 12px;
  border-radius: 100px;
  margin-bottom: 14px;
}
.dj-eyebrow--light {
  color: #93c5fd;
  background: rgba(147,197,253,0.15);
}

/* ============================================
   SECTION
============================================ */
.dj-section {
  padding: 92px 0;
}
.dj-section--soft {
  background: var(--soft, #f7fbff);
}
.dj-section--dark {
  background: linear-gradient(135deg, #071a3d 0%, #09265c 60%, #0b55d9 100%);
}
.dj-section--dark2 {
  background: linear-gradient(135deg, #071a3d 0%, #09265c 100%);
}
.dj-section--blue {
  background: linear-gradient(135deg, #071a3d 0%, #09265c 50%, #0b55d9 100%);
}

.dj-section-head {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 56px;
}
.dj-section-title {
  font-size: clamp(1.7rem, 3vw, 2.4rem);
  font-weight: 800;
  color: #071a3d;
  line-height: 1.2;
  letter-spacing: -0.01em;
  margin-bottom: 14px;
}
.dj-section-title--light { color: #fff !important; }
.dj-section-desc {
  font-size: 1rem;
  color: #5b6b82;
  line-height: 1.7;
}
.dj-section-desc--light { color: rgba(255,255,255,0.6) !important; }

/* ============================================
   ICON BOX (used in feature/challenge cards)
============================================ */
.dj-icon-box {
  width: 40px;
  height: 40px;
  background: #eaf3ff;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  flex-shrink: 0;
}

/* ============================================
   HERO SECTION
============================================ */
.dj-hero-section {
  background: linear-gradient(135deg, #071a3d 0%, #09265c 55%, #0b55d9 100%);
  padding: 96px 0 80px;
  overflow: hidden;
}

.dj-hero-wrap {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
}

.dj-hero-h1 {
  font-size: clamp(1.85rem, 3.5vw, 2.8rem) !important;
  font-weight: 800 !important;
  color: #fff !important;
  line-height: 1.15 !important;
  letter-spacing: -0.02em !important;
  max-width: 100% !important;
  margin-bottom: 20px;
}
.dj-accent {
  color: #1fb6ff;
}

.dj-hero-sub {
  font-size: 1rem;
  color: rgba(255,255,255,0.68);
  line-height: 1.7;
  margin-bottom: 22px;
}

.dj-hero-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 28px;
}
.dj-hero-chips span {
  font-size: 12px;
  font-weight: 600;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  padding: 5px 13px;
  border-radius: 100px;
}

.dj-hero-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 28px;
}

.dj-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 24px;
  border-radius: 999px;
  background: #fff;
  color: #0b55d9;
  font-weight: 800;
  font-size: 14px;
  text-decoration: none;
  transition: transform 0.18s, box-shadow 0.18s;
  box-shadow: 0 4px 20px rgba(255,255,255,0.2);
}
.dj-btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(255,255,255,0.3);
}
.dj-btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 24px;
  border-radius: 999px;
  background: transparent;
  color: #fff;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  border: 1.5px solid rgba(255,255,255,0.3);
  transition: background 0.18s, border-color 0.18s;
}
.dj-btn-ghost:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.5);
}
.dj-hero-proof {
  font-size: 13px;
  color: rgba(255,255,255,0.55);
}
.dj-hero-proof strong { color: rgba(255,255,255,0.85); }

/* Dashboard card */
.dj-hero-card {
  background: rgba(255,255,255,0.07);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 18px;
  padding: 22px;
  box-shadow: 0 24px 60px rgba(0,0,0,0.3);
}
.dj-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 11.5px;
  font-weight: 600;
  color: rgba(255,255,255,0.65);
  margin-bottom: 16px;
  padding-bottom: 13px;
  border-bottom: 1px solid rgba(255,255,255,0.1);
}
.dj-card-label {
  display: flex;
  align-items: center;
  gap: 6px;
}
.dj-live-dot {
  font-size: 10px;
  font-weight: 700;
  color: #0bbf8a;
  background: rgba(11,191,138,0.12);
  border: 1px solid rgba(11,191,138,0.3);
  padding: 2px 8px;
  border-radius: 100px;
  animation: djblink 2s ease-in-out infinite;
}
@keyframes djblink { 0%,100%{opacity:1}50%{opacity:.5} }

.dj-kpi-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 16px;
}
.dj-kpi {
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px;
  padding: 11px;
}
.dj-kpi strong {
  display: block;
  font-size: 16px;
  font-weight: 800;
  color: #1fb6ff;
  line-height: 1.2;
}
.dj-kpi span {
  display: block;
  font-size: 10px;
  color: rgba(255,255,255,0.4);
  font-weight: 500;
  margin-top: 2px;
