<script>
  // Counter animation for stats
  function animateCounters() {
    const statValues = document.querySelectorAll('.dj-stat-value');
    statValues.forEach(el => {
      el.style.opacity = '1';
    });
  }

  // Intersection Observer for fade-up animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('dj-visible');
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.dj-stat-card').forEach(el => observer.observe(el));

  // Animate counters when stats section comes into view
  const statsObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        animateCounters();
        statsObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

  const statsSection = document.querySelector('.dj-stats-grid');
  if (statsSection) statsObserver.observe(statsSection);

  // FAQ icon toggle
  document.querySelectorAll('.dj-faq-item').forEach(details => {
    const icon = details.querySelector('.dj-faq-icon');
    if (icon) {
      details.addEventListener('toggle', () => {
        icon.textContent = details.open ? '×' : '+';
      });
    }
  });
</script>
