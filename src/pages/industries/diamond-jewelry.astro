        <span>Surat Diamond Exchange</span>
        <span>Jaipur Gems House</span>
        <span>Mumbai Gold Traders</span>
        <span>Delhi Jewels Co.</span>
        <span>Chennai Diamonds</span>
        <span>Kolkata Goldsmiths</span>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════
       CHALLENGES
  ═══════════════════════════════════════ -->
  <section class="dj-section dj-section--soft">
    <div class="container">
      <div class="dj-section-head">
