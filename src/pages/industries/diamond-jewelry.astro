---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const djFaq = [
  { title: "Is the software cloud-based?", text: "Yes. The platform is 100% cloud-based, accessible from any device, anywhere. No local server installation or maintenance required." },
  { title: "Does it support GST?", text: "Yes. Fully GST-ready with automated tax computation, GST invoice generation, HSN code management, and GST return filing reports built in." },
  { title: "Can I manage multiple branches?", text: "Yes. Multi-branch management is core. Control inventory, sales, staff, and reports across unlimited showrooms and branches from one centralized dashboard." },
  { title: "Does it support barcode and RFID?", text: "Yes. Both barcode and RFID technology are supported for fast, accurate jewelry tagging, POS scanning, stock audits, and inventory movement tracking." },
  { title: "Can it manage diamond certificates?", text: "Yes. GIA, IGI, and HRD certificates can be stored, linked to individual diamonds, and included on invoices. Rapaport pricing and stone-level details are fully supported." },
  { title: "Is training included?", text: "Yes. Hegrix provides comprehensive onboarding, role-based user training, video tutorials, and ongoing support to ensure fast and successful adoption." },
  { title: "Can it integrate with Tally?", text: "Yes. Bidirectional Tally integration is supported, allowing seamless accounting data sync while you transition or maintain a hybrid workflow." },
  { title: "Is mobile access available?", text: "Yes. A fully responsive mobile interface gives sales staff, managers, and owners access to dashboards, inventory, orders, and reports from any smartphone or tablet." },
];

const djSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Diamond & Jewelry Software Solutions",
    provider: { "@type": "Organization", name: "Hegrix", url: "https://hegrix.com" },
    areaServed: "Global",
    serviceType: "Diamond and jewelry ERP, inventory, CRM, POS, manufacturing, and eCommerce software",
    description: "Transform your diamond and jewelry business with intelligent software. Manage inventory, manufacturing, retail POS, wholesale, CRM, accounting, certificates, and multi-store operations from one powerful platform.",
    url: "https://hegrix.com/industries/diamond-jewelry/",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: djFaq.map(f => ({
      "@type": "Question",
      name: f.title,
      acceptedAnswer: { "@type": "Answer", text: f.text },
    })),
  },
];

