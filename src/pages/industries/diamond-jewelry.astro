        </div>

        <div class="dj-feat-card">
          <div class="dj-icon-box"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0b55d9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
