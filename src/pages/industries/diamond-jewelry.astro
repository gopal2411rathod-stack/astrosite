---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const djSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Diamond & Jewelry Software Solutions",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com",
    },
    areaServed: "Global",
    serviceType: "Diamond and jewelry ERP, inventory, CRM, POS, manufacturing, and eCommerce software",
    description: "Transform your diamond and jewelry business with intelligent software. Manage inventory, manufacturing, retail POS, wholesale, CRM, accounting, certificates, and multi-store operations from one powerful platform.",
    url: "https://hegrix.com/industries/diamond-jewelry/",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      { "@type": "Question", name: "Is the software cloud-based?", acceptedAnswer: { "@type": "Answer", text: "Yes. The platform is 100% cloud-based, accessible from any device, anywhere in the world. You do not need to install or maintain local servers." } },
      { "@type": "Question", name: "Does it support GST?", acceptedAnswer: { "@type": "Answer", text: "Yes. The software is fully GST-ready with automated tax computation, GST invoice generation, HSN code management, and GST return filing reports." } },
      { "@type": "Question", name: "Can I manage multiple branches?", acceptedAnswer: { "@type": "Answer", text: "Yes. Multi-branch management is a core feature. You can control inventory, sales, staff, and reports across unlimited showrooms and branches from one centralized dashboard." } },
      { "@type": "Question", name: "Does it support barcode and RFID?", acceptedAnswer: { "@type": "Answer", text: "Yes. The system supports both barcode and RFID technology for fast, accurate jewelry tagging, scanning at POS, stock audits, and inventory movement tracking." } },
      { "@type": "Question", name: "Can it manage diamond certificates?", acceptedAnswer: { "@type": "Answer", text: "Yes. GIA, IGI, and HRD certificates can be stored, linked to individual diamonds, and included on invoices. The system also supports Rapaport pricing and stone-level details." } },
      { "@type": "Question", name: "Is training included?", acceptedAnswer: { "@type": "Answer", text: "Yes. Hegrix provides comprehensive onboarding, role-based user training, video tutorials, and ongoing support to ensure fast and successful adoption across your team." } },
      { "@type": "Question", name: "Can it integrate with Tally?", acceptedAnswer: { "@type": "Answer", text: "Yes. Our platform supports bidirectional integration with Tally, allowing seamless accounting data sync while you transition or maintain a hybrid workflow." } },
      { "@type": "Question", name: "Is mobile access available?", acceptedAnswer: { "@type": "Answer", text: "Yes. A fully responsive mobile app gives sales staff, managers, and business owners access to dashboards, inventory, orders, and reports from any smartphone or tablet." } },
    ],
  },
];

const modules = [
  {
    id: "inventory",
    icon: "💎",
    title: "Inventory Management",
    color: "#D4AF37",
    items: ["Gold Inventory", "Diamond Inventory", "Gemstone Inventory", "Lot Tracking", "Barcode", "RFID", "Stock Transfer"],
  },
  {
    id: "manufacturing",
    icon: "⚙️",
    title: "Manufacturing",
    color: "#B8860B",
    items: ["Production Planning", "Job Work", "Casting", "Polishing", "Stone Setting", "Quality Check", "Cost Tracking"],
  },
  {
    id: "pos",
    icon: "🏪",
    title: "Retail POS",
    color: "#C0A020",
    items: ["Billing", "GST Invoice", "Returns", "Exchange", "Offers", "Discounts"],
  },
  {
    id: "wholesale",
    icon: "📦",
    title: "Wholesale",
    color: "#D4AF37",
    items: ["Quotations", "Bulk Orders", "Customer Pricing", "Export Orders"],
  },
  {
    id: "crm",
    icon: "👥",
    title: "CRM",
    color: "#B8860B",
    items: ["Customer Database", "Follow-ups", "Loyalty Program", "WhatsApp Integration"],
  },
  {
    id: "accounting",
    icon: "📊",
    title: "Accounting",
    color: "#C0A020",
    items: ["Ledger", "Balance Sheet", "Profit & Loss", "GST Reports", "Tax Reports"],
  },
  {
    id: "diamond",
    icon: "💍",
    title: "Diamond Management",
    color: "#D4AF37",
    items: ["GIA Certificates", "IGI Certificates", "HRD Certificates", "Rapaport Pricing", "Stone Details", "Parcel Management"],
  },
  {
    id: "reports",
    icon: "📈",
    title: "Reports",
    color: "#B8860B",
    items: ["Sales Analytics", "Profit Reports", "Inventory Reports", "Manufacturing Reports", "Customer Reports"],
  },
];

const challenges = [
  { icon: "📋", title: "Manual Inventory", desc: "Tracking thousands of SKUs manually leads to errors, delays, and lost revenue." },
  { icon: "❌", title: "Billing Errors", desc: "Manual billing and GST calculations cause compliance issues and customer disputes." },
  { icon: "⏰", title: "Manufacturing Delays", desc: "Lack of production tracking creates job work delays and missed delivery commitments." },
  { icon: "🔀", title: "Stock Mismatch", desc: "Disconnected systems result in physical stock never matching system records." },
  { icon: "📞", title: "Customer Follow-ups", desc: "Sales teams miss follow-ups leading to lost orders and poor customer experience." },
  { icon: "🏢", title: "Multi-Branch Management", desc: "Managing multiple showrooms without a unified system is chaotic and error-prone." },
  { icon: "📜", title: "Certificate Tracking", desc: "Diamond certificates get lost or misplaced without a linked digital system." },
  { icon: "📉", title: "Inaccurate Reporting", desc: "Business decisions based on incomplete or outdated reports impact profitability." },
];

const features = [
  { icon: "☁️", title: "Cloud ERP", desc: "Access your entire business from any device, anywhere, with enterprise-grade uptime." },
  { icon: "📡", title: "Real-Time Inventory", desc: "Instant stock updates across all branches with zero manual intervention." },
  { icon: "🔖", title: "Barcode & RFID", desc: "Lightning-fast item scanning for billing, stock audits, and transfers." },
  { icon: "🤖", title: "AI Analytics", desc: "Predictive insights on sales trends, low stock alerts, and profit opportunities." },
  { icon: "🔒", title: "Secure Cloud Backup", desc: "Military-grade encryption with automated daily backups and disaster recovery." },
  { icon: "📱", title: "Mobile Access", desc: "Full platform access on iOS and Android for managers and field staff." },
  { icon: "🏬", title: "Multi-Branch Support", desc: "Centralized control of unlimited showrooms, warehouses, and outlets." },
  { icon: "🛡️", title: "Role-Based Access", desc: "Granular permissions ensure staff only access what they need." },
  { icon: "🇮🇳", title: "GST Ready", desc: "Automated GST invoice generation, HSN codes, and filing reports built in." },
  { icon: "⚡", title: "Fast Performance", desc: "Sub-second response times even with 20,000+ daily transactions." },
];

const industries = [
  { icon: "💍", title: "Jewelry Manufacturers", desc: "End-to-end manufacturing, quality, and costing workflows." },
  { icon: "💎", title: "Diamond Manufacturers", desc: "Rough diamond to polished stone tracking with certificate management." },
  { icon: "🏪", title: "Jewelry Retail Stores", desc: "POS, billing, customer loyalty, and showroom analytics." },
  { icon: "📦", title: "Jewelry Wholesalers", desc: "Bulk pricing, quotations, trade catalogs, and order management." },
  { icon: "💱", title: "Diamond Traders", desc: "Parcel management, Rapaport pricing, and certificate-linked trading." },
  { icon: "🥇", title: "Gold Traders", desc: "Purity tracking, hallmarking, and gold rate-linked billing." },
  { icon: "🪨", title: "Gemstone Dealers", desc: "Origin, treatment, certification, and gemstone inventory." },
  { icon: "✈️", title: "Export Houses", desc: "Export documentation, international pricing, and compliance." },
  { icon: "🏢", title: "Multi-Store Jewelry Chains", desc: "Centralized inventory, unified reporting, and inter-branch transfers." },
];

const benefits = [
  { icon: "✅", stat: "99.9%", label: "Inventory Accuracy", desc: "Eliminate manual errors and achieve near-perfect stock accuracy." },
  { icon: "⚡", stat: "3x", label: "Faster Billing", desc: "Reduce billing time from minutes to seconds with smart POS." },
  { icon: "🤖", stat: "80%", label: "Reduce Manual Work", desc: "Automate repetitive tasks and free your team for high-value work." },
  { icon: "📈", stat: "+40%", label: "Increase Profitability", desc: "Data-driven decisions improve margins across every category." },
  { icon: "⭐", stat: "5★", label: "Customer Experience", desc: "Delight customers with faster service and personalized interactions." },
  { icon: "📊", stat: "Real-Time", label: "Smart Analytics", desc: "Live dashboards give instant business intelligence anytime." },
  { icon: "🔒", stat: "256-bit", label: "Cloud Security", desc: "Bank-grade encryption protecting every business transaction." },
  { icon: "🔄", stat: "100%", label: "Business Automation", desc: "From purchase to report, automate the entire business lifecycle." },
];

const workflow = [
  { icon: "🛒", step: "Purchase", desc: "Vendor orders, gold/diamond procurement" },
  { icon: "📦", step: "Inventory", desc: "Stock receipt, tagging, valuation" },
  { icon: "⚙️", step: "Manufacturing", desc: "Production orders, job work, casting" },
  { icon: "✅", step: "Quality Check", desc: "Inspection, certifications, approval" },
  { icon: "💰", step: "Sales", desc: "Retail POS, wholesale, eCommerce" },
  { icon: "🧾", step: "Invoice", desc: "GST billing, receipts, certificates" },
  { icon: "📒", step: "Accounting", desc: "Ledger, P&L, balance sheet" },
  { icon: "📊", step: "Reports", desc: "Analytics, insights, forecasting" },
];

const integrations = [
  { icon: "📊", name: "Tally", color: "#0052CC" },
  { icon: "💬", name: "WhatsApp", color: "#25D366" },
  { icon: "📧", name: "Email", color: "#D4AF37" },
  { icon: "📱", name: "SMS", color: "#6B46C1" },
  { icon: "🔖", name: "Barcode Scanner", color: "#B8860B" },
  { icon: "📡", name: "RFID", color: "#0EA5E9" },
  { icon: "💳", name: "Payment Gateway", color: "#EF4444" },
  { icon: "🇮🇳", name: "GST Portal", color: "#F59E0B" },
  { icon: "💎", name: "GIA", color: "#1E40AF" },
  { icon: "🏅", name: "IGI", color: "#6D28D9" },
];

const testimonials = [
  {
    name: "Rajesh Mehta",
    company: "Mehta Diamond House, Surat",
    role: "Managing Director",
    rating: 5,
    avatar: "R",
    avatarColor: "#D4AF37",
    text: "Before Hegrix, our inventory was a nightmare. We had 50,000+ diamonds and no real-time visibility. Now every stone is tracked from rough purchase to GIA-certified sale. Our billing errors dropped to near zero.",
  },
  {
    name: "Priya Jain",
    company: "Jain Jewellers, Mumbai",
    role: "Operations Manager",
    rating: 5,
    avatar: "P",
    avatarColor: "#B8860B",
    text: "The WhatsApp integration changed everything for our CRM. We can now send custom jewelry designs, quotes, and GST invoices directly to customers. Our conversion rate improved by 35% in 3 months.",
  },
  {
    name: "Arun Shah",
    company: "Shah Gold Chains, Ahmedabad",
    role: "CEO",
    rating: 5,
    avatar: "A",
    avatarColor: "#C0A020",
    text: "We have 8 branches across Gujarat and used to spend 3 days on month-end stock reconciliation. Now it takes 2 hours and the data is 99.8% accurate. The multi-branch dashboard is simply outstanding.",
  },
];

const stats = [
  { value: "500+", label: "Businesses Served", icon: "🏢" },
  { value: "20K+", label: "Daily Transactions", icon: "⚡" },
  { value: "99.9%", label: "Accuracy Rate", icon: "✅" },
  { value: "24/7", label: "Expert Support", icon: "🛡️" },
  { value: "15+", label: "Years Experience", icon: "⭐" },
];
---

<Layout
  title="Diamond & Jewelry Software Solutions | Inventory, Manufacturing, POS & CRM | Hegrix"
  description="Transform your diamond and jewelry business with intelligent software. Manage inventory, manufacturing, retail POS, wholesale, CRM, accounting, diamond certificates, and multi-store operations from one powerful platform."
  keywords="diamond jewelry software solutions, jewelry inventory software, diamond inventory system, jewelry POS software, jewelry ERP, diamond certificate management, jewelry manufacturing software, GST jewelry billing, RFID jewelry software"
  path="/industries/diamond-jewelry/"
  schema={djSchema}
>
  <div class="dj-page">

    <!-- ======================== HERO ======================== -->
    <section class="dj-hero">
      <div class="dj-hero-glow dj-hero-glow--tl" aria-hidden="true"></div>
      <div class="dj-hero-glow dj-hero-glow--tr" aria-hidden="true"></div>
      <div class="dj-sparkles" aria-hidden="true">
        <span class="spark spark-1">✦</span>
        <span class="spark spark-2">◆</span>
        <span class="spark spark-3">✦</span>
        <span class="spark spark-4">◇</span>
        <span class="spark spark-5">✦</span>
        <span class="spark spark-6">◆</span>
        <span class="spark spark-7">✦</span>
        <span class="spark spark-8">◇</span>
      </div>

      <div class="container dj-hero-inner">
        <div class="dj-hero-content">
          <div class="dj-eyebrow-badge">
            <span class="dj-badge-gem">💎</span>
            <span>Diamond & Jewelry Software Solutions</span>
          </div>

          <h1 class="dj-hero-title">
            Transform Your Diamond & Jewelry Business with
            <span class="dj-gold-text"> Intelligent Software</span>
          </h1>

          <p class="dj-hero-subtitle">
            Manage inventory, manufacturing, retail, wholesale, CRM, accounting, certifications, and multi-store operations from one powerful platform built exclusively for the jewelry industry.
          </p>

          <div class="dj-hero-tags">
            <span class="dj-tag">✓ GST Ready</span>
            <span class="dj-tag">✓ Cloud-Based</span>
            <span class="dj-tag">✓ GIA / IGI / HRD</span>
            <span class="dj-tag">✓ Multi-Branch</span>
          </div>

          <div class="dj-hero-cta">
            <a href="/contact-us/" class="dj-btn-primary">
              <span>Book a Free Demo</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="/contact-us/" class="dj-btn-secondary">Contact Sales</a>
          </div>

          <div class="dj-hero-proof">
            <div class="dj-stars">★★★★★</div>
            <span class="dj-proof-text"><strong>4.9/5</strong> · Trusted by 500+ jewelry businesses</span>
          </div>
        </div>

        <!-- Dashboard Visual -->
        <div class="dj-hero-visual">
          <div class="dj-dashboard-card">
            <div class="dj-dash-header">
              <span class="dj-dash-title">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                Jewelry Operations Center
              </span>
              <span class="dj-live-badge">● LIVE</span>
            </div>
            <div class="dj-dash-kpis">
              <div class="dj-kpi">
                <span class="dj-kpi-val" style="color:#D4AF37">₹2.8 Cr</span>
                <span class="dj-kpi-lbl">Today's Sales</span>
              </div>
              <div class="dj-kpi">
                <span class="dj-kpi-val" style="color:#22C55E">99.8%</span>
                <span class="dj-kpi-lbl">Inventory Acc.</span>
              </div>
              <div class="dj-kpi">
                <span class="dj-kpi-val" style="color:#0EA5E9">1,248</span>
                <span class="dj-kpi-lbl">Active Orders</span>
              </div>
              <div class="dj-kpi">
                <span class="dj-kpi-val" style="color:#F59E0B">3,892</span>
                <span class="dj-kpi-lbl">Certificates</span>
              </div>
            </div>
            <div class="dj-dash-chart">
              <div class="dj-chart-label">Revenue Analytics</div>
              <div class="dj-bars">
                <div class="dj-bar" style="height:40%"><span>Mon</span></div>
                <div class="dj-bar" style="height:65%"><span>Tue</span></div>
                <div class="dj-bar" style="height:50%"><span>Wed</span></div>
                <div class="dj-bar" style="height:80%"><span>Thu</span></div>
                <div class="dj-bar" style="height:70%"><span>Fri</span></div>
                <div class="dj-bar dj-bar--active" style="height:95%"><span>Sat</span></div>
                <div class="dj-bar" style="height:60%"><span>Sun</span></div>
              </div>
            </div>
            <div class="dj-dash-modules">
              <span class="dj-dash-mod">📦 Inventory</span>
              <span class="dj-dash-mod">⚙️ Manufacturing</span>
              <span class="dj-dash-mod">🏪 POS</span>
              <span class="dj-dash-mod">💎 Diamonds</span>
            </div>
          </div>

          <!-- Floating Cards -->
          <div class="dj-float-card" style="top:-20px;right:-30px;" aria-hidden="true">
            <span>💎</span><span>Diamond Certificates</span>
          </div>
          <div class="dj-float-card" style="top:140px;left:-40px;" aria-hidden="true">
            <span>💍</span><span>Manufacturing Live</span>
          </div>
          <div class="dj-float-card" style="bottom:60px;right:-30px;" aria-hidden="true">
            <span>📊</span><span>GST Reports Ready</span>
          </div>
          <div class="dj-float-card" style="bottom:-20px;left:-20px;" aria-hidden="true">
            <span>🥇</span><span>Gold Rate Synced</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ======================== TRUSTED BY ======================== -->
    <section class="dj-trusted">
      <div class="container">
        <p class="dj-trusted-label">Trusted by Jewelry Manufacturers, Retailers & Diamond Traders</p>
        <div class="dj-trusted-logos">
          {["Surat Diamond Exchange", "Jaipur Gems House", "Mumbai Gold Traders", "Delhi Jewels Co.", "Chennai Diamonds", "Kolkata Goldsmiths"].map(name => (
            <div class="dj-logo-chip">{name}</div>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================== CHALLENGES ======================== -->
    <section class="dj-section dj-section--light">
      <div class="container">
        <div class="dj-section-head">
          <p class="dj-eyebrow">Industry Challenges</p>
          <h2>Problems Costing You Time & Money Every Day</h2>
          <p>The jewelry industry operates with extreme complexity. Manual processes, disconnected systems, and lack of real-time data create costly inefficiencies.</p>
        </div>
        <div class="dj-challenge-grid">
          {challenges.map(c => (
            <div class="dj-challenge-card">
              <span class="dj-challenge-icon" aria-hidden="true">{c.icon}</span>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================== WHY CHOOSE ======================== -->
    <section class="dj-section">
      <div class="container">
        <div class="dj-section-head">
          <p class="dj-eyebrow">Why Choose Our Solution</p>
          <h2>Everything Your Jewelry Business Needs in One Platform</h2>
          <p>Purpose-built for the jewelry industry with features no generic ERP can offer.</p>
        </div>
        <div class="dj-features-grid">
          {features.map(f => (
            <article class="dj-feature-card">
              <span class="dj-feature-icon" aria-hidden="true">{f.icon}</span>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================== MODULES ======================== -->
    <section class="dj-section dj-section--dark" id="modules">
      <div class="container">
        <div class="dj-section-head dj-section-head--light">
          <p class="dj-eyebrow dj-eyebrow--gold">Complete Modules</p>
          <h2 class="dj-title--white">A Complete Jewelry Business Suite</h2>
          <p class="dj-desc--muted">Every module your business needs, designed to work together seamlessly.</p>
        </div>
        <div class="dj-modules-grid">
          {modules.map(mod => (
            <div class="dj-module-card" id={mod.id}>
              <div class="dj-module-header" style={`border-color: ${mod.color}`}>
                <span class="dj-module-icon" aria-hidden="true">{mod.icon}</span>
                <h3 class="dj-module-title">{mod.title}</h3>
              </div>
              <ul class="dj-module-list">
                {mod.items.map(item => (
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================== INDUSTRIES ======================== -->
    <section class="dj-section dj-section--light">
      <div class="container">
        <div class="dj-section-head">
          <p class="dj-eyebrow">Industries We Serve</p>
          <h2>Built for Every Segment of the Jewelry Trade</h2>
          <p>Whether you're a manufacturer, retailer, trader, or export house, our platform adapts to your exact workflow.</p>
        </div>
        <div class="dj-industry-grid">
          {industries.map(ind => (
            <div class="dj-industry-card">
              <span class="dj-industry-icon" aria-hidden="true">{ind.icon}</span>
              <h3>{ind.title}</h3>
              <p>{ind.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================== BENEFITS ======================== -->
    <section class="dj-section">
      <div class="container">
        <div class="dj-section-head">
          <p class="dj-eyebrow">Business Benefits</p>
          <h2>Real Results for Jewelry Businesses Like Yours</h2>
          <p>Our clients see measurable improvements within weeks of going live.</p>
        </div>
        <div class="dj-benefits-grid">
          {benefits.map(b => (
            <div class="dj-benefit-card">
              <span class="dj-benefit-icon" aria-hidden="true">{b.icon}</span>
              <div class="dj-benefit-stat">{b.stat}</div>
              <h3>{b.label}</h3>
              <p>{b.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================== WORKFLOW ======================== -->
    <section class="dj-section dj-section--gold-light">
      <div class="container">
        <div class="dj-section-head">
          <p class="dj-eyebrow">Business Workflow</p>
          <h2>Your Entire Business Process, Automated End-to-End</h2>
          <p>From purchasing raw materials to generating reports, every step is connected and tracked in real time.</p>
        </div>
        <div class="dj-workflow">
          {workflow.map((w, i) => (
            <div class="dj-workflow-item">
              <div class="dj-workflow-bubble">
                <span class="dj-workflow-icon" aria-hidden="true">{w.icon}</span>
              </div>
              <div class="dj-workflow-text">
                <strong>{w.step}</strong>
                <span>{w.desc}</span>
              </div>
              {i < workflow.length - 1 && (
                <div class="dj-workflow-arrow" aria-hidden="true">
                  <span class="dj-arrow-line"></span>
                  <span class="dj-arrow-head">▶</span>
                </div>
              )}
            </div>
          ))}
        </div>
        <div class="dj-workflow-mobile">
          {workflow.map((w, i) => (
            <div class="dj-workflow-mobile-item">
              <div class="dj-workflow-mobile-dot">
                <span aria-hidden="true">{w.icon}</span>
              </div>
              <div class="dj-workflow-mobile-content">
                <strong>{w.step}</strong>
                <span>{w.desc}</span>
              </div>
              {i < workflow.length - 1 && (
                <div class="dj-workflow-mobile-line" aria-hidden="true"></div>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ======================== STATISTICS ======================== -->
    <section class="dj-section dj-section--dark">
      <div class="container">
        <div class="dj-section-head dj-section-head--light">
          <p class="dj-eyebrow dj-eyebrow--gold">Our Impact</p>
          <h2 class="dj-title--white">Numbers That Speak for Themselves</h2>
        </div>
        <div class="dj-stats-grid">
          {stats.map(s => (
