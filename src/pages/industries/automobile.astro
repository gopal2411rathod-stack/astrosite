    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .panel-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--blue-700, #0b55d9);
    background: var(--blue-100, #eaf3ff);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .panel-info h3 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.55rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    margin: 0 0 12px 0;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .panel-info p {
    font-size: 0.95rem;
    color: var(--muted, #5b6b82);
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  .panel-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .panel-checklist li {
    font-size: 0.88rem;
    color: var(--ink, #0f172a);
    position: relative;
    padding-left: 24px;
    line-height: 1.5;
  }

  .panel-checklist li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--blue-700, #0b55d9);
    font-weight: 800;
  }

  .panel-checklist li strong {
    color: var(--blue-950, #071a3d);
  }

  .panel-cta-btn {
    display: inline-flex;
    align-items: center;
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--blue-700, #0b55d9);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .panel-cta-btn:hover {
    transform: translateX(4px);
    text-decoration: underline;
  }

  /* ══════ PANEL MOCKUP BOXES ══════ */
  .mockup-card {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(8, 38, 92, 0.04);
  }

  .mockup-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line, #dce8f7);
  }

  .mockup-pill {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .mockup-pill.green { background: #e6f9f3; color: #059669; }
  .mockup-pill.blue { background: var(--blue-100, #eaf3ff); color: var(--blue-700, #0b55d9); }

  /* Pipeline Preview */
  .lead-pipeline-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .pipeline-column {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 10px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pipe-head {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--muted, #5b6b82);
    text-transform: uppercase;
  }

  .pipe-item {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: 6px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pipe-item.active {
    border-color: var(--blue-700, #0b55d9);
    background: var(--blue-050, #f5f9ff);
  }

  .pipe-item strong {
    font-size: 0.75rem;
    color: var(--blue-950, #071a3d);
  }

  .pipe-item span {
    font-size: 0.65rem;
    color: var(--muted, #5b6b82);
  }

  .pipe-badge {
    align-self: flex-start;
    font-size: 0.6rem;
    font-weight: 700;
    padding: 2px 5px;
    border-radius: 4px;
    margin-top: 2px;
  }

  .pipe-badge.hot { background: #fef2f2; color: #dc2626; }
  .pipe-badge.warm { background: #fef3c7; color: #d97706; }
  .pipe-badge.green { background: #e6f9f3; color: #059669; }
  .pipe-badge.blue { background: var(--blue-100, #eaf3ff); color: var(--blue-700, #0b55d9); }

  /* Inventory Table Preview */
  .inventory-table-preview {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .inv-row {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr 0.8fr;
    align-items: center;
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.75rem;
  }

  .inv-row.header {
    background: var(--blue-050, #f5f9ff);
    font-weight: 800;
    color: var(--muted, #5b6b82);
  }

  .inv-row code {
    font-family: monospace;
    font-weight: 700;
    color: var(--blue-700, #0b55d9);
  }

  .table-pill {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 2px 6px;
    border-radius: 4px;
    text-align: center;
  }

  .table-pill.green { background: #e6f9f3; color: #059669; }
  .table-pill.blue { background: var(--blue-100, #eaf3ff); color: var(--blue-700, #0b55d9); }
  .table-pill.orange { background: #fef3c7; color: #d97706; }

  /* Bay Grid Preview */
  .bay-grid-preview {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .bay-cell {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
  }

  .bay-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    margin-bottom: 4px;
  }

  .bay-cell p {
    font-size: 0.7rem;
    color: var(--muted, #5b6b82);
    margin: 0 0 8px 0;
  }

  .bay-progress {
    height: 6px;
    background: var(--blue-100, #eaf3ff);
    border-radius: 999px;
    overflow: hidden;
  }

  .bay-progress span {
    display: block;
    height: 100%;
    background: var(--blue-700, #0b55d9);
    border-radius: 999px;
  }

  .bay-open-tag {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--blue-700, #0b55d9);
    background: var(--blue-100, #eaf3ff);
    padding: 4px 8px;
    border-radius: 6px;
    text-align: center;
  }

  /* Parts List Preview */
  .parts-list-preview {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .part-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 8px;
    padding: 10px;
  }

  .part-item.alert {
    border-color: #fecaca;
    background: #fff8f8;
  }

  .part-icon-svg {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--blue-100, #eaf3ff);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .part-icon-svg.warn {
    background: #fee2e2;
  }

  .part-details {
    flex: 1;
  }

  .part-details strong {
    display: block;
    font-size: 0.75rem;
    color: var(--blue-950, #071a3d);
  }

  .part-details span {
    font-size: 0.6875rem;
    color: var(--muted, #5b6b82);
  }

  .part-tag {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 3px 6px;
    border-radius: 4px;
  }

  .part-tag.in-stock { background: #e6f9f3; color: #059669; }
  .part-tag.reorder { background: #fef2f2; color: #dc2626; }

  /* Branch Grid Preview */
  .branch-grid-preview {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .branch-stat {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .branch-name {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--blue-950, #071a3d);
  }

  .branch-stat strong {
    font-size: 0.85rem;
    color: var(--blue-700, #0b55d9);
  }

  .stat-growth {
    font-size: 0.7rem;
    font-weight: 800;
  }

  .stat-growth.green { color: #059669; }

  /* ══════ BEFORE VS AFTER COMPARISON ══════ */
  .comparison-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .comparison-card {
    border-radius: var(--radius, 18px);
    padding: 36px;
    border: 1px solid var(--line, #dce8f7);
  }

  .legacy-card {
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(8, 38, 92, 0.03);
  }

  .modern-card {
    background: linear-gradient(180deg, #ffffff 0%, var(--blue-050, #f5f9ff) 100%);
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 18px 45px rgba(11, 85, 217, 0.08);
  }

  .comp-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .comp-badge.bad { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
  .comp-badge.good { background: #eaf3ff; color: var(--blue-700, #0b55d9); border: 1px solid var(--line, #dce8f7); }

  .comparison-card h3 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    margin-bottom: 22px;
    letter-spacing: -0.02em;
  }

  .comp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .comp-list li {
    font-size: 0.92rem;
    color: var(--muted, #5b6b82);
    line-height: 1.55;
    position: relative;
    padding-left: 24px;
  }

  .legacy-card .comp-list li::before {
    content: "✕";
    position: absolute;
    left: 0;
    color: #ef4444;
    font-weight: 800;
  }

  .modern-card .comp-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--blue-700, #0b55d9);
    font-weight: 800;
  }

  .comp-list li strong {
    color: var(--blue-950, #071a3d);
    display: block;
    margin-bottom: 2px;
  }

  /* ══════ BENTO GRID OF 10 MODULES ══════ */
  .modules-bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .bento-card {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: var(--radius, 18px);
    padding: 30px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(8, 38, 92, 0.03);
    transition: all 0.2s ease;
  }

  .bento-card:hover {
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 18px 45px rgba(11, 85, 217, 0.09);
    transform: translateY(-2px);
  }

  .bento-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .bento-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bento-icon-box.blue { background: var(--blue-100, #eaf3ff); }
  .bento-icon-box.green { background: #e6f9f3; }
  .bento-icon-box.purple { background: #f3e8ff; }
  .bento-icon-box.orange { background: #fef3c7; }
  .bento-icon-box.cyan { background: #e0f2fe; }
  .bento-icon-box.red { background: #fee2e2; }

  .bento-tag {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--blue-700, #0b55d9);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bento-card h3 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.22rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    margin: 0 0 8px 0;
    letter-spacing: -0.02em;
  }

  .bento-card p {
    font-size: 0.92rem;
    color: var(--muted, #5b6b82);
    line-height: 1.6;
    margin: 0 0 16px 0;
  }

  .bento-features {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--line, #dce8f7);
    padding-top: 14px;
  }

  .bento-features li {
    font-size: 0.84rem;
    color: var(--ink, #0f172a);
    position: relative;
    padding-left: 20px;
  }

  .bento-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--blue-700, #0b55d9);
    font-weight: 800;
  }

  /* ══════ AUDIENCES ══════ */
  .audiences-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .aud-box {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: var(--radius, 18px);
    padding: 28px;
    transition: all 0.2s ease;
  }

  .aud-box:hover {
    background: #ffffff;
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 14px 35px rgba(8, 38, 92, 0.07);
    transform: translateY(-2px);
  }

  .aud-icon-svg {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--blue-100, #eaf3ff);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .aud-box h3 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    margin: 0 0 8px 0;
    letter-spacing: -0.015em;
  }

  .aud-box p {
    font-size: 0.875rem;
    color: var(--muted, #5b6b82);
    line-height: 1.55;
    margin: 0;
  }

  /* ══════ ROI BANNER ══════ */
  .roi-wrapper {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: var(--radius, 18px);
    padding: 48px 36px;
    box-shadow: 0 16px 45px rgba(8, 38, 92, 0.06);
  }

  .roi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .roi-card {
    text-align: center;
    background: var(--blue-050, #f5f9ff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: 14px;
    padding: 24px 16px;
  }

  .roi-metric {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 2.4rem;
    font-weight: 900;
    color: var(--blue-700, #0b55d9);
    margin-bottom: 4px;
    letter-spacing: -0.03em;
  }

  .roi-title {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .roi-card p {
    font-size: 0.78rem;
    color: var(--muted, #5b6b82);
    margin: 0;
    line-height: 1.45;
  }

  /* ══════ ROADMAP STEPS ══════ */
  .roadmap-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .road-step-card {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: var(--radius, 18px);
    padding: 28px;
    box-shadow: 0 4px 15px rgba(8, 38, 92, 0.03);
  }

  .road-step-badge {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 900;
    color: var(--blue-700, #0b55d9);
    background: var(--blue-100, #eaf3ff);
    display: inline-block;
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 14px;
  }

  .road-step-card h3 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    margin: 0 0 8px 0;
    letter-spacing: -0.015em;
  }

  .road-step-card p {
    font-size: 0.875rem;
    color: var(--muted, #5b6b82);
    line-height: 1.55;
    margin: 0;
  }

  /* ══════ COMPACT 2-COLUMN FAQ SECTION ══════ */
  .faq-compact-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    max-width: 1040px;
    margin: 0 auto;
  }

  .faq-compact-item {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.2s ease;
    align-self: start;
  }

  .faq-compact-item[open] {
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 8px 20px rgba(11, 85, 217, 0.06);
    background: #ffffff;
  }

  .faq-compact-summary {
    padding: 14px 18px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    user-select: none;
    list-style: none;
    letter-spacing: -0.015em;
  }

  .faq-compact-summary::-webkit-details-marker {
    display: none;
  }

  .faq-q-text {
    flex: 1;
    line-height: 1.35;
  }

  .faq-toggle-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--blue-050, #f5f9ff);
    color: var(--blue-700, #0b55d9);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .faq-compact-item[open] .faq-toggle-icon {
    transform: rotate(45deg);
    background: var(--blue-100, #eaf3ff);
  }

  .faq-compact-answer {
    padding: 0 18px 14px 18px;
    font-size: 0.88rem;
    color: var(--muted, #5b6b82);
    line-height: 1.55;
    border-top: 1px dashed rgba(220, 232, 247, 0.8);
    margin-top: 2px;
    padding-top: 10px;
  }

  .faq-compact-answer p {
    margin: 0;
  }

  /* ══════ FINAL CALL TO ACTION BANNER ══════ */
  .cta-banner-section {
    padding: 40px 0 80px 0;
  }

  .cta-banner-card {
    background: linear-gradient(135deg, var(--blue-950, #071a3d) 0%, var(--blue-900, #09265c) 50%, var(--blue-700, #0b55d9) 100%);
    border-radius: var(--radius, 18px);
    padding: 60px 36px;
    text-align: center;
    box-shadow: 0 24px 60px rgba(8, 38, 92, 0.2);
  }

  .cta-banner-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .cta-badge {
    display: inline-block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cyan, #1fb6ff);
    background: rgba(31, 182, 255, 0.15);
    border: 1px solid rgba(31, 182, 255, 0.3);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .cta-banner-content h2 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: clamp(1.9rem, 3.8vw, 2.65rem);
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 16px 0;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .cta-banner-content p {
    font-size: 1.1rem;
    color: var(--blue-100, #eaf3ff);
    line-height: 1.6;
    margin: 0 0 30px 0;
    letter-spacing: -0.01em;
  }

  .cta-banner-actions {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn-banner-white {
    display: inline-flex;
    align-items: center;
