            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <span>Automotive Industry Suite</span>
          </div>

          <h1 class="auto-hero__title">
            Intelligent Software for <br />
            <span class="text-gradient">Automobile Dealers</span> &amp; Service Chains
          </h1>

          <p class="auto-hero__lead">
            Eliminate operational friction across your automotive business. Unify vehicle inventory, showroom CRM, test drive scheduling, digital workshop job cards, auto spare parts catalogs, and multi-branch ERP into one connected ecosystem.
          </p>

          <div class="auto-hero__tags">
            <div class="tag-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>17-Digit VIN Engine</span>
            </div>
            <div class="tag-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>360° Digital Job Cards</span>
            </div>
            <div class="tag-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Barcode / RFID Parts WMS</span>
            </div>
            <div class="tag-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0bbf8a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              <span>Multi-Branch &amp; EV Ready</span>
            </div>
          </div>

          <div class="auto-hero__actions">
            <a href="/contact-us/" class="btn-primary">
              <span>Book a Free Live Demo</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="#interactive-preview" class="btn-secondary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
              <span>Explore Interactive Hub</span>
            </a>
