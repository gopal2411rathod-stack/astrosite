              </div>
              <div class="kpi-cell">
                <span class="kpi-cell__label">Parts Fill Rate</span>
                <strong class="kpi-cell__val">99.4%</strong>
                <span class="kpi-cell__sub neutral">Barcode Synced</span>
              </div>
            </div>

            <!-- Live Operations Feed -->
            <div class="console-feed">
              <div class="feed-header">
                <span>Real-Time Operations Feed</span>
                <span class="feed-sync">Synced Just Now</span>
              </div>

              <div class="feed-row">
