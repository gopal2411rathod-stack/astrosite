---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const automobileFaqs = [
  {
    question: "What is an Automobile Dealer Management System (DMS)?",
    answer: "A DMS is a unified platform connecting vehicle inventory, showroom CRM, test drives, workshop job cards, spare parts WMS, and accounting into one digital system."
  },
  {
    question: "How does the system track vehicles by VIN and variant?",
    answer: "Our 17-digit VIN engine automatically decodes make, trim, engine specs, and transmission, tracking chassis numbers and real-time location across yards."
  },
  {
    question: "How do digital job cards work in workshops?",
    answer: "Advisors conduct 360° photo inspections on check-in, assign bays, dispatch parts, send WhatsApp estimate approvals, and generate invoices upon QA sign-off."
  },
  {
    question: "Can we manage spare parts with barcode and RFID scanning?",
    answer: "Yes. The parts catalog handles OEM and aftermarket cross-references, barcode/RFID scanning, bin locations, and automated minimum stock reorder alerts."
  },
  {
    question: "Does the platform support EV dealerships and battery tracking?",
    answer: "Yes. It includes battery serial number tracking, state-of-charge logs, charging bay schedules, warranty certificates, and subsidy documentation."
  },
  {
    question: "Can the system integrate with Odoo ERP or accounting tools?",
    answer: "Yes. We offer custom Odoo ERP development and bidirectional sync with Tally, QuickBooks, SAP, and payment gateways for automated GST/VAT billing."
  },
  {
    question: "Can multi-branch dealerships be managed centrally?",
    answer: "Yes. Executives gain live visibility into stock aging across all yards, branch sales quotas, bay efficiency, parts transfers, and consolidated P&L."
  },
  {
    question: "How does test drive scheduling work?",
    answer: "The CRM captures omnichannel leads, checks demo car availability, scans digital driver's license KYC, and sends automated WhatsApp follow-ups."
  },
  {
    question: "Can vehicle owners book service on a mobile app?",
    answer: "Yes. We build branded customer mobile apps to book service pick-ups, track live repair stages, approve estimates, and store vehicle documents."
  },
  {
    question: "How do you handle legacy data migration?",
    answer: "Our engineers migrate customer history, vehicle records, parts catalogs, supplier ledgers, and balances with strict validation and zero downtime."
  },
  {
    question: "Does the platform support trade-in appraisals?",
    answer: "Yes. It includes multi-point inspection checklists, refurbishment cost estimation, market benchmarks, and trade-in margin calculations."
  },
  {
    question: "What technical support and SLA are included?",
    answer: "Hegrix provides full onboarding, role-based staff training, continuous cloud monitoring, security updates, and 24/7 technical SLA support."
  }
];

const automobileSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Automobile Software Solutions",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com"
    },
    areaServed: "Global",
    serviceType: "Automobile Dealer Management Software, Vehicle Inventory CRM, Auto Repair Workshop Management, Spare Parts Catalog ERP & Fleet Telematics",
    description: "Transform your automotive business with custom software. Manage vehicle inventory, test drive bookings, digital workshop job cards, auto spare parts, multi-branch dealerships, and customer portals from one intelligent platform.",
    url: "https://hegrix.com/industries/automobile/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: automobileFaqs.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: f.answer
      }
    }))
  }
];
---

<Layout
  title="Automobile Software Solutions | Dealer Management, Vehicle CRM & Workshop ERP | Hegrix"
  description="Transform your dealership, service center, and spare parts business with intelligent automotive software. Connect vehicle inventory, test drive CRM, workshop job cards, parts catalog, and multi-branch accounting in one platform."
  keywords="automobile software solutions, automotive dealer management software, vehicle inventory management software, car dealership CRM, auto repair workshop software, garage job card software, auto spare parts catalog software, automotive ERP, EV dealership software, Odoo automotive development"
  path="/industries/automobile/"
  schema={automobileSchema}
>
  <div class="auto-page">

    <!-- ═══════════════════════════════════════════════════════════════
         HERO SECTION (Refined Typography & Ambient Lighting)
    ═══════════════════════════════════════════════════════════════ -->
    <section class="auto-hero">
      <div class="hero-glow hero-glow--1" aria-hidden="true"></div>
      <div class="hero-glow hero-glow--2" aria-hidden="true"></div>
      <div class="hero-grid-pattern" aria-hidden="true"></div>

      <div class="container auto-hero__wrap">
        <!-- Left: Value Proposition & CTAs -->
        <div class="auto-hero__content">
          <div class="auto-badge">
