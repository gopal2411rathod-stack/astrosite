                </div>
                <div class="feed-details">
                  <strong>WO #8912 &bull; CNC Milling Center 04 (Precision Gear)</strong>
                  <span>Routing: Step 3 of 5 &bull; Cycle Time: 4m 18s (On Schedule)</span>
                </div>
                <span class="status-pill status-service">In Production</span>
              </div>

              <div class="feed-row">
                <div class="feed-icon purple">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                </div>
                <div class="feed-details">
                  <strong>BOM Revision V3.4 &bull; Multilayer Electronics Assembly</strong>
                  <span>ECO-904 Approved &bull; Released to SMT Line Alpha</span>
                </div>
                <span class="status-pill status-bom">BOM Released</span>
              </div>

              <div class="feed-row">
                <div class="feed-icon green">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div class="feed-details">
                  <strong>Batch #QC-4019 &bull; Quality Inspection Passed</strong>
                  <span>Tensile &amp; Dimensional Check &bull; 0.002mm Tolerance Verified</span>
                </div>
                <span class="status-pill status-ready">QC Passed</span>
              </div>
            </div>

            <!-- Quick Workflow Pointers -->
            <div class="console-footer-flow">
              <div class="flow-step done">1. Demand</div>
              <span class="flow-arrow">→</span>
              <div class="flow-step done">2. MRP / BOM</div>
              <span class="flow-arrow">→</span>
              <div class="flow-step active">3. Shop Floor</div>
              <span class="flow-arrow">→</span>
              <div class="flow-step">4. QC &amp; Dispatch</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         INTERACTIVE FACTORY HUB (Client-Side Tab Switcher)
    ═══════════════════════════════════════════════════════════════ -->
    <section class="section soft-section" id="interactive-preview">
      <div class="container">
        <div class="section-header text-center">
          <p class="eyebrow">Interactive Operations Preview</p>
          <h2>Explore How Hegrix Powers Every Stage of Your Production Cycle</h2>
          <p class="section-lead">
            Click through the operational workspaces below to see how production managers, plant engineers, inventory controllers, and quality teams run their daily operations.
          </p>
        </div>

        <div class="interactive-hub">
          <!-- Workspace Navigation Tabs -->
          <div class="hub-tabs" role="tablist">
            <button class="hub-tab active" data-target="tab-mrp" role="tab" aria-selected="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>1. Production &amp; MRP</span>
            </button>
            <button class="hub-tab" data-target="tab-bom" role="tab" aria-selected="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
              <span>2. Multi-Level BOM</span>
            </button>
            <button class="hub-tab" data-target="tab-shopfloor" role="tab" aria-selected="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              <span>3. Shop Floor &amp; OEE</span>
            </button>
            <button class="hub-tab" data-target="tab-inventory" role="tab" aria-selected="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="16.5" y1="9.4" x2="7.5" y2="4.21"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
              <span>4. Inventory &amp; WMS</span>
            </button>
            <button class="hub-tab" data-target="tab-quality" role="tab" aria-selected="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>5. Quality &amp; CMMS</span>
            </button>
          </div>

          <!-- Tab Panels Container -->
          <div class="hub-panels">
            <!-- Tab 1: Production & MRP -->
            <div class="hub-panel active" id="tab-mrp">
              <div class="panel-split">
                <div class="panel-info">
                  <span class="panel-badge">Planning &amp; Scheduling Engine</span>
                  <h3>Automated MRP &amp; Master Production Scheduling (MPS)</h3>
                  <p>Eliminate stockouts, idle machines, and costly production delays. Hegrix calculates raw material requirements, validates machine capacity, monitors supplier lead times, and triggers purchase requisitions automatically.</p>
                  <ul class="panel-checklist">
                    <li><strong>Dynamic MRP Run:</strong> Instant explosion of multi-level demand against current inventory, work-in-progress, and sales backlog.</li>
                    <li><strong>Capacity Requirements Planning (CRP):</strong> Visual machine and labor load balancing to prevent bottleneck work centers.</li>
                    <li><strong>Automated PO Triggers:</strong> Generate supplier purchase orders when components reach dynamic safety reorder levels.</li>
                  </ul>
                  <a href="/contact-us/" class="panel-cta-btn">Explore MRP Planning Features →</a>
                </div>
                <div class="panel-mockup">
                  <div class="mockup-card">
                    <div class="mockup-top">
                      <strong>Production Work Order Pipeline</strong>
                      <span class="mockup-pill blue">48 Active Orders</span>
                    </div>
                    <div class="lead-pipeline-preview">
