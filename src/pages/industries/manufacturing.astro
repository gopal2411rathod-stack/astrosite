    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .aud-box h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--blue-950, #071a3d);
    margin: 0 0 8px 0;
    letter-spacing: -0.015em;
