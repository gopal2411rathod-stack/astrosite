  .feed-icon.blue { background: var(--blue-100, #eaf3ff); }
  .feed-icon.purple { background: #f3e8ff; }

  .feed-details {
    flex: 1;
    min-width: 0;
  }

  .feed-details strong {
    display: block;
    font-size: 0.76rem;
    font-weight: 600;
