    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .aud-box {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: var(--radius, 18px);
    padding: 28px;
