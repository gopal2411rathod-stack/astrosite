  .flow-step {
    padding: 3px 8px;
    background: var(--blue-050, #f5f9ff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: 6px;
    font-weight: 500;
  }

  .flow-step.done {
    background: var(--blue-100, #eaf3ff);
    color: var(--blue-700, #0b55d9);
    font-weight: 600;
  }

  .flow-step.active {
    background: var(--blue-700, #0b55d9);
    color: #ffffff;
    border-color: var(--blue-700, #0b55d9);
    font-weight: 600;
  }

  /* ══════ INTERACTIVE HUB WORKSPACES ══════ */
  .interactive-hub {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: var(--radius, 18px);
    box-shadow: 0 16px 45px rgba(8, 38, 92, 0.06);
    overflow: hidden;
  }

  .hub-tabs {
    display: flex;
    overflow-x: auto;
    background: var(--blue-050, #f5f9ff);
    border-bottom: 1px solid var(--line, #dce8f7);
    padding: 8px 8px 0 8px;
    gap: 6px;
  }

  .hub-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--muted, #5b6b82);
    background: transparent;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 10px 10px 0 0;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .hub-tab:hover {
    color: var(--blue-950, #071a3d);
    background: rgba(255, 255, 255, 0.5);
  }

  .hub-tab.active {
    color: var(--blue-700, #0b55d9);
    background: #ffffff;
    border-color: var(--line, #dce8f7);
    box-shadow: 0 -4px 12px rgba(8, 38, 92, 0.04);
  }

  .hub-panels {
    padding: 36px;
  }

  .hub-panel {
    display: none;
  }

  .hub-panel.active {
    display: block;
    animation: fadeIn 0.25s ease-in-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .panel-badge {
    display: inline-block;
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--blue-700, #0b55d9);
    background: var(--blue-100, #eaf3ff);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
  }

  .panel-info h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--blue-950, #071a3d);
    margin: 0 0 12px 0;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .panel-info p {
    font-size: 0.94rem;
    color: var(--muted, #5b6b82);
    line-height: 1.65;
    margin: 0 0 20px 0;
  }

  .panel-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 24px 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .panel-checklist li {
    font-size: 0.88rem;
    color: var(--ink, #0f172a);
    position: relative;
    padding-left: 24px;
    line-height: 1.55;
  }

  .panel-checklist li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--blue-700, #0b55d9);
    font-weight: 700;
  }

  .panel-checklist li strong {
    color: var(--blue-950, #071a3d);
    font-weight: 600;
  }

  .panel-cta-btn {
    display: inline-flex;
    align-items: center;
    font-family: 'Poppins', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--blue-700, #0b55d9);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .panel-cta-btn:hover {
    transform: translateX(4px);
    text-decoration: underline;
  }

  /* ══════ PANEL MOCKUP BOXES ══════ */
  .mockup-card {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 10px 30px rgba(8, 38, 92, 0.04);
  }

  .mockup-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--blue-950, #071a3d);
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--line, #dce8f7);
  }

  .mockup-pill {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
  }

  .mockup-pill.green { background: #e6f9f3; color: #059669; }
  .mockup-pill.blue { background: var(--blue-100, #eaf3ff); color: var(--blue-700, #0b55d9); }

  /* Pipeline Preview */
  .lead-pipeline-preview {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .pipeline-column {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 10px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pipe-head {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--muted, #5b6b82);
    text-transform: uppercase;
  }

  .pipe-item {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: 6px;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pipe-item.active {
    border-color: var(--blue-700, #0b55d9);
    background: var(--blue-050, #f5f9ff);
  }

  .pipe-item strong {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--blue-950, #071a3d);
  }

  .pipe-item span {
    font-size: 0.65rem;
    color: var(--muted, #5b6b82);
  }

  .pipe-badge {
    align-self: flex-start;
    font-size: 0.6rem;
    font-weight: 600;
    padding: 2px 5px;
    border-radius: 4px;
    margin-top: 2px;
  }

  .pipe-badge.hot { background: #fef2f2; color: #dc2626; }
  .pipe-badge.warm { background: #fef3c7; color: #d97706; }
  .pipe-badge.green { background: #e6f9f3; color: #059669; }
  .pipe-badge.blue { background: var(--blue-100, #eaf3ff); color: var(--blue-700, #0b55d9); }

  /* BOM Tree Preview */
  .bom-tree-preview {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bom-node {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 8px;
    padding: 10px 12px;
  }

  .bom-node.root {
    background: var(--blue-050, #f5f9ff);
    border-color: var(--blue-700, #0b55d9);
  }

  .bom-subnodes {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 12px;
  }

  .bom-node.child {
    position: relative;
  }

  .bom-node.child.indent {
    margin-left: 18px;
  }

  .tree-line {
    color: var(--blue-700, #0b55d9);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .bom-info {
    flex: 1;
    min-width: 0;
  }

  .bom-info strong {
    display: block;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--blue-950, #071a3d);
  }

  .bom-info span {
    font-size: 0.65rem;
    color: var(--muted, #5b6b82);
  }

  .table-pill {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 4px;
    text-align: center;
  }

  .table-pill.green { background: #e6f9f3; color: #059669; }
  .table-pill.blue { background: var(--blue-100, #eaf3ff); color: var(--blue-700, #0b55d9); }
  .table-pill.orange { background: #fef3c7; color: #d97706; }

  /* Bay & Workstation Grid Preview */
  .bay-grid-preview {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .bay-cell {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    flex-direction: column;
  }

  .bay-top {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--blue-950, #071a3d);
    margin-bottom: 4px;
  }

  .status-running {
    font-size: 0.65rem;
    font-weight: 700;
    color: #059669;
    background: #e6f9f3;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .status-setup {
    font-size: 0.65rem;
    font-weight: 700;
    color: #d97706;
    background: #fef3c7;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .bay-cell p {
    font-size: 0.7rem;
    color: var(--muted, #5b6b82);
    margin: 0 0 8px 0;
  }

  .bay-progress {
    height: 6px;
    background: var(--blue-100, #eaf3ff);
    border-radius: 999px;
    overflow: hidden;
  }

  .bay-progress span {
    display: block;
    height: 100%;
    background: var(--blue-700, #0b55d9);
    border-radius: 999px;
  }

  /* Parts & Materials List Preview */
  .parts-list-preview {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .part-item {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 8px;
    padding: 10px;
  }

  .part-item.alert {
    border-color: #fecaca;
    background: #fff8f8;
  }

  .part-icon-svg {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--blue-100, #eaf3ff);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .part-icon-svg.warn {
    background: #fee2e2;
  }

  .part-details {
    flex: 1;
    min-width: 0;
  }

  .part-details strong {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--blue-950, #071a3d);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .part-details span {
    font-size: 0.6875rem;
    color: var(--muted, #5b6b82);
  }

  .part-tag {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 6px;
    border-radius: 4px;
    white-space: nowrap;
  }

  .part-tag.in-stock { background: #e6f9f3; color: #059669; }
  .part-tag.reorder { background: #fef2f2; color: #dc2626; }

  /* Branch & Checkpoint Grid Preview */
  .branch-grid-preview {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .branch-stat {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 10px;
    padding: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .branch-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--blue-950, #071a3d);
  }

  .branch-stat strong {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--blue-700, #0b55d9);
  }

  .stat-growth {
    font-size: 0.7rem;
    font-weight: 700;
  }

  .stat-growth.green { color: #059669; }

  /* ══════ BEFORE VS AFTER COMPARISON ══════ */
  .comparison-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
  }

  .comparison-card {
    border-radius: var(--radius, 18px);
    padding: 36px;
    border: 1px solid var(--line, #dce8f7);
  }

  .legacy-card {
    background: #ffffff;
    box-shadow: 0 8px 24px rgba(8, 38, 92, 0.03);
  }

  .modern-card {
    background: linear-gradient(180deg, #ffffff 0%, var(--blue-050, #f5f9ff) 100%);
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 18px 45px rgba(11, 85, 217, 0.08);
  }

  .comp-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Poppins', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .comp-badge.bad { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
  .comp-badge.good { background: #eaf3ff; color: var(--blue-700, #0b55d9); border: 1px solid var(--line, #dce8f7); }

  .comparison-card h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--blue-950, #071a3d);
    margin-bottom: 22px;
    letter-spacing: -0.02em;
  }

  .comp-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .comp-list li {
    font-size: 0.92rem;
    color: var(--muted, #5b6b82);
    line-height: 1.6;
    position: relative;
    padding-left: 24px;
  }

  .legacy-card .comp-list li::before {
    content: "✕";
    position: absolute;
    left: 0;
    color: #ef4444;
    font-weight: 700;
  }

  .modern-card .comp-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--blue-700, #0b55d9);
    font-weight: 700;
  }

  .comp-list li strong {
    color: var(--blue-950, #071a3d);
    font-weight: 600;
    display: block;
    margin-bottom: 2px;
  }

  /* ══════ BENTO GRID OF 12 MODULES ══════ */
  .modules-bento-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .bento-card {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: var(--radius, 18px);
    padding: 30px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(8, 38, 92, 0.03);
    transition: all 0.2s ease;
  }

  .bento-card:hover {
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 18px 45px rgba(11, 85, 217, 0.09);
    transform: translateY(-2px);
  }

  .bento-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .bento-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bento-icon-box.blue { background: var(--blue-100, #eaf3ff); }
  .bento-icon-box.green { background: #e6f9f3; }
  .bento-icon-box.purple { background: #f3e8ff; }
  .bento-icon-box.orange { background: #fef3c7; }
  .bento-icon-box.cyan { background: #e0f2fe; }
  .bento-icon-box.red { background: #fee2e2; }

  .bento-tag {
    font-family: 'Poppins', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--blue-700, #0b55d9);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bento-card h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--blue-950, #071a3d);
    margin: 0 0 8px 0;
    letter-spacing: -0.015em;
  }

  .bento-card p {
    font-size: 0.92rem;
    color: var(--muted, #5b6b82);
    line-height: 1.65;
    margin: 0 0 16px 0;
  }

  .bento-features {
    list-style: none;
    padding: 0;
    margin: 0;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--line, #dce8f7);
    padding-top: 14px;
