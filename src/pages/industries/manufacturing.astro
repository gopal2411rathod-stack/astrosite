    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feed-details span {
    font-size: 0.6875rem;
    color: var(--muted, #5b6b82);
  }

  .status-pill {
    font-size: 0.64rem;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .status-ready { background: #e6f9f3; color: #059669; }
  .status-service { background: var(--blue-100, #eaf3ff); color: var(--blue-700, #0b55d9); }
  .status-bom { background: #f3e8ff; color: #7c3aed; }

  .console-footer-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--muted, #5b6b82);
