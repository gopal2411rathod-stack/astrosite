    text-align: center;
    background: var(--blue-050, #f5f9ff);
    border: 1px solid var(--line, #dce8f7);
    border-radius: 14px;
    padding: 24px 16px;
  }

  .roi-metric {
    display: block;
    font-family: 'Poppins', sans-serif;
