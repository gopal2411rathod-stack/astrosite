  /* ══════ ROI BANNER ══════ */
  .roi-wrapper {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: var(--radius, 18px);
    padding: 48px 36px;
    box-shadow: 0 16px 45px rgba(8, 38, 92, 0.06);
