                        <div class="pipe-item">
                          <strong>WO-8915 &bull; Pump Assembly</strong>
                          <span>Lot: #P-82 &bull; 250 Units</span>
                          <span class="pipe-badge blue">Materials Ready</span>
                        </div>
                        <div class="pipe-item">
                          <strong>WO-8920 &bull; Valve Housing</strong>
                          <span>Lot: #V-11 &bull; 500 Units</span>
