  .bento-features li {
    font-size: 0.84rem;
    color: var(--ink, #0f172a);
    position: relative;
    padding-left: 20px;
    line-height: 1.5;
  }

  .bento-features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--blue-700, #0b55d9);
    font-weight: 700;
  }

