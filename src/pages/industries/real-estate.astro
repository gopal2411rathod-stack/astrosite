    box-shadow: 0 12px 30px rgba(8, 38, 92, 0.08);
  }
  .re-feat-svg {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--blue-100, #eaf3ff);
    color: var(--blue-700, #0b55d9);
