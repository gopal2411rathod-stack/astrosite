  .re-ben-num {
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--blue-100, #eaf3ff);
    line-height: 1;
    margin-bottom: 12px;
  }
  .re-ben-card h3 {
    font-size: 1.2rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
    margin-bottom: 10px;
  }
  .re-ben-card p {
    font-size: 0.92rem;
    color: var(--muted, #5b6b82);
    line-height: 1.55;
  }

  /* ----------------------------------------------------
     8. IMPLEMENTATION TIMELINE
  ---------------------------------------------------- */
  .re-timeline {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    position: relative;
  }
  .re-tl-item {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    padding: 24px;
    border-radius: 18px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }
  .re-tl-marker {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--blue-700, #0b55d9), var(--cyan, #1fb6ff));
    color: #ffffff;
    font-weight: 900;
    font-size: 1.1rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .re-tl-content h4 {
    font-size: 1.1rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
    margin-bottom: 6px;
  }
  .re-tl-content p {
    font-size: 0.9rem;
    color: var(--muted, #5b6b82);
    line-height: 1.5;
  }

  /* ----------------------------------------------------
     9. WHY CHOOSE US
  ---------------------------------------------------- */
  .re-why-card {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 18px;
    padding: 28px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
    transition: all 0.2s ease;
  }
  .re-why-card:hover {
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 16px 36px rgba(8, 38, 92, 0.08);
    transform: translateY(-3px);
  }
  .re-why-svg-icon {
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--blue-100, #eaf3ff);
    color: var(--blue-700, #0b55d9);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .re-why-card h3 {
    font-size: 1.15rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
    margin-bottom: 6px;
  }
  .re-why-card p {
    font-size: 0.9rem;
    color: var(--muted, #5b6b82);
    line-height: 1.5;
  }

  /* ----------------------------------------------------
     10. SUCCESS METRICS
  ---------------------------------------------------- */
  .re-metrics-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    text-align: center;
  }
  .re-metric-box {
    padding: 16px;
  }
  .re-metric-num {
    font-size: clamp(2.4rem, 4vw, 3.4rem);
    font-weight: 900;
    color: #1fb6ff;
    line-height: 1;
    margin-bottom: 8px;
  }
  .re-metric-label {
    font-size: 0.92rem;
    font-weight: 750;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ----------------------------------------------------
     11. TESTIMONIALS
  ---------------------------------------------------- */
  .re-testi-card {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 20px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .re-testi-stars {
    display: flex;
    gap: 4px;
    margin-bottom: 14px;
  }
  .re-testi-quote {
    font-size: 0.98rem;
    color: var(--ink, #0f172a);
    line-height: 1.65;
    font-style: italic;
    margin-bottom: 24px;
  }
  .re-testi-author {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }
  .re-author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
