    position: relative;
    overflow: hidden;
  }
  .re-dash-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0 0 20px 20px;
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }

  /* Animated Floating Glass Cards */
  .re-float-card {
    position: absolute;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(220, 232, 247, 0.9);
    border-radius: 16px;
    padding: 12px 18px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    display: flex;
    align-items: center;
    gap: 14px;
    z-index: 10;
    color: var(--blue-950, #071a3d);
    animation: reFloatAnim 4s ease-in-out infinite alternate;
  }

  @keyframes reFloatAnim {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-10px); }
  }

  .card-properties {
    top: -20px;
    left: -30px;
  }
  .card-pipeline {
    top: 50px;
    right: -25px;
    animation-delay: 0.7s;
  }
  .card-conversion {
    bottom: 50px;
    left: -40px;
    animation-delay: 1.4s;
  }
  .card-occupancy {
    bottom: -20px;
    right: 20px;
    animation-delay: 2.1s;
  }
  .card-revenue {
    top: 200px;
    right: -35px;
    animation-delay: 1.0s;
  }
  .card-inquiries {
    top: 150px;
    left: -35px;
    animation-delay: 1.8s;
  }

  .re-float-icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: #ffffff;
    flex-shrink: 0;
  }
  .bg-blue { background: linear-gradient(135deg, #0b55d9, #1265f3); }
  .bg-purple { background: linear-gradient(135deg, #7c3aed, #a855f7); }
  .bg-emerald { background: linear-gradient(135deg, #059669, #10b981); }
  .bg-amber { background: linear-gradient(135deg, #d97706, #f59e0b); }
  .bg-cyan { background: linear-gradient(135deg, #0891b2, #06b6d4); }
  .bg-indigo { background: linear-gradient(135deg, #4f46e5, #6366f1); }

  .re-float-title {
    font-size: 0.72rem;
    color: var(--muted, #5b6b82);
    font-weight: 750;
    text-transform: uppercase;
  }
  .re-float-value {
    font-size: 0.98rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
  }
  .re-float-sub {
    font-size: 0.7rem;
    font-weight: 700;
  }
  .text-green { color: #0bbf8a; }

  /* ----------------------------------------------------
     2. WHY REAL ESTATE BUSINESSES NEED THIS SOFTWARE
  ---------------------------------------------------- */
  .re-visual-box {
    position: relative;
  }
  .re-ecosystem-card {
    background: linear-gradient(145deg, #071a3d, #09265c);
    border-radius: 24px;
    padding: 36px;
