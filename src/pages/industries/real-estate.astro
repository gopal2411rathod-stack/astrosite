    color: #ffffff;
    font-weight: 850;
    display: grid;
    place-items: center;
    font-size: 0.95rem;
  }
  .re-testi-author strong {
    color: var(--blue-950, #071a3d);
    font-size: 0.98rem;
  }
  .re-testi-author small {
    color: var(--muted, #5b6b82);
    font-size: 0.82rem;
  }
  .re-testi-outcome {
    background: var(--blue-050, #f5f9ff);
    border: 1px solid var(--blue-100, #eaf3ff);
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.84rem;
    color: var(--blue-700, #0b55d9);
  }

  /* ----------------------------------------------------
     12. FAQ ACCORDION
  ---------------------------------------------------- */
  .re-faq-accordion {
    display: grid;
    gap: 14px;
  }
  .re-faq-item {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .re-faq-item[open] {
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 10px 30px rgba(8, 38, 92, 0.06);
  }
  .re-faq-question {
    padding: 20px 24px;
    font-size: 1.08rem;
    font-weight: 800;
    color: var(--blue-950, #071a3d);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }
  .re-faq-question::-webkit-details-marker { display: none; }
  .re-faq-icon {
    font-size: 1.4rem;
    color: var(--blue-700, #0b55d9);
    font-weight: 400;
    transition: transform 0.2s ease;
  }
  .re-faq-item[open] .re-faq-icon {
    transform: rotate(45deg);
  }
  .re-faq-answer {
    padding: 0 24px 20px 24px;
    font-size: 0.98rem;
    color: var(--muted, #5b6b82);
    line-height: 1.65;
  }

  /* ----------------------------------------------------
     13. FINAL CTA & MODAL
  ---------------------------------------------------- */
  .re-cta-section {
    background: linear-gradient(135deg, var(--blue-950, #071a3d), var(--blue-900, #09265c));
    color: #ffffff;
    text-align: center;
    padding: 100px 0;
  }
  .re-cta-box {
    max-width: 820px;
    margin: 0 auto;
  }
  .re-cta-title {
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 900;
    color: #ffffff;
    margin-bottom: 20px;
    line-height: 1.15;
  }
  .re-cta-desc {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.88);
    margin-bottom: 40px;
    line-height: 1.6;
  }
  .re-cta-actions {
    display: flex;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  /* Modal Backdrop & Dialog */
  .re-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(7, 26, 61, 0.75);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s ease;
  }
  .re-modal-backdrop.is-open {
    opacity: 1;
    visibility: visible;
  }

  .re-modal-dialog {
    background: #ffffff;
    border-radius: 24px;
    max-width: 560px;
    width: 100%;
    padding: 36px;
    position: relative;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
    transform: translateY(20px);
    transition: transform 0.25s ease;
  }
  .re-modal-backdrop.is-open .re-modal-dialog {
    transform: translateY(0);
  }

  .re-modal-close {
    position: absolute;
    top: 20px;
    right: 20px;
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.4rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: var(--muted, #5b6b82);
  }
  .re-modal-close:hover {
    color: var(--blue-950, #071a3d);
    background: var(--line, #dce8f7);
  }

  .re-modal-header {
    margin-bottom: 24px;
  }
  .re-badge-small {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--blue-700, #0b55d9);
    text-transform: uppercase;
    letter-spacing: 0.08em;
