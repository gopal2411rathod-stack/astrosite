  }
  .re-matrix-row:last-child {
    border-bottom: none;
  }
  .re-matrix-row:hover {
    background: var(--soft, #f7fbff);
  }

  .re-mr-cell {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .re-mr-cell strong {
    font-size: 0.98rem;
