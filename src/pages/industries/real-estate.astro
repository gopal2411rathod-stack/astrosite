---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const reFaqList = [
  {
    question: "What is Real Estate Software and how does it help property businesses?",
    answer: "Real Estate Software is an enterprise cloud SaaS platform designed to centralize property listings, lead management, sales CRM, lease contracts, rental collection, and business analytics into a unified digital workspace."
  },
  {
    question: "Can multiple branches and regional sales offices be managed simultaneously?",
    answer: "Yes. Our platform supports multi-branch and multi-region property portfolios. Centralize inventory distribution, agent commissions, project sales pipelines, and financial reporting across all locations from a single dashboard."
  },
  {
    question: "Does the platform include a dedicated CRM for real estate sales teams?",
    answer: "Yes. Built specifically for real estate workflows, our CRM includes buyer preference matching, automated site visit scheduling, lead scoring, WhatsApp integration, quotation generation, and deal stage tracking."
  },
  {
    question: "Can it handle long-term rental properties, leases, and tenant management?",
    answer: "Absoluty. The rental and lease management engine automates tenant onboarding, lease agreement expiration alerts, digital rent collection reminders, security deposit tracking, and maintenance ticketing."
  },
  {
    question: "Is cloud deployment available, or is local server installation required?",
    answer: "Our software is 100% cloud-native (hosted on AWS/Azure), offering 24/7 accessibility from any web browser, tablet, or smartphone without needing local server hardware or maintenance."
  },
  {
    question: "Can the software integrate with Tally, QuickBooks, or third-party ERPs?",
    answer: "Yes. Pre-built REST APIs and connectors enable seamless bidirectional sync with accounting systems (Tally, QuickBooks, Xero), enterprise ERPs (SAP, Oracle, Odoo), payment gateways, and property portals."
  },
  {
    question: "Is the platform customizable for builders, brokers, and property developers?",
    answer: "Yes. We tailor custom workflows, approval hierarchies, booking forms, payment plan milestones, and branded customer portals to fit your specific real estate business model."
  },
  {
    question: "Does the platform include mobile app access for site agents and property managers?",
    answer: "Yes. Native iOS and Android mobile apps empower field agents to conduct site visits, capture buyer feedback, log token payments, upload construction progress photos, and inspect rental units in real time."
  },
  {
    question: "How is client data, buyer information, and financial records secured?",
    answer: "We adhere to ISO 27001, GDPR, and PCI-DSS compliance standards with end-to-end AES-256 data encryption, automated cloud backups, threat detection, and role-based access permissions."
  },
  {
    question: "Do you provide full implementation, legacy data migration, and team training?",
    answer: "Yes. Our expert implementation team handles custom configuration, historical data migration, third-party API integration, role setup, and comprehensive hands-on staff training."
  },
  {
    question: "How does the software accelerate property sales and lead conversion?",
    answer: "By instantly capturing inquiries from your website, portals, WhatsApp, and campaigns, assigning leads to available agents, and triggering automated follow-up sequences to eliminate lead leakage."
  },
  {
    question: "What ongoing support options are included after software deployment?",
    answer: "We provide 24/7 technical support via phone, email, and live chat, along with dedicated account management, regular software feature updates, and SLA uptime guarantees."
  }
];

const reSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Hegrix Real Estate Software Solutions",
    operatingSystem: "Cloud, Web, Windows, macOS, iOS, Android",
    applicationCategory: "BusinessApplication",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock"
    },
    description: "Enterprise SaaS platform for real estate agencies, property developers, builders, brokers, and property management firms. Streamline CRM, listings, sales pipelines, rentals, and analytics."
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Real Estate Software Solutions",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com"
    },
    areaServed: "Global",
    serviceType: "Property Management Software, Real Estate CRM, Builder ERP, Rental Management System, Lease Management",
    description: "Transform your real estate business with intelligent software. Automate property management, lead tracking, sales CRM, rentals, contracts, and financial reporting.",
    url: "https://hegrix.com/industries/real-estate/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: reFaqList.map(item => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title="Real Estate Software Solutions | Enterprise ERP & CRM | Hegrix"
  description="Transform your real estate business with intelligent SaaS. Automate property management, lead tracking, sales CRM, rentals, contracts, and analytics in one platform."
  keywords="real estate software solutions, real estate CRM, property management software, real estate ERP, builder software, tenant management system, real estate sales pipeline"
  path="/industries/real-estate/"
  schema={reSchemaData}
>

<div class="re-page">

  <!-- ═══════════════════════════════════════
       1. HERO SECTION
  ═══════════════════════════════════════ -->
  <section class="re-hero">
    <div class="re-hero-bg-glow1" aria-hidden="true"></div>
    <div class="re-hero-bg-glow2" aria-hidden="true"></div>

    <div class="container re-hero-grid">
      <!-- Left Hero Content -->
      <div class="re-hero-text">
        <div class="re-badge">
          <span class="re-badge-dot"></span>
          <span>Next-Gen Enterprise Real Estate SaaS Platform</span>
        </div>

        <h1 class="re-hero-title">
          Transform Your Real Estate Business with <span class="re-gradient-text">Intelligent Software</span>
        </h1>

        <p class="re-hero-lead">
          Empower real estate agencies, developers, brokers, and property managers with an all-in-one platform to manage properties, automate sales, streamline operations, nurture leads, and deliver exceptional customer experiences.
        </p>

        <div class="re-hero-actions">
          <button class="re-btn re-btn-primary js-open-re-modal">
            <span>Schedule a Demo</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <a href="/contact-us/" class="re-btn re-btn-ghost">
            <span>Talk to an Expert</span>
          </a>
        </div>

        <div class="re-hero-trust">
          <div class="re-trust-stars">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <strong>4.96 / 5</strong>
          </div>
          <div class="re-trust-sep">•</div>
          <div>Trusted by 300+ Real Estate Developers &amp; Agencies Worldwide</div>
        </div>
      </div>

      <!-- Right Hero Dashboard Visual Showcase -->
      <div class="re-hero-visual">
        <div class="re-dash-window">
          <!-- Window Header -->
          <div class="re-dash-header">
            <div class="re-dash-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="re-dash-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M19 21v-4a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v4"/><path d="M5 11l7-7 7 7"/></svg>
              Hegrix Real Estate Operating Platform v5.2
            </div>
            <div class="re-dash-badge">● LIVE ENTERPRISE</div>
          </div>

          <!-- Dashboard Image Showcase -->
          <div class="re-dash-img-wrapper">
            <img src="/images/real-estate-saas-dashboard.png" alt="Hegrix Real Estate Software Solutions Dashboard" class="re-dash-img" loading="eager" />
          </div>
        </div>

        <!-- 6 Animated Floating Glass UI Cards -->
        <!-- Card 1: Active Properties -->
        <div class="re-float-card card-properties">
          <div class="re-float-icon bg-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 21h18"/><path d="M19 21v-4a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v4"/><path d="M5 11l7-7 7 7"/></svg>
          </div>
          <div>
            <div class="re-float-title">Active Properties</div>
            <div class="re-float-value">3,840 Units Managed</div>
            <div class="re-float-sub text-green">Multi-Project Centralized</div>
          </div>
        </div>

        <!-- Card 2: Sales Pipeline -->
        <div class="re-float-card card-pipeline">
          <div class="re-float-icon bg-purple">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          </div>
          <div>
            <div class="re-float-title">Sales Pipeline</div>
            <div class="re-float-value">$142M Active Deals</div>
            <div class="re-float-sub">Automated Lead Tracking</div>
          </div>
        </div>

        <!-- Card 3: Lead Conversion -->
        <div class="re-float-card card-conversion">
          <div class="re-float-icon bg-emerald">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <div>
            <div class="re-float-title">Lead Conversion</div>
            <div class="re-float-value">+38% Lead-to-Sale</div>
            <div class="re-float-sub text-green">WhatsApp &amp; CRM Sync</div>
          </div>
        </div>

        <!-- Card 4: Rental Occupancy -->
        <div class="re-float-card card-occupancy">
          <div class="re-float-icon bg-amber">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          </div>
          <div>
            <div class="re-float-title">Rental Occupancy</div>
            <div class="re-float-value">96.4% Occupancy</div>
            <div class="re-float-sub text-green">Automated Rent Billing</div>
          </div>
        </div>

        <!-- Card 5: Revenue Analytics -->
        <div class="re-float-card card-revenue">
          <div class="re-float-icon bg-cyan">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div>
            <div class="re-float-title">Revenue Analytics</div>
            <div class="re-float-value">$18.4M YTD Volume</div>
            <div class="re-float-sub">Real-Time P&amp;L Insights</div>
          </div>
        </div>

        <!-- Card 6: Customer Inquiries -->
        <div class="re-float-card card-inquiries">
          <div class="re-float-icon bg-indigo">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div>
            <div class="re-float-title">Customer Inquiries</div>
            <div class="re-float-value">Zero Missed Leads</div>
            <div class="re-float-sub text-green">Auto Agent Assignment</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       2. WHY REAL ESTATE BUSINESSES NEED THIS SOFTWARE
  ═══════════════════════════════════════ -->
  <section class="re-section re-section-white">
    <div class="container">
      <div class="re-grid-2 gap-60 items-center">
        <!-- Left: Architecture Diagram Visual -->
        <div class="re-visual-box">
          <div class="re-ecosystem-card">
            <div class="re-eco-header">
              <h3>Enterprise Real Estate Architecture</h3>
              <p>Unified Cloud Operating System</p>
            </div>

            <div class="re-eco-nodes">
              <div class="re-eco-node main-node">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
                <span>Hegrix Real Estate Core Engine</span>
              </div>
              <div class="re-eco-grid">
                <div class="re-eco-item">
                  <div class="re-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M19 21v-4a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v4"/><path d="M5 11l7-7 7 7"/></svg>
                  </div>
                  <div><strong>Property Master</strong><br/><small>Listings &amp; Stock</small></div>
                </div>
                <div class="re-eco-item">
                  <div class="re-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                  </div>
                  <div><strong>Sales &amp; Lead CRM</strong><br/><small>Pipeline &amp; Portal</small></div>
                </div>
                <div class="re-eco-item">
                  <div class="re-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                  </div>
                  <div><strong>Rental &amp; Lease Engine</strong><br/><small>Tenants &amp; Billing</small></div>
                </div>
                <div class="re-eco-item">
                  <div class="re-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                  </div>
                  <div><strong>Builder ERP</strong><br/><small>Projects &amp; Finance</small></div>
                </div>
                <div class="re-eco-item">
                  <div class="re-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  </div>
                  <div><strong>Digital Vault</strong><br/><small>Contracts &amp; e-Sign</small></div>
                </div>
                <div class="re-eco-item">
                  <div class="re-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                  </div>
                  <div><strong>AI Insights Hub</strong><br/><small>Valuations &amp; P&amp;L</small></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Business Transformation Breakdown -->
        <div class="re-content-side">
          <div class="re-eyebrow">Digital Transformation Strategy</div>
          <h2 class="re-section-title">Why Modern Real Estate Enterprises Require Digital Transformation</h2>
          <p class="re-section-desc">
            Spreadsheets, isolated property portals, and paper documentation create critical operational friction that costs real estate businesses deals and profits. In today's fast-moving market, centralized automation is essential for growth.
          </p>

          <!-- 10 Common Challenges Tags -->
          <div class="re-problem-box">
            <h4 class="re-box-subtitle">Common Real Estate Challenges We Eliminate:</h4>
            <div class="re-problem-tags">
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Managing hundreds of property listings
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Manual lead tracking
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Slow follow-ups
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Scattered customer data
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Paper-based documentation
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Inefficient sales processes
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Rental management difficulties
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Lack of business insights
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Missed sales opportunities
              </span>
              <span class="re-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Multiple disconnected systems
              </span>
            </div>
          </div>

          <p class="re-solution-summary">
            Hegrix replaces operational clutter with a <strong>centralized, cloud-native platform connecting CRM, property inventory, automated sales workflows, lease billing, and AI analytics</strong>—delivering maximum productivity and faster sales velocity.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       3. INDUSTRY CHALLENGES VS SOLUTIONS
  ═══════════════════════════════════════ -->
  <section class="re-section re-section-soft">
    <div class="container">
      <div class="re-section-head center">
        <div class="re-eyebrow">Transformation Matrix</div>
        <h2 class="re-section-title">Industry Challenges vs. Hegrix Intelligent Solutions</h2>
        <p class="re-section-desc">Discover how our platform automates real estate operations from lead capture to contract execution.</p>
      </div>

      <div class="re-matrix">
        <!-- Header -->
        <div class="re-matrix-header">
          <div class="col-challenge">Current Operational Challenge</div>
          <div class="col-arrow"></div>
          <div class="col-solution">Hegrix Enterprise SaaS Solution</div>
        </div>

        <!-- Row 1 -->
        <div class="re-matrix-row">
          <div class="re-mr-cell col-challenge">
            <span class="re-status-icon bad">✕</span>
            <div><strong>Manual Property Management</strong><br/><small>Unstructured property data across multiple agent spreadsheets and local files.</small></div>
          </div>
          <div class="re-mr-cell col-arrow">➔</div>
          <div class="re-mr-cell col-solution">
            <span class="re-status-icon good">✓</span>
            <div><strong>Centralized Property Management</strong><br/><small>Single source of truth for all unit inventory, availability, pricing, and floor plans.</small></div>
          </div>
        </div>

        <!-- Row 2 -->
        <div class="re-matrix-row">
          <div class="re-mr-cell col-challenge">
            <span class="re-status-icon bad">✕</span>
            <div><strong>Lost Sales Leads &amp; Slow Follow-ups</strong><br/><small>Inquiries from web portals, social ads, and walk-ins falling through the cracks.</small></div>
          </div>
          <div class="re-mr-cell col-arrow">➔</div>
          <div class="re-mr-cell col-solution">
            <span class="re-status-icon good">✓</span>
            <div><strong>Automated Lead Management</strong><br/><small>Instant lead capture, AI agent matching, and automated WhatsApp/email notifications.</small></div>
          </div>
        </div>

        <!-- Row 3 -->
        <div class="re-matrix-row">
          <div class="re-mr-cell col-challenge">
            <span class="re-status-icon bad">✕</span>
            <div><strong>Delayed Customer Communication</strong><br/><small>Manual site visit scheduling and forgotten client preferences causing buyer drop-off.</small></div>
          </div>
          <div class="re-mr-cell col-arrow">➔</div>
          <div class="re-mr-cell col-solution">
            <span class="re-status-icon good">✓</span>
            <div><strong>CRM Automation Engine</strong><br/><small>Automated buyer profiling, site visit reminders, and personalized proposal generation.</small></div>
          </div>
        </div>

        <!-- Row 4 -->
        <div class="re-matrix-row">
          <div class="re-mr-cell col-challenge">
            <span class="re-status-icon bad">✕</span>
            <div><strong>Poor Document &amp; Contract Control</strong><br/><small>Physical paper contracts causing lost legal paperwork and delayed booking tokens.</small></div>
          </div>
