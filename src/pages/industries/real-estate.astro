     6. CORE FEATURES GRID
  ---------------------------------------------------- */
  .re-grid-feature {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .re-feat-card {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
