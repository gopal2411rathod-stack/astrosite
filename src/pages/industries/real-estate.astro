  .re-sector-card:hover .re-sc-svg-icon {
    background: var(--blue-700, #0b55d9);
    color: #ffffff;
  }
  .re-sector-card h3 {
    font-size: 1.18rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
    margin-bottom: 10px;
  }
  .re-sector-card p {
    font-size: 0.9rem;
    color: var(--muted, #5b6b82);
    line-height: 1.5;
  }

  /* ----------------------------------------------------
     5. COMPREHENSIVE SOLUTIONS
  ---------------------------------------------------- */
  .re-sol-card {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
