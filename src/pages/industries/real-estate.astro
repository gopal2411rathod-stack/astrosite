    align-items: center;
    gap: 6px;
  }
  .re-solution-summary {
    font-size: 1.05rem;
    color: var(--ink, #0f172a);
    line-height: 1.6;
  }

  /* ----------------------------------------------------
     3. BUSINESS CHALLENGES VS SOLUTIONS
  ---------------------------------------------------- */
  .re-matrix {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(8, 38, 92, 0.06);
  }
  .re-matrix-header {
    display: flex;
    background: var(--blue-950, #071a3d);
    color: #ffffff;
    padding: 16px 24px;
    font-weight: 850;
    font-size: 0.95rem;
  }
  .col-challenge { flex: 1; }
  .col-arrow { width: 50px; text-align: center; }
  .col-solution { flex: 1; }

  .re-matrix-row {
    display: flex;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid var(--line, #dce8f7);
