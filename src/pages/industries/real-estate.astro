  }
  .re-mr-cell small {
    color: var(--muted, #5b6b82);
    font-size: 0.86rem;
  }
  .re-status-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 900;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .re-status-icon.bad {
    background: #fee2e2;
    color: #dc2626;
  }
  .re-status-icon.good {
    background: #d1fae5;
    color: #059669;
  }

  /* ----------------------------------------------------
     4. INDUSTRIES WE SERVE
  ---------------------------------------------------- */
  .re-sector-card {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 18px;
    padding: 28px 22px;
    transition: all 0.22s ease;
  }
  .re-sector-card:hover {
    transform: translateY(-5px);
    border-color: var(--blue-700, #0b55d9);
    box-shadow: 0 18px 40px rgba(8, 38, 92, 0.1);
  }
  .re-sc-svg-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--blue-100, #eaf3ff);
