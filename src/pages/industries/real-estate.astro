  .re-sol-top {
    display: flex;
    gap: 18px;
    margin-bottom: 16px;
  }
  .re-sol-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: var(--blue-100, #eaf3ff);
    color: var(--blue-700, #0b55d9);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .re-sol-top h3 {
    font-size: 1.35rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
