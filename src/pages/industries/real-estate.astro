  .re-feat-card h4 {
    font-size: 1.02rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
    margin-bottom: 6px;
  }
  .re-feat-card p {
    font-size: 0.85rem;
    color: var(--muted, #5b6b82);
    line-height: 1.45;
  }

  /* ----------------------------------------------------
     7. BUSINESS BENEFITS
  ---------------------------------------------------- */
  .re-ben-card {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 20px;
    padding: 32px 28px;
    position: relative;
    transition: all 0.22s ease;
  }
  .re-ben-card:hover {
    border-color: var(--blue-700, #0b55d9);
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(8, 38, 92, 0.09);
