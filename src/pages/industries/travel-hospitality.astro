<!-- ═══════════════════════════════════════
     CLIENT-SIDE INTERACTIVE SCRIPT
═══════════════════════════════════════ -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modalBackdrop = document.getElementById('thDemoModal');
    const closeBtn = document.getElementById('thModalCloseBtn');
    const openBtns = document.querySelectorAll('.js-open-th-modal');
    const modalForm = document.getElementById('thModalForm') as HTMLFormElement | null;
    const successMsg = document.getElementById('thSuccessMsg');
    const closeSuccessBtn = document.getElementById('thCloseSuccessBtn');

    // Open Modal
    openBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        if (modalBackdrop) {
          modalBackdrop.classList.add('is-open');
          modalBackdrop.setAttribute('aria-hidden', 'false');
        }
      });
    });

    // Close Modal Function
    const closeModal = () => {
      if (modalBackdrop) {
        modalBackdrop.classList.remove('is-open');
        modalBackdrop.setAttribute('aria-hidden', 'true');
      }
    };

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeSuccessBtn) closeSuccessBtn.addEventListener('click', closeModal);

    // Close on backdrop click
    if (modalBackdrop) {
      modalBackdrop.addEventListener('click', (e) => {
        if (e.target === modalBackdrop) closeModal();
      });
    }

    // Handle Form Submit
    if (modalForm) {
      modalForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('thSubmitBtn');
        if (submitBtn) {
          submitBtn.innerHTML = '<span>Processing...</span>';
          (submitBtn as HTMLButtonElement).disabled = true;
        }

        setTimeout(() => {
          if (modalForm) modalForm.style.display = 'none';
          if (successMsg) successMsg.style.display = 'block';
        }, 800);
      });
    }
  });
</script>
