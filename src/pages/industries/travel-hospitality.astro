        <button type="submit" class="th-btn th-btn-primary th-btn-full" id="thSubmitBtn">
          <span>Submit Request &amp; Book Demo</span>
        </button>

        <p class="th-form-privacy">🔒 Your information is confidential. We respect your privacy.</p>
