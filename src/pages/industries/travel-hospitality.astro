    border-radius: 999px;
  }

  .th-dash-img-wrapper {
    position: relative;
    overflow: hidden;
  }
  .th-dash-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0 0 20px 20px;
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }

  /* Animated Floating Glass Cards */
  .th-float-card {
    position: absolute;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(220, 232, 247, 0.9);
    border-radius: 16px;
    padding: 12px 18px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
