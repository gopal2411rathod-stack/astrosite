  .th-float-value {
    font-size: 0.98rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
  }
  .th-float-sub {
    font-size: 0.7rem;
    font-weight: 700;
  }
  .text-green { color: #0bbf8a; }

  /* ----------------------------------------------------
     2. WHY BUSINESSES NEED THIS SOFTWARE
  ---------------------------------------------------- */
  .th-visual-box {
    position: relative;
  }
  .th-ecosystem-card {
    background: linear-gradient(145deg, #071a3d, #09265c);
