    color: var(--blue-950, #071a3d);
    animation: floatAnim 4s ease-in-out infinite alternate;
  }

  @keyframes floatAnim {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-10px); }
  }

  .card-reservations {
    top: -20px;
    left: -30px;
  }
  .card-occupancy {
    top: 60px;
    right: -25px;
    animation-delay: 0.8s;
  }
  .card-revenue {
    bottom: 40px;
    left: -40px;
    animation-delay: 1.5s;
  }
  .card-satisfaction {
    bottom: -20px;
    right: 20px;
    animation-delay: 2.2s;
  }
  .card-analytics {
    top: 220px;
    right: -35px;
    animation-delay: 1.1s;
  }

  .th-float-icon {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: #ffffff;
    flex-shrink: 0;
  }
  .bg-blue { background: linear-gradient(135deg, #0b55d9, #1265f3); }
  .bg-purple { background: linear-gradient(135deg, #7c3aed, #a855f7); }
  .bg-emerald { background: linear-gradient(135deg, #059669, #10b981); }
  .bg-amber { background: linear-gradient(135deg, #d97706, #f59e0b); }
  .bg-cyan { background: linear-gradient(135deg, #0891b2, #06b6d4); }

  .th-float-title {
    font-size: 0.72rem;
