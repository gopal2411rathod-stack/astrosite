  /* Modal Backdrop & Dialog */
  .th-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(7, 26, 61, 0.75);
    backdrop-filter: blur(10px);
    z-index: 9999;
    display: grid;
    place-items: center;
    padding: 20px;
    opacity: 0;
    visibility: hidden;
