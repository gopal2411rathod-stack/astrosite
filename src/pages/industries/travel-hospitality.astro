  }
  .th-status-icon.good {
    background: #d1fae5;
    color: #059669;
  }

  /* ----------------------------------------------------
     4. INDUSTRIES WE SERVE
  ---------------------------------------------------- */
  .th-sector-card {
    background: #ffffff;
