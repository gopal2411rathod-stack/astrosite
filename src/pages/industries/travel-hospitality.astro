    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .th-why-card h3 {
    font-size: 1.15rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
    margin-bottom: 6px;
  }
  .th-why-card p {
    font-size: 0.9rem;
    color: var(--muted, #5b6b82);
    line-height: 1.5;
