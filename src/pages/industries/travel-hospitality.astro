    font-size: 1.2rem;
    font-weight: 850;
    color: var(--blue-950, #071a3d);
    margin-bottom: 10px;
  }
  .th-ben-card p {
    font-size: 0.92rem;
    color: var(--muted, #5b6b82);
    line-height: 1.55;
  }

  /* ----------------------------------------------------
     8. HOW IT WORKS TIMELINE
  ---------------------------------------------------- */
  .th-timeline {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    position: relative;
  }
  .th-tl-item {
    background: var(--soft, #f7fbff);
    border: 1px solid var(--line, #dce8f7);
