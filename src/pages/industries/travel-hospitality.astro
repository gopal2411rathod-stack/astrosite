  }

  /* ----------------------------------------------------
     3. BUSINESS CHALLENGES VS SOLUTIONS
  ---------------------------------------------------- */
  .th-matrix {
    background: #ffffff;
    border: 1px solid var(--line, #dce8f7);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(8, 38, 92, 0.06);
