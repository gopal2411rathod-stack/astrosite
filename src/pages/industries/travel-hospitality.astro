---
import Layout from "../../layouts/Layout.astro";

export const prerender = true;

const thFaqList = [
  {
    question: "Is the Travel & Hospitality Software platform cloud-based?",
    answer: "Yes, our platform is 100% cloud-native. It operates on enterprise-grade cloud infrastructure (AWS/Azure), accessible 24/7 from any web browser, tablet, or mobile device without installing local servers or software."
  },
  {
    question: "Can this software handle multi-property hotel chains and international resorts?",
    answer: "Absolutely. Our platform is built for enterprise multi-property management. Centralize operations, inventory distribution, pricing, financial reporting, and staff access across unlimited locations, hotel brands, or global branches from a unified dashboard."
  },
  {
    question: "Does the system prevent double-bookings across OTAs like Booking.com and Expedia?",
    answer: "Yes. Integrated real-time channel management automatically synchronizes room availability and rates across 100+ OTAs, GDS platforms, and your direct booking engine in milliseconds, completely eliminating double-bookings."
  },
  {
    question: "Can it integrate with our existing ERP, accounting, and payment gateways?",
    answer: "Yes. Our software features open RESTful APIs and pre-built connectors for major ERPs (Oracle, SAP, Odoo, Salesforce), accounting software (Tally, QuickBooks, Xero), payment gateways (Stripe, Razorpay, PayPal), and keycard door lock systems."
  },
  {
    question: "How does the software improve guest check-in and room experience?",
    answer: "Guests receive contactless check-in links via WhatsApp or email prior to arrival. They can upload IDs, complete registration, choose rooms, request amenities, and receive digital keycards directly on their smartphones."
  },
  {
    question: "Is the booking engine customizable for tour operators and travel agencies?",
    answer: "Yes. The travel agency and tour operator engine supports dynamic package creation, multi-city itineraries, custom flight/hotel combinations, group discounts, markup rules, and automated B2B travel agent portals."
  },
  {
    question: "Does the software support multi-currency, multi-language, and local tax compliance?",
    answer: "Yes. The platform natively handles 150+ currencies, multi-language guest interfaces, automated exchange rate sync, and localized tax structures including GST, VAT, city tax, and tourism levies."
  },
  {
    question: "What security compliance and data privacy standards are met?",
    answer: "We adhere to ISO 27001, GDPR, PCI-DSS Level 1 compliance, and end-to-end data encryption (AES-256 in transit and at rest). Role-based access control ensures strict security compliance for all staff activity."
  },
  {
    question: "Can we track housekeeping operations and maintenance requests in real time?",
    answer: "Yes. Housekeeping teams receive real-time room status updates on their mobile app, complete room checklists, upload inspection photos, and immediately report maintenance issues to engineering teams."
  },
  {
    question: "How long does system setup and team onboarding take?",
    answer: "Standard implementations take 2 to 4 weeks, while enterprise multi-property deployments average 4 to 8 weeks. Our dedicated implementation team handles data migration, system configuration, staff training, and go-live support."
  },
  {
    question: "Does the platform offer AI-powered dynamic pricing and revenue management?",
    answer: "Yes. Built-in AI models analyze market demand, competitor rates, historical occupancy, local events, and seasonal trends to automatically optimize room rates and maximize RevPAR (Revenue Per Available Room)."
  },
  {
    question: "What support options are available after deployment?",
    answer: "We provide 24/7 technical support via phone, email, and live chat, along with dedicated account managers, continuous security updates, SLA guarantees, and regular feature releases."
  }
];

const thSchemaData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Hegrix Travel & Hospitality Software Solutions",
    operatingSystem: "Cloud, Web, Windows, macOS, iOS, Android",
    applicationCategory: "BusinessApplication",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock"
    },
    description: "Enterprise SaaS platform for hotels, resorts, travel agencies, and tour operators. Streamline PMS, CRM, reservations, channel management, housekeeping, and revenue analytics."
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Travel & Hospitality Software Solutions",
    provider: {
      "@type": "Organization",
      name: "Hegrix",
      url: "https://hegrix.com"
    },
    areaServed: "Global",
    serviceType: "Hotel Management Software, Property Management System (PMS), Travel Agency Software, Tour Operator ERP & CRM",
    description: "Transform every guest journey with enterprise travel & hospitality software. Streamline bookings, automate operations, enhance guest satisfaction, and drive sustainable growth.",
    url: "https://hegrix.com/industries/travel-hospitality/"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: thFaqList.map(item => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer
      }
    }))
  }
];
---

<Layout
  title="Travel & Hospitality Software Solutions | Enterprise PMS, ERP & CRM | Hegrix"
  description="Transform your travel & hospitality business with intelligent SaaS. Automate bookings, room availability, guest check-in, PMS, CRM, and analytics in one platform."
  keywords="travel hospitality software solutions, hotel management software, travel agency software, property management system, hospitality ERP, tour operator software, vacation rental management, booking engine SaaS"
  path="/industries/travel-hospitality/"
  schema={thSchemaData}
>

<div class="th-page">

  <!-- ═══════════════════════════════════════
       1. HERO SECTION (ENHANCED WITH GENERATED DASHBOARD IMAGE & GLASS CARDS)
  ═══════════════════════════════════════ -->
  <section class="th-hero">
    <div class="th-hero-bg-glow1" aria-hidden="true"></div>
    <div class="th-hero-bg-glow2" aria-hidden="true"></div>

    <div class="container th-hero-grid">
      <!-- Left Hero Content -->
      <div class="th-hero-text">
        <div class="th-badge">
          <span class="th-badge-dot"></span>
          <span>Enterprise Travel &amp; Hospitality SaaS Platform</span>
        </div>

        <h1 class="th-hero-title">
          Transform Every Guest Journey with <span class="th-gradient-text">Intelligent Software</span>
        </h1>

        <p class="th-hero-lead">
          Empower hotels, resorts, travel agencies, tour operators, and hospitality businesses with a unified software platform that streamlines bookings, automates operations, enhances guest experiences, and drives sustainable growth.
        </p>

        <div class="th-hero-actions">
          <button class="th-btn th-btn-primary js-open-th-modal">
            <span>Book Free Demo</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
          <a href="/contact-us/" class="th-btn th-btn-ghost">
            <span>Talk to an Expert</span>
          </a>
        </div>

        <div class="th-hero-trust">
          <div class="th-trust-stars">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffc107" stroke="#ffc107"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <strong>4.95 / 5</strong>
          </div>
          <div class="th-trust-sep">•</div>
          <div>Trusted by 250+ Global Hospitality Brands</div>
        </div>
      </div>

      <!-- Right Hero Dashboard Visual with High-Res Image Showcase -->
      <div class="th-hero-visual">
        <div class="th-dash-window">
          <!-- Window Header -->
          <div class="th-dash-header">
            <div class="th-dash-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="th-dash-title">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
              Hegrix Hospitality Operating Platform
            </div>
            <div class="th-dash-badge">● LIVE SYSTEM</div>
          </div>

          <!-- Dashboard Image Showcase -->
          <div class="th-dash-img-wrapper">
            <img src="/images/travel-hospitality-dashboard.png" alt="Hegrix Travel & Hospitality Software Enterprise Dashboard" class="th-dash-img" loading="eager" />
          </div>
        </div>

        <!-- 5 Animated Floating UI Glass Cards -->
        <!-- Card 1: Live Reservations -->
        <div class="th-float-card card-reservations">
          <div class="th-float-icon bg-blue">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <div class="th-float-title">Live Reservations</div>
            <div class="th-float-value">1,482 Confirmed</div>
            <div class="th-float-sub text-green">↑ 24% direct bookings</div>
          </div>
        </div>

        <!-- Card 2: Occupancy Rate -->
        <div class="th-float-card card-occupancy">
          <div class="th-float-icon bg-purple">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 21h18"/><path d="M19 21v-4a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v4"/><path d="M5 11l7-7 7 7"/></svg>
          </div>
          <div>
            <div class="th-float-title">Occupancy Rate</div>
            <div class="th-float-value">94.2% Full</div>
            <div class="th-float-sub">Peak Season Threshold</div>
          </div>
        </div>

        <!-- Card 3: Revenue Dashboard -->
        <div class="th-float-card card-revenue">
          <div class="th-float-icon bg-emerald">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <div>
            <div class="th-float-title">Revenue Dashboard</div>
            <div class="th-float-value">$184.50 ADR</div>
            <div class="th-float-sub text-green">$4.8M YTD Generated</div>
          </div>
        </div>

        <!-- Card 4: Guest Satisfaction -->
        <div class="th-float-card card-satisfaction">
          <div class="th-float-icon bg-amber">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <div>
            <div class="th-float-title">Guest Satisfaction</div>
            <div class="th-float-value">4.9 / 5 CSAT</div>
            <div class="th-float-sub text-green">98.4% Positive Reviews</div>
          </div>
        </div>

        <!-- Card 5: Booking Analytics -->
        <div class="th-float-card card-analytics">
          <div class="th-float-icon bg-cyan">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <div>
            <div class="th-float-title">Booking Analytics</div>
            <div class="th-float-value">Zero Leakage</div>
            <div class="th-float-sub">Real-time OTA &amp; PMS Sync</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       2. WHY BUSINESSES NEED THIS SOFTWARE (2 COLUMNS WITH CLEAN VECTOR ICONS)
  ═══════════════════════════════════════ -->
  <section class="th-section th-section-white">
    <div class="container">
      <div class="th-grid-2 gap-60 items-center">
        <!-- Left: Professional SaaS Graphic -->
        <div class="th-visual-box">
          <div class="th-ecosystem-card">
            <div class="th-eco-header">
              <h3>Enterprise Hospitality Architecture</h3>
              <p>Unified Cloud SaaS Ecosystem</p>
            </div>

            <div class="th-eco-nodes">
              <div class="th-eco-node main-node">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
                <span>Hegrix Cloud Engine</span>
              </div>
              <div class="th-eco-grid">
                <div class="th-eco-item">
                  <div class="th-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M19 21v-4a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v4"/><path d="M5 11l7-7 7 7"/></svg>
                  </div>
                  <div><strong>PMS Central</strong><br/><small>Rooms &amp; Rates</small></div>
                </div>
                <div class="th-eco-item">
                  <div class="th-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                  </div>
                  <div><strong>Booking Engine</strong><br/><small>Direct Web &amp; App</small></div>
                </div>
                <div class="th-eco-item">
                  <div class="th-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                  </div>
                  <div><strong>OTA Channel Sync</strong><br/><small>100+ Live OTAs</small></div>
                </div>
                <div class="th-eco-item">
                  <div class="th-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                  </div>
                  <div><strong>Guest Mobile Portal</strong><br/><small>Digital Check-In</small></div>
                </div>
                <div class="th-eco-item">
                  <div class="th-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
                  </div>
                  <div><strong>POS &amp; Inventory</strong><br/><small>Dining &amp; Amenities</small></div>
                </div>
                <div class="th-eco-item">
                  <div class="th-eco-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                  </div>
                  <div><strong>AI Revenue Hub</strong><br/><small>Dynamic Pricing</small></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Business Transformation Explanation -->
        <div class="th-content-side">
          <div class="th-eyebrow">The Digital Imperative</div>
          <h2 class="th-section-title">Why Modern Travel &amp; Hospitality Businesses Require Digital Transformation</h2>
          <p class="th-section-desc">
            Legacy systems, paper logbooks, and isolated software create operational friction that degrades guest experiences and erodes profit margins. In today's hyper-connected travel ecosystem, agility and centralized control are essential.
          </p>

          <!-- Common Problems List -->
          <div class="th-problem-box">
            <h4 class="th-box-subtitle">Critical Business Challenges We Solve:</h4>
            <div class="th-problem-tags">
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Manual reservations
              </span>
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Double bookings
              </span>
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Slow guest service
              </span>
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Revenue leakage
              </span>
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Fragmented systems
              </span>
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Poor guest communication
              </span>
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Inefficient staff coordination
              </span>
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Limited reporting
              </span>
              <span class="th-ptag">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Operational inefficiencies
              </span>
            </div>
          </div>

          <p class="th-solution-summary">
            Our enterprise software platform eliminates these bottlenecks through <strong>AI-driven automation, cloud infrastructure, real-time channel syncing, and integrated guest communication</strong>—transforming complex operations into streamlined, scalable profitability.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       3. BUSINESS CHALLENGES VS SOLUTIONS
  ═══════════════════════════════════════ -->
  <section class="th-section th-section-soft">
    <div class="container">
      <div class="th-section-head center">
        <div class="th-eyebrow">Transformation Matrix</div>
        <h2 class="th-section-title">Business Challenges vs. Hegrix Intelligent Solutions</h2>
        <p class="th-section-desc">See how our platform replaces manual friction points with automated, enterprise-grade capabilities.</p>
      </div>

      <div class="th-matrix">
        <!-- Matrix Header -->
        <div class="th-matrix-header">
          <div class="th-mh-cell col-challenge">Current Operational Challenge</div>
          <div class="th-mh-cell col-arrow"></div>
          <div class="th-mh-cell col-solution">Hegrix Enterprise SaaS Solution</div>
        </div>

        <!-- Matrix Rows -->
        <!-- Row 1 -->
        <div class="th-matrix-row">
          <div class="th-mr-cell col-challenge">
            <span class="th-status-icon bad">✕</span>
            <div><strong>Manual Booking Processes</strong><br/><small>Time-consuming phone calls, spreadsheets, and error-prone handwritten logs.</small></div>
          </div>
          <div class="th-mr-cell col-arrow">➔</div>
          <div class="th-mr-cell col-solution">
            <span class="th-status-icon good">✓</span>
            <div><strong>Online Booking Engine</strong><br/><small>24/7 direct online bookings with instant payment processing and instant confirmation.</small></div>
          </div>
        </div>

        <!-- Row 2 -->
        <div class="th-matrix-row">
          <div class="th-mr-cell col-challenge">
            <span class="th-status-icon bad">✕</span>
            <div><strong>Double Reservations &amp; Overbooking</strong><br/><small>Delayed manual inventory updates across multiple OTAs leading to guest dissatisfaction.</small></div>
          </div>
          <div class="th-mr-cell col-arrow">➔</div>
          <div class="th-mr-cell col-solution">
            <span class="th-status-icon good">✓</span>
            <div><strong>Live Room Availability Channel Manager</strong><br/><small>Millisecond 2-way sync across 100+ OTAs, preventing overbooking automatically.</small></div>
          </div>
        </div>

        <!-- Row 3 -->
        <div class="th-matrix-row">
          <div class="th-mr-cell col-challenge">
            <span class="th-status-icon bad">✕</span>
            <div><strong>Inventory &amp; Housekeeping Delays</strong><br/><small>Uncoordinated room cleaning schedules causing delayed guest check-ins.</small></div>
          </div>
          <div class="th-mr-cell col-arrow">➔</div>
          <div class="th-mr-cell col-solution">
            <span class="th-status-icon good">✓</span>
            <div><strong>Automated Mobile Workflows</strong><br/><small>Real-time room status updates push instant task assignments to staff smartphones.</small></div>
          </div>
        </div>

        <!-- Row 4 -->
        <div class="th-matrix-row">
          <div class="th-mr-cell col-challenge">
            <span class="th-status-icon bad">✕</span>
            <div><strong>Slow Front-Desk Check-In</strong><br/><small>Long queues in hotel lobbies causing poor first impressions and staff fatigue.</small></div>
          </div>
          <div class="th-mr-cell col-arrow">➔</div>
          <div class="th-mr-cell col-solution">
            <span class="th-status-icon good">✓</span>
            <div><strong>Digital Check-In / Check-Out</strong><br/><small>Self-service kiosk and mobile web check-in with digital key generation.</small></div>
          </div>
        </div>

        <!-- Row 5 -->
        <div class="th-matrix-row">
          <div class="th-mr-cell col-challenge">
            <span class="th-status-icon bad">✕</span>
